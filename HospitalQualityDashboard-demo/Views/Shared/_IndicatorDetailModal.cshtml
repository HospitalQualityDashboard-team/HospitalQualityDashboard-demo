@* Modal chi tiet chi so chat luong dung chung cho Admin va User. *@
<div class="modal fade indicator-detail-modal" id="indicatorDetailModal" tabindex="-1" aria-labelledby="indicatorDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <span class="report-detail-eyebrow">Chi tiết chỉ số</span>
                    <h2 class="modal-title" id="indicatorDetailModalLabel" data-indicator-detail-title>Đang tải...</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="indicator-detail-loading" data-indicator-detail-loading>
                    Đang tải chi tiết chỉ số...
                </div>
                <div class="alert alert-danger d-none" role="alert" data-indicator-detail-error>
                    Không thể tải chi tiết chỉ số. Vui lòng thử lại.
                    <button type="button" class="btn btn-sm btn-outline-danger ms-2" data-indicator-detail-retry>Thử lại</button>
                </div>
                <div data-indicator-detail-content></div>
            </div>
            <div class="modal-footer">
                <a href="#" class="btn btn-outline-primary" data-indicator-detail-fallback>Xem trang chi tiết</a>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var modal = document.getElementById('indicatorDetailModal');
        if (!modal) return;

        var title = modal.querySelector('[data-indicator-detail-title]');
        var content = modal.querySelector('[data-indicator-detail-content]');
        var loading = modal.querySelector('[data-indicator-detail-loading]');
        var error = modal.querySelector('[data-indicator-detail-error]');
        var retry = modal.querySelector('[data-indicator-detail-retry]');
        var fallback = modal.querySelector('[data-indicator-detail-fallback]');
        var currentUrl = '';

        function setLoading(isLoading) {
            if (loading) loading.classList.toggle('d-none', !isLoading);
            if (content) content.classList.toggle('d-none', isLoading);
        }

        function setError(isError) {
            if (error) error.classList.toggle('d-none', !isError);
        }

        function loadDetail(url) {
            if (!url || !content) {
                setLoading(false);
                setError(true);
                return;
            }

            currentUrl = url;
            content.innerHTML = '';
            setError(false);
            setLoading(true);

            var request = new XMLHttpRequest();
            request.open('GET', url, true);
            request.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
            request.onreadystatechange = function () {
                if (request.readyState !== 4) return;

                setLoading(false);
                if (request.status >= 200 && request.status < 300) {
                    content.innerHTML = request.responseText || '';
                    setError(false);
                    return;
                }

                content.innerHTML = '';
                setError(true);
            };
            request.send();
        }

        modal.addEventListener('show.bs.modal', function (event) {
            var trigger = event.relatedTarget;
            if (!trigger) return;

            var detailUrl = trigger.getAttribute('data-indicator-detail-url');
            var detailTitle = trigger.getAttribute('data-indicator-title') || 'Chi tiết chỉ số';
            var detailHref = trigger.getAttribute('href') || '#';

            if (title) title.textContent = detailTitle;
            if (fallback) fallback.setAttribute('href', detailHref);
            loadDetail(detailUrl);
        });

        modal.addEventListener('shown.bs.modal', function () {
            document.body.classList.add('indicator-detail-modal-open');
        });

        modal.addEventListener('hidden.bs.modal', function () {
            document.body.classList.remove('indicator-detail-modal-open');
            if (content) content.innerHTML = '';
            setError(false);
            setLoading(false);
        });

        if (retry) {
            retry.addEventListener('click', function () {
                loadDetail(currentUrl);
            });
        }
    })();
</script>
