@* Mục đích: màn hình đăng nhập riêng cho tài khoản Admin. *@
@model HospitalQualityDashboardDemo.Models.ViewModels.LoginViewModel

@{
    ViewBag.Title = "Đăng nhập Admin";
}

<main class="app-responsive-page auth-page" style="max-width: 480px;">
    <h2 class="mb-2">Đăng nhập Admin</h2>
    <p class="text-muted mb-4">Màn hình dành riêng cho tài khoản quản trị hệ thống.</p>

    @using (Html.BeginForm("AdminLogin", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="mb-3">
            @Html.LabelFor(m => m.TenDangNhap, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.TenDangNhap, new { @class = "form-control", autocomplete = "username" })
            @Html.ValidationMessageFor(m => m.TenDangNhap, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.MatKhau, new { @class = "form-label" })
            @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", autocomplete = "current-password" })
            @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-dark w-100">Đăng nhập Admin</button>
        <div class="mt-3 text-center">
            @Html.ActionLink("Đăng nhập User", "UserLogin", "Account")
        </div>
    }
</main>
