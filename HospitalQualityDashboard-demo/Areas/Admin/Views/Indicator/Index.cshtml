@* Mục đích: danh sách chỉ số chất lượng theo quyền Admin/User. *@
@model HospitalQualityDashboardDemo.Models.ViewModels.ChiSoIndexViewModel
@using System.Linq
@{
    ViewBag.Title = "Chỉ số chất lượng";
    var isAdmin = Convert.ToString(Session["LoaiTaiKhoan"]) == "Admin";
    var items = (Model.Items ?? new System.Collections.Generic.List<HospitalQualityDashboardDemo.Models.ViewModels.ChiSoViewModel>()).ToList();
}

<style>
    /* Custom CSS để match với bản thiết kế */
    .text-dark-blue {
        color: #0b3d91;
    }

    .bg-dark-blue {
        background-color: #0b3d91;
        color: white;
    }

    .btn-dark-blue {
        background-color: #0b3d91;
        color: white;
        border: none;
    }

        .btn-dark-blue:hover {
            background-color: #082d6b;
            color: white;
        }

    .border-dashed {
        border: 1px dashed #b0c4db;
        background-color: #ffffff;
        transition: all 0.2s ease;
    }

        .border-dashed:hover {
            border-color: #0b3d91;
            background-color: #f8fbff;
        }

    .upload-icon-box {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        background-color: #e6f0ff;
        color: #0b3d91;
        border-radius: 12px;
        font-size: 1.5rem;
    }

    .badge-soft-success {
        background-color: #d1f7e5;
        color: #059669;
        font-weight: 700;
        padding: 6px 12px;
        border-radius: 20px;
    }

    .badge-soft-danger {
        background-color: #fee2e2;
        color: #dc2626;
        font-weight: 700;
        padding: 6px 12px;
        border-radius: 20px;
    }

    /* Sửa lại badge Tần suất cho màu xanh dương nhạt và chống rớt dòng */
    .badge-soft-secondary {
        background-color: #f1f5f9;
        color: #3b82f6;
        font-weight: 700;
        padding: 6px 12px;
        border-radius: 20px;
        white-space: nowrap; /* Chống rớt chữ */
    }

    .status-dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        margin-right: 6px;
        vertical-align: middle;
    }

        .status-dot.bg-success {
            background-color: #059669 !important;
        }

        .status-dot.bg-danger {
            background-color: #dc2626 !important;
        }

    .table-header th {
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        color: #344054;
        letter-spacing: 0.5px;
        padding-bottom: 12px;
        padding-top: 12px;
        background-color: #f8fafc !important; /* Màu xám xanh nhạt */
        border-bottom: 1px solid #e2e8f0;
    }

    .action-btn {
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
    }
</style>

<section class="management-page p-4">
    @* 1. Header *@
    <div class="mb-4">
        <h1 class="text-dark-blue fw-bold mb-2">Chỉ số chất lượng</h1>
        <p class="text-muted">Hệ thống quản lý và giám sát các chỉ số chất lượng lâm sàng tại bệnh viện. Đảm bảo tính minh bạch, chính xác và cải thiện liên tục chất lượng dịch vụ y tế.</p>
    </div>

    @* 2. Khu vực Import (Chỉ hiển thị cho Admin) *@
    @if (isAdmin)
    {
        using (Html.BeginForm("Import", "Indicator", FormMethod.Post, new { enctype = "multipart/form-data", @class = "mb-4" }))
        {
            @Html.AntiForgeryToken()
            <div class="row g-4 align-items-stretch">
                <div class="col-lg-8">
                    <div class="border-dashed rounded-4 h-100 d-flex flex-column align-items-center justify-content-center p-5 position-relative">
                        <input type="file" name="File" accept=".xlsx,.csv,.docx" class="position-absolute w-100 h-100 opacity-0" style="cursor: pointer; z-index: 10;" required />

                        <div class="upload-icon-box mb-3">
                            <i class="bi bi-file-earmark-arrow-up-fill"></i>
                        </div>
                        <h5 class="text-dark-blue fw-bold mb-2">Nhập dữ liệu chỉ số</h5>
                        <p class="text-muted small mb-0">Kéo và thả tệp Excel (.xlsx, .csv) vào đây hoặc <span class="text-dark-blue fw-bold text-decoration-underline">duyệt tệp</span></p>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="bg-light rounded-4 h-100 p-4 d-flex flex-column justify-content-center">
                        <h5 class="text-dark-blue fw-bold mb-2">Thao tác nhanh</h5>
                        <p class="text-muted small mb-4">Tải lên dữ liệu hàng loạt để cập nhật trạng thái các chỉ số chất lượng của phòng ban.</p>
                        <button class="btn btn-dark-blue w-100 py-2 rounded-3 fw-bold d-flex justify-content-center align-items-center gap-2" type="submit">
                            <i class="bi bi-cloud-arrow-up"></i> Tiến hành Import
                        </button>
                    </div>
                </div>
            </div>
        }
    }

    @* Thông báo *@
    @if (Model.ImportResult != null)
    {
        <div class="alert alert-info rounded-3 mt-3">Thành công: @Model.ImportResult.SoDongThanhCong, lỗi: @Model.ImportResult.SoDongLoi</div>
        foreach (var error in Model.ImportResult.Errors)
        {
            <div class="text-danger small ms-2 mb-1">@error</div>
        }
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-3 mt-3">@TempData["Error"]</div>
    }

    @* 3. Bộ lọc và Thông tin hiển thị *@
<div class="d-flex justify-content-between align-items-center mt-5 mb-3">
    <div class="d-flex gap-2">
        @using (Html.BeginForm("Index", "Indicator", FormMethod.Get, new { @class = "d-flex gap-2" }))
        {
            <div class="input-group" style="width: 320px;">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="Search" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm theo tên hoặc mã chỉ số..." />
            </div>
            <button type="submit" class="btn btn-outline-secondary bg-white text-success fw-bold d-flex align-items-center gap-2 px-3">
                <i class="bi bi-filter"></i> Bộ lọc
            </button>
        }
    </div>
    <div class="text-muted small">
        Đang hiển thị: <strong class="text-dark">@items.Count / @Model.TotalItems</strong> chỉ số
    </div>
    <div class="text-muted small">
        Trang @Model.Page / @Model.TotalPages
    </div>
</div>

    @* 4. Bảng Dữ Liệu *@
    <div class="bg-white rounded-3 shadow-sm border border-light-subtle overflow-hidden">
        @if (items.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-header bg-light">
                        <tr>
                            <th class="ps-4 pt-3">Mã</th>
                            <th class="pt-3">Tên chỉ số</th>
                            <th class="pt-3">Tần suất</th>
                            <th class="pt-3">Công thức</th>
                            <th class="pt-3">Trạng thái</th>
                            <th class="pe-4 pt-3 text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @foreach (var item in items)
                        {
                            <tr>
                                <td class="ps-4 py-4">
                                    <span class="text-dark-blue fw-bold">@item.MaChiSo</span>
                                </td>
                                <td class="py-4">
                                    <div class="fw-bold text-dark mb-1">@item.TenChiSo</div>
                                    @* Tuỳ biến đoạn Khoa/Phòng này nếu Model của bạn có thuộc tính tương ứng *@
                                    <div class="text-muted" style="font-size: 0.8rem;">Phòng quản lý chung</div>
                                </td>
                                <td class="py-4">
                                    <span class="badge badge-soft-secondary text-wrap text-start" style="max-width: 80px; line-height: 1.4;">@item.TanSuatBaoCaoText</span>
                                </td>
                                <td class="py-4">
                                    <span class="text-muted fst-italic" style="font-size: 0.9rem;">@item.LoaiCongThuc</span>
                                </td>
                                <td class="py-4">
                                    @if (item.DangHoatDong)
                                    {
                                        <span class="badge badge-soft-success d-inline-flex align-items-center status-active">
                                            <span class="status-dot bg-success"></span> Đang đo lường
                                        </span>
                                    }
                                    else
                                    {
                                        @* Thêm class status-muted vào đây *@
                                        <span class="badge badge-soft-danger d-inline-flex align-items-center status-muted">
                                            <span class="status-dot bg-danger"></span> Tạm ngưng
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4 py-4">
                                    <div class="d-flex justify-content-end align-items-center gap-2 flex-nowrap">
                                        @Html.ActionLink("Chi tiết", "Details", new { id = item.ChiSoChatLuongId }, new { @class = "btn btn-sm btn-light fw-semibold text-dark-blue action-btn border" })

                                        @if (isAdmin)
                                        {
                                            @Html.ActionLink("Sửa", "Edit", new { id = item.ChiSoChatLuongId }, new { @class = "btn btn-sm btn-outline-primary fw-semibold action-btn" })

                                            using (Html.BeginForm(item.DangHoatDong ? "StopDeployment" : "Deploy", "Indicator", new { id = item.ChiSoChatLuongId }, FormMethod.Post, new { @class = "m-0 p-0" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button class="btn btn-sm btn-outline-warning fw-semibold action-btn" type="submit" onclick="return confirm('@(item.DangHoatDong ? "Chỉ số vẫn phải nộp cho các kỳ đã bắt đầu và sẽ ngừng từ kỳ kế tiếp." : "Chỉ số sẽ được triển khai ngay cho các kỳ đang mở phù hợp tần suất.")')">
                                                    <i class="bi @(item.DangHoatDong ? "bi-pause-circle" : "bi-play-circle")"></i>
                                                </button>
                                            }

                                            using (Html.BeginForm("Delete", "Indicator", new { id = item.ChiSoChatLuongId }, FormMethod.Post, new { @class = "m-0 p-0" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button class="btn btn-sm btn-outline-danger fw-semibold action-btn" type="submit" onclick="return confirm('Xóa chỉ số này?')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* 5. Phân trang *@
            if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center p-3 border-top">
                    <a href="@Url.Action("Index", new { page = Model.Page - 1 })" class="btn btn-outline-secondary bg-white fw-semibold d-flex align-items-center gap-2 @(Model.Page <= 1 ? "disabled" : "")">
                        <i class="bi bi-chevron-left"></i> Trước
                    </a>

                    <div class="d-flex gap-2">
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            if (p == Model.Page)
                            {
                                <span class="btn btn-dark-blue fw-bold" style="width: 40px; border-radius: 8px;">@p</span>
                            }
                            else if (p <= 3 || p == Model.TotalPages || (p >= Model.Page - 1 && p <= Model.Page + 1))
                            {
                                <a href="@Url.Action("Index", new { page = p })" class="btn btn-light fw-semibold text-dark" style="width: 40px; border-radius: 8px;">@p</a>
                            }
                            else if (p == 4 || p == Model.TotalPages - 1)
                            {
                                <span class="btn border-0 text-muted disabled">...</span>
                            }
                        }
                    </div>

                    <a href="@Url.Action("Index", new { page = Model.Page + 1 })" class="btn btn-outline-secondary bg-white fw-semibold d-flex align-items-center gap-2 @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        Tiếp theo <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            }
        }
        else
        {
            <div class="text-center p-5 text-muted">
                <i class="bi bi-inbox fs-1 opacity-50 mb-3 d-block"></i>
                Chưa có chỉ số chất lượng trong phạm vi hiện tại.
            </div>
        }
    </div>
</section>