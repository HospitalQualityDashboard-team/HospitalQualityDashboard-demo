@* Mục đích: danh sách chỉ số chất lượng theo quyền Admin/User. *@
@model HospitalQualityDashboardDemo.Models.ViewModels.ChiSoIndexViewModel
@using System.Linq
@{
    ViewBag.Title = "Chỉ số chất lượng";
    var isAdmin = Convert.ToString(Session["LoaiTaiKhoan"]) == "Admin";
    var items = (Model.Items ?? new System.Collections.Generic.List<HospitalQualityDashboardDemo.Models.ViewModels.ChiSoViewModel>()).ToList();
}

<section class="management-page">
    <div class="page-header">
        <div>
            <span class="dashboard-role">Bộ chỉ số</span>
            <h1>Chỉ số chất lượng</h1>
            <p>Quản lý danh mục chỉ số, tần suất báo cáo, công thức tính và trạng thái sử dụng.</p>
        </div>
        @if (isAdmin)
        {
            <div class="management-toolbar">
                @Html.ActionLink("Thêm chỉ số", "Create", null, new { @class = "btn btn-primary" })
                @Html.ActionLink("Xuất Excel", "Indicators", "Export", null, new { @class = "btn btn-outline-secondary" })
            </div>
        }
    </div>

    @if (isAdmin)
    {
        <section class="import-panel">
            <div>
                <h2 class="import-panel-title">Import chỉ số</h2>
                <div class="import-panel-note">Hỗ trợ file .xlsx, .csv hoặc .docx theo cấu trúc danh mục chỉ số chất lượng.</div>
            </div>
            @using (Html.BeginForm("Import", "Indicator", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <div class="input-group">
                    <input type="file" name="File" class="form-control" accept=".xlsx,.csv,.docx" />
                    <button class="btn btn-outline-primary" type="submit">Import chỉ số</button>
                </div>
            }
        </section>
    }

    @if (Model.ImportResult != null)
    {
        <div class="alert alert-info">Thành công: @Model.ImportResult.SoDongThanhCong, lỗi: @Model.ImportResult.SoDongLoi</div>
        foreach (var error in Model.ImportResult.Errors)
        {
            <div class="text-danger">@error</div>
        }
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

<section class="data-panel">
    <div class="panel-header">
        <div>
            <h2>Danh sách chỉ số</h2>
            <p>@Model.TotalItems chỉ số trong phạm vi được phép xem.</p>
        </div>
        <span class="status-pill status-muted">@items.Count dòng</span>
    </div>

    @if (items.Any())
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle data-table">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Tên chỉ số</th>
                        <th>Tần suất</th>
                        <th>Công thức</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td><strong>@item.MaChiSo</strong></td>
                            <td>@item.TenChiSo</td>
                            <td>@item.TanSuatBaoCaoText</td>
                            <td>@item.LoaiCongThuc</td>
                            <td><span class="status-pill @(item.DangHoatDong ? "status-active" : "status-muted")">@(item.DangHoatDong ? "Hoạt động" : "Đã khóa")</span></td>
                            <td class="text-end table-actions">
                                @Html.ActionLink("Chi tiết", "Details", new { id = item.ChiSoChatLuongId }, new { @class = "btn btn-sm btn-outline-secondary" })
                                @if (isAdmin)
                                {
                                    @Html.ActionLink("Sửa", "Edit", new { id = item.ChiSoChatLuongId }, new { @class = "btn btn-sm btn-outline-primary" })
                                    using (Html.BeginForm(item.DangHoatDong ? "Lock" : "Unlock", "Indicator", new { id = item.ChiSoChatLuongId }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-warning" type="submit">@(item.DangHoatDong ? "Khóa" : "Mở khóa")</button>
                                    }
                                    using (Html.BeginForm("Delete", "Indicator", new { id = item.ChiSoChatLuongId }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Xóa chỉ số này?')">Xóa</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">Chưa có chỉ số chất lượng trong phạm vi hiện tại.</div>
    }

    @if (Model.TotalPages > 1)
    {
        <div class="management-toolbar mt-3 d-flex justify-content-center align-items-center gap-3">
            @Html.ActionLink("Trước", "Index", new { page = Model.Page - 1 }, new { @class = "btn btn-outline-secondary " + (Model.Page <= 1 ? "disabled" : "") })
            <span class="status-pill status-muted">Trang @Model.Page / @Model.TotalPages</span>
            @Html.ActionLink("Sau", "Index", new { page = Model.Page + 1 }, new { @class = "btn btn-outline-secondary " + (Model.Page >= Model.TotalPages ? "disabled" : "") })
        </div>
    }
</section>
</section>
