>>>>>>> origin/develop

            <div class="form-actions indicator-form-actions mt-4">
                <button class="btn btn-primary px-4" type="submit">
                    Lưu chỉ số
                </button>

                <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">
                    Hủy
                </a>
            </div>
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}