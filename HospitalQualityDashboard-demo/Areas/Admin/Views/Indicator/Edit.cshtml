@* Mục đích: form thêm mới hoặc cập nhật chỉ số chất lượng. *@
@model HospitalQualityDashboardDemo.Models.ViewModels.ChiSoViewModel
@using HospitalQualityDashboardDemo.Models.Enums
@{
    ViewBag.Title = Model.ChiSoChatLuongId == 0 ? "Thêm chỉ số" : "Sửa chỉ số";
}

<div class="form-page indicator-form-page hospital-blue-form">
    <div class="page-header form-page-header indicator-page-hero">
        <div>
            <span class="status-pill status-open">Admin</span>
            <h1>@ViewBag.Title</h1>
            <p>Quản lý chỉ số chất lượng, tần suất báo cáo, công thức tính và mục tiêu đánh giá.</p>
        </div>

        <div class="page-actions">
            <a href="@Url.Action("Index")" class="btn btn-outline-primary">
                ← Quay lại danh sách
            </a>
        </div>
    </div>

    <div class="data-panel indicator-form-card">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
            </div>
        }

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ChiSoChatLuongId)

            <div class="indicator-form-heading">
                <div class="indicator-form-icon">CS</div>
                <div>
                    <h2>Thông tin chỉ số chất lượng</h2>
                    <p>Cấu hình dữ liệu nghiệp vụ dùng cho phân công và nhập báo cáo.</p>
                </div>
            </div>

            <div class="indicator-section">
                <h3>1. Thông tin cơ bản</h3>

                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label" for="MaChiSo">Mã chỉ số <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.MaChiSo, new { @class = "form-control indicator-input", placeholder = "Ví dụ: CS001" })
                        @Html.ValidationMessageFor(m => m.MaChiSo, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-2">
                        <label class="form-label" for="SoThuTu">Số thứ tự</label>
                        @Html.TextBoxFor(m => m.SoThuTu, new { @class = "form-control indicator-input", type = "number", placeholder = "1" })
                        @Html.ValidationMessageFor(m => m.SoThuTu, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-7">
                        <label class="form-label" for="TenChiSo">Tên chỉ số <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.TenChiSo, new { @class = "form-control indicator-input", placeholder = "Tên đầy đủ của chỉ số chất lượng..." })
                        @Html.ValidationMessageFor(m => m.TenChiSo, "", new { @class = "text-danger small" })
                    </div>
                </div>
            </div>

            <div class="indicator-section">
                <h3>2. Cấu hình báo cáo</h3>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="SelectedTanSuatBaoCaoValues">Tần suất báo cáo <span class="text-danger">*</span></label>
                        <span class="form-text d-block mb-1">Giữ Ctrl để chọn nhiều tần suất</span>
                        @Html.ListBoxFor(m => m.SelectedTanSuatBaoCaoValues, Model.TanSuatBaoCaoOptions, new { @class = "form-select indicator-input", size = 6 })
                        @Html.ValidationMessageFor(m => m.SelectedTanSuatBaoCaoValues, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" for="LoaiCongThuc">Loại công thức <span class="text-danger">*</span></label>
                        <span class="form-text d-block mb-1">Quyết định cách tính kết quả</span>
                        @Html.DropDownListFor(m => m.LoaiCongThuc, new SelectList(Enum.GetValues(typeof(LoaiCongThuc)), Model.LoaiCongThuc), new { @class = "form-select indicator-input" })
                        @Html.ValidationMessageFor(m => m.LoaiCongThuc, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" for="DonViTinh">Đơn vị tính</label>
                        <span class="form-text d-block mb-1">Ví dụ: %, lượt, ngày, điểm...</span>
                        @Html.TextBoxFor(m => m.DonViTinh, new { @class = "form-control indicator-input", placeholder = "Ví dụ: %" })
                        @Html.ValidationMessageFor(m => m.DonViTinh, "", new { @class = "text-danger small" })
                    </div>
                </div>
            </div>

            <div class="indicator-section">
                <h3>3. Định nghĩa và phương pháp tính</h3>

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label" for="DinhNghia">Định nghĩa</label>
                        @Html.TextAreaFor(m => m.DinhNghia, new { @class = "form-control indicator-input", rows = 2, placeholder = "Mô tả ý nghĩa của chỉ số..." })
                        @Html.ValidationMessageFor(m => m.DinhNghia, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12">
                        <label class="form-label" for="PhuongPhapTinh">Phương pháp tính</label>
                        @Html.TextAreaFor(m => m.PhuongPhapTinh, new { @class = "form-control indicator-input", rows = 2, placeholder = "Cách tính hoặc công thức áp dụng..." })
                        @Html.ValidationMessageFor(m => m.PhuongPhapTinh, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="TuSoMoTa">Tử số</label>
                        @Html.TextAreaFor(m => m.TuSoMoTa, new { @class = "form-control indicator-input", rows = 2, placeholder = "Mô tả cách lấy tử số..." })
                        @Html.ValidationMessageFor(m => m.TuSoMoTa, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="MauSoMoTa">Mẫu số</label>
                        @Html.TextAreaFor(m => m.MauSoMoTa, new { @class = "form-control indicator-input", rows = 2, placeholder = "Mô tả cách lấy mẫu số..." })
                        @Html.ValidationMessageFor(m => m.MauSoMoTa, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12">
                        <label class="form-label" for="NguonSoLieu">Nguồn số liệu</label>
                        @Html.TextAreaFor(m => m.NguonSoLieu, new { @class = "form-control indicator-input", rows = 2, placeholder = "HIS, bệnh án, phiếu khảo sát..." })
                        @Html.ValidationMessageFor(m => m.NguonSoLieu, "", new { @class = "text-danger small" })
                    </div>
                </div>
            </div>

            <div class="indicator-section">
                <h3>4. Giá trị mục tiêu</h3>

                <div class="row g-3">
                    <div class="col-md-2">
                        <label class="form-label" for="NamMucTieu">Năm</label>
                        @Html.TextBoxFor(m => m.NamMucTieu, new { @class = "form-control indicator-input", type = "number", placeholder = DateTime.Now.Year.ToString() })
                        @Html.ValidationMessageFor(m => m.NamMucTieu, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-2">
                        <label class="form-label" for="ToanTuSoSanh">So sánh</label>
                        @Html.TextBoxFor(m => m.ToanTuSoSanh, new { @class = "form-control indicator-input", placeholder = ">=" })
                        @Html.ValidationMessageFor(m => m.ToanTuSoSanh, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-3">
                        <label class="form-label" for="GiaTriMucTieu">Giá trị</label>   
                        @Html.TextBoxFor(m => m.GiaTriMucTieu, new { @class = "form-control indicator-input", placeholder = "95.00" })
                        @Html.ValidationMessageFor(m => m.GiaTriMucTieu, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-5">
                        <label class="form-label" for="MoTaMucTieu">Mô tả mục tiêu</label>
                        @Html.TextBoxFor(m => m.MoTaMucTieu, new { @class = "form-control indicator-input", placeholder = "Đạt tỷ lệ trên 95%..." })
                        @Html.ValidationMessageFor(m => m.MoTaMucTieu, "", new { @class = "text-danger small" })
                    </div>
                </div>
            </div>

                        <div class="indicator-status-box">
                <div>
                    <strong>Trạng thái chỉ số</strong>
                    <span>Chỉ số đang hoạt động sẽ được phân công và báo cáo.</span>
                </div>

                <div class="form-check form-switch indicator-switch">
                    @Html.CheckBoxFor(m => m.DangHoatDong, new { @class = "form-check-input", role = "switch" })
                    <label class="form-check-label" for="DangHoatDong">Đang hoạt động</label>
                </div>
            </div>
=======
