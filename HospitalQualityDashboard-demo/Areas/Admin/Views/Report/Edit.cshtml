@* Mục đích: form nhập và cập nhật số liệu báo cáo theo chỉ số. *@
@model HospitalQualityDashboardDemo.Models.ViewModels.ReportEntryViewModel
@{
    ViewBag.Title = "Nhập báo cáo";

    bool isAdmin = ViewBag.IsAdmin == true;
    bool isEditable = !isAdmin &&
                      (Model.BaoCaoId == 0 ||
                       Model.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.Nhap ||
                       Model.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.TraLai);

    bool isDirect = Model.LoaiCongThuc == HospitalQualityDashboardDemo.Models.Enums.LoaiCongThuc.SoLuong ||
                    Model.LoaiCongThuc == HospitalQualityDashboardDemo.Models.Enums.LoaiCongThuc.GiaTriTrucTiep ||
                    Model.LoaiCongThuc == HospitalQualityDashboardDemo.Models.Enums.LoaiCongThuc.DiemTrungBinh;

    var numberAttributes = new Dictionary<string, object> { { "class", "form-control" }, { "type", "number" }, { "step", "0.0001" } };
    var textAttributes = new Dictionary<string, object> { { "class", "form-control" }, { "rows", "3" } };
    
    if (!isEditable)
    {
        numberAttributes.Add("readonly", "readonly");
        textAttributes.Add("readonly", "readonly");
    }
}

<div class="app-responsive-page report-edit-page">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3 report-edit-header">
        <div>
            <h1 class="h2 mb-1 text-primary fw-bold">@Model.MaChiSo - @Model.TenChiSo</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Báo cáo</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Nhập số liệu</li>
                </ol>
            </nav>
        </div>
        <div>
            @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-outline-secondary px-4 rounded-pill shadow-sm" })
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar Info -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-light">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 text-secondary">Thông tin chỉ số</h5>
                    
                    <div class="mb-3">
                        <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.75rem;">Kỳ báo cáo</small>
                        <span class="fs-6 fw-medium text-dark">@Model.TenKyBaoCao</span>
                    </div>
                    
                    <div class="mb-3">
                        <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.75rem;">Khoa/Phòng thực hiện</small>
                        <span class="fs-6 fw-medium text-dark">@Model.TenKhoaPhong</span>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.75rem;">Loại công thức</small>
                        <span class="badge bg-info text-white fs-6">
                            @switch (Model.LoaiCongThuc)
                            {
                                case HospitalQualityDashboardDemo.Models.Enums.LoaiCongThuc.TyLe: @:Tỷ lệ (%)
                                    break;
                                case HospitalQualityDashboardDemo.Models.Enums.LoaiCongThuc.SoLuong: @:Số lượng
                                    break;
                                case HospitalQualityDashboardDemo.Models.Enums.LoaiCongThuc.ThoiGianTrungBinh: @:Thời gian trung bình
                                    break;
                                case HospitalQualityDashboardDemo.Models.Enums.LoaiCongThuc.DiemTrungBinh: @:Điểm trung bình
                                    break;
                                case HospitalQualityDashboardDemo.Models.Enums.LoaiCongThuc.GiaTriTrucTiep: @:Giá trị trực tiếp
                                    break;
                                case HospitalQualityDashboardDemo.Models.Enums.LoaiCongThuc.TySo: @:Tỷ số
                                    break;
                                default: @Model.LoaiCongThuc.ToString()
                                    break;
                            }
                        </span>
                    </div>
                    
                    <div class="mb-0">
                        <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.75rem;">Trạng thái hiện tại</small>
                        @switch (Model.TrangThai)
                        {
                            case HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.Nhap:
                                <span class="badge bg-secondary fs-6">Nháp</span>
                                break;
                            case HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.DaGui:
                                <span class="badge bg-info text-dark fs-6">Đã gửi chờ duyệt</span>
                                break;
                            case HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.QuaHan:
                                <span class="badge bg-danger fs-6">Quá hạn</span>
                                break;
                            case HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.DaKhoa:
                                <span class="badge bg-dark fs-6">Đã khóa</span>
                                break;
                            case HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.DaDuyet:
                                <span class="badge bg-success fs-6">Đã duyệt</span>
                                break;
                            case HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.TraLai:
                                <span class="badge bg-warning text-dark fs-6">Trả lại</span>
                                break;
                            default:
                                <span class="badge bg-light text-dark fs-6">@Model.TrangThai</span>
                                break;
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.YKienPhanHoi))
                    {
                        <div class="mt-3">
                            <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.75rem;">Ý kiến phản hồi</small>
                            <div class="alert alert-warning p-2 mt-1 small">@Model.YKienPhanHoi</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Main Form -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4 p-md-5">
                    @if (!isEditable)
                    {
                        <div class="alert alert-info border-0 rounded-3 p-3 mb-4 d-flex align-items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-info-circle-fill text-info" viewBox="0 0 16 16">
                                <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
                            </svg>
                            <span class="text-info-emphasis fw-medium">Báo cáo này chỉ được xem, không thể chỉnh sửa số liệu.</span>
                        </div>
                    }

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.BaoCaoId)
                        @Html.HiddenFor(m => m.KyBaoCaoId)
                        @Html.HiddenFor(m => m.KhoaPhongId)
                        @Html.HiddenFor(m => m.ChiSoChatLuongId)
                        @Html.HiddenFor(m => m.PhanCongChiSoId)
                        @Html.HiddenFor(m => m.TenKyBaoCao)
                        @Html.HiddenFor(m => m.TenKhoaPhong)
                        @Html.HiddenFor(m => m.MaChiSo)
                        @Html.HiddenFor(m => m.TenChiSo)
                        @Html.HiddenFor(m => m.LoaiCongThuc)
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="row g-3">
                            <div class="col-md-6" style="@(isDirect ? "display:none;" : "")">
                                @Html.LabelFor(m => m.TuSo, new { @class = "form-label fw-semibold text-secondary" })
                                @Html.TextBoxFor(m => m.TuSo, "{0:0.####}", numberAttributes)
                                @Html.ValidationMessageFor(m => m.TuSo, "", new { @class = "text-danger" })
                            </div>
                            
                            <div class="col-md-6" style="@(isDirect ? "display:none;" : "")">
                                @Html.LabelFor(m => m.MauSo, new { @class = "form-label fw-semibold text-secondary" })
                                @Html.TextBoxFor(m => m.MauSo, "{0:0.####}", numberAttributes)
                                @Html.ValidationMessageFor(m => m.MauSo, "", new { @class = "text-danger" })
                            </div>
                            
                            <div class="col-md-12" style="@(!isDirect ? "display:none;" : "")">
                                @Html.LabelFor(m => m.GiaTriNhap, new { @class = "form-label fw-semibold text-secondary" })
                                @Html.TextBoxFor(m => m.GiaTriNhap, "{0:0.####}", numberAttributes)
                                @Html.ValidationMessageFor(m => m.GiaTriNhap, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="mb-4 mt-3">
                            @Html.LabelFor(m => m.GhiChu, new { @class = "form-label fw-semibold text-secondary" })
                            @Html.TextAreaFor(m => m.GhiChu, textAttributes)
                            @Html.ValidationMessageFor(m => m.GhiChu, "", new { @class = "text-danger" })
                        </div>

                        if (isEditable)
                        {
                            <div class="mobile-stack-actions report-edit-actions">
                                <button class="btn btn-primary px-4 py-2 shadow-sm rounded-3" type="submit">
                                    <i class="bi bi-save me-2"></i> Lưu nháp
                                </button>
                                
                                @if (Model.BaoCaoId > 0)
                                {
                                    <button class="btn btn-success px-4 py-2 shadow-sm rounded-3" type="button" onclick="document.getElementById('form-submit-report').submit();">
                                        <i class="bi bi-send me-2"></i> Gửi báo cáo
                                    </button>
                                }
                            </div>
                        }
                    }

                    @if (isAdmin && Model.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.DaGui)
                    {
                        <div class="border-top pt-3 mt-3">
                            <h6 class="fw-semibold text-secondary mb-3">Thao tác quản lý</h6>
                            
                            <div class="mb-3">
                                @using (Html.BeginForm("Approve", "Report", new { id = Model.BaoCaoId }, FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-success px-4 py-2 shadow-sm rounded-3" type="submit">
                                        <i class="bi bi-check-circle me-2"></i> Duyệt báo cáo
                                    </button>
                                }
                            </div>

                            @using (Html.BeginForm("Reject", "Report", new { id = Model.BaoCaoId }, FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <div class="mb-2">
                                    <label class="form-label fw-semibold text-secondary" for="YKienPhanHoi">Ý kiến phản hồi (bắt buộc khi trả lại)</label>
                                    <textarea class="form-control" id="YKienPhanHoi" name="YKienPhanHoi" rows="3" required></textarea>
                                </div>
                                <button class="btn btn-warning px-4 py-2 shadow-sm rounded-3 text-dark" type="submit">
                                    <i class="bi bi-arrow-return-left me-2"></i> Trả lại báo cáo
                                </button>
                            }

                            @if (TempData["ErrorMessage"] != null)
                            {
                                <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
                            }
                        </div>
                    }

                    @if (isEditable && Model.BaoCaoId > 0)
                    {
                        using (Html.BeginForm("Submit", "Report", new { id = Model.BaoCaoId }, FormMethod.Post, new { id = "form-submit-report", @class = "d-none" }))
                        {
                            @Html.AntiForgeryToken()
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
