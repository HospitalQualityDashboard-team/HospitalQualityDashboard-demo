@* Mục đích: danh sách báo cáo, bộ lọc và thao tác duyệt/xuất dữ liệu. *@
@model HospitalQualityDashboardDemo.Models.ViewModels.ReportListViewModel
@using System.Linq
@{
    ViewBag.Title = "Báo cáo";
    var activePeriods = (Model.ActivePeriods ?? new System.Collections.Generic.List<HospitalQualityDashboardDemo.Models.ViewModels.KyBaoCaoViewModel>()).ToList();
    var reports = (Model.Items ?? new System.Collections.Generic.List<HospitalQualityDashboardDemo.Models.ViewModels.ReportEntryViewModel>()).ToList();
    var submittedCount = reports.Count(x =>
        x.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.DaGui ||
        x.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.QuaHan ||
        x.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.DaKhoa);
    var draftCount = reports.Count(x => x.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.Nhap);
}

@helper FrequencyText(HospitalQualityDashboardDemo.Models.Enums.TanSuatBaoCao frequency)
{
    switch (frequency)
    {
        case HospitalQualityDashboardDemo.Models.Enums.TanSuatBaoCao.HangNgay:
            @:Hàng ngày
            break;
        case HospitalQualityDashboardDemo.Models.Enums.TanSuatBaoCao.HangTuan:
            @:Hàng tuần
            break;
        case HospitalQualityDashboardDemo.Models.Enums.TanSuatBaoCao.HangThang:
            @:Hàng tháng
            break;
        case HospitalQualityDashboardDemo.Models.Enums.TanSuatBaoCao.HangQuy:
            @:Hàng quý
            break;
        case HospitalQualityDashboardDemo.Models.Enums.TanSuatBaoCao.SauThang:
            @:6 tháng
            break;
        case HospitalQualityDashboardDemo.Models.Enums.TanSuatBaoCao.ChinThang:
            @:9 tháng
            break;
        case HospitalQualityDashboardDemo.Models.Enums.TanSuatBaoCao.HangNam:
            @:Hàng năm
            break;
        case HospitalQualityDashboardDemo.Models.Enums.TanSuatBaoCao.KhiPhatSinh:
            @:Khi phát sinh
            break;
        case HospitalQualityDashboardDemo.Models.Enums.TanSuatBaoCao.TruocSauKhiThucHien:
            @:Trước/sau thực hiện
            break;
        default:
            @frequency.ToString()
            break;
    }
}

<section class="report-page">
    <div class="page-header report-header">
        <div>
            <span class="dashboard-role">Báo cáo chất lượng</span>
            <h1>Báo cáo</h1>
            <p>Theo dõi kỳ đang mở, nhập số liệu theo phân công và rà soát lịch sử báo cáo đã phát sinh.</p>
        </div>
        <div class="report-header-metrics">
            <div>
                <span>Kỳ đang mở</span>
                <strong>@activePeriods.Count</strong>
            </div>
            <div>
                <span>Báo cáo</span>
                <strong>@reports.Count</strong>
            </div>
            <div>
                <span>Nháp</span>
                <strong>@draftCount</strong>
            </div>
        </div>
    </div>

    <section class="dashboard-panel report-open-section">
        <div class="panel-header">
            <div>
                <h2>Kỳ báo cáo đang mở</h2>
                <p>User chỉ thấy các kỳ đã mở và phù hợp với tần suất chỉ số được phân công.</p>
            </div>
            <span class="status-pill status-success">@activePeriods.Count kỳ</span>
        </div>

        @if (activePeriods.Any())
        {
            <div class="report-open-grid">
                @foreach (var period in activePeriods)
                {
                    var isOverdue = DateTime.Today > period.HanNop.Date;
                    var percent = period.TongBaoCao > 0 ? (int)Math.Round((decimal)period.DaGui * 100 / period.TongBaoCao) : 0;
                    <article class="period-card @(isOverdue ? "is-overdue" : "")">
                        <div class="period-card-top">
                            <span class="status-pill status-muted">@FrequencyText(period.LoaiKyBaoCao)</span>
                            @if (isOverdue)
                            {
                                <span class="status-pill status-danger">Quá hạn</span>
                            }
                            else
                            {
                                <span class="status-pill status-success">Đang mở</span>
                            }
                        </div>
                        <h3>@period.TenKyBaoCao</h3>
                        <dl class="period-meta">
                            <div>
                                <dt>Khoảng báo cáo</dt>
                                <dd>@period.TuNgay.ToString("dd/MM/yyyy") - @period.DenNgay.ToString("dd/MM/yyyy")</dd>
                            </div>
                            <div>
                                <dt>Hạn nộp</dt>
                                <dd class="@(isOverdue ? "text-danger fw-bold" : "")">@period.HanNop.ToString("dd/MM/yyyy") 23:59</dd>
                            </div>
                        </dl>
                        @if (Model.IsAdmin)
                        {
                            <div class="period-progress">
                                <div class="progress-track">
                                    <div class="progress-fill" style="width: @(percent)%"></div>
                                </div>
                                <span>@period.DaGui/@period.TongBaoCao</span>
                            </div>
                            <a href="@Url.Action("Index", "Report", new { kyBaoCaoId = period.KyBaoCaoId })" class="btn btn-outline-primary w-100">
                                Xem tổng hợp
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("Nhap", "Report", new { kyBaoCaoId = period.KyBaoCaoId })" class="btn btn-primary w-100">
                                Nhập số liệu báo cáo
                            </a>
                        }
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty-state">Không có kỳ báo cáo đang mở trong phạm vi của bạn.</div>
        }
    </section>

    <section class="filter-panel">
        @using (Html.BeginForm("Index", "Report", FormMethod.Get, new { @class = "filter-form" }))
        {
            <div class="filter-field">
                <label for="KyBaoCaoId">Kỳ báo cáo</label>
                @Html.DropDownListFor(m => m.KyBaoCaoId, Model.KyBaoCaoOptions, "Tất cả kỳ đang mở", new { @class = "form-select" })
            </div>
            if (Model.IsAdmin)
            {
                <div class="filter-field">
                    <label for="KhoaPhongId">Khoa/phòng</label>
                    @Html.DropDownListFor(m => m.KhoaPhongId, Model.KhoaPhongOptions, "Tất cả khoa/phòng", new { @class = "form-select" })
                </div>
                <div class="filter-field is-wide">
                    <label for="ChiSoChatLuongId">Chỉ số</label>
                    @Html.DropDownListFor(m => m.ChiSoChatLuongId, Model.ChiSoOptions, "Tất cả chỉ số", new { @class = "form-select" })
                </div>
            }
            <div class="filter-actions">
                <button class="btn btn-outline-primary" type="submit">Lọc</button>
                @if (Model.IsAdmin)
                {
                    @Html.ActionLink("Xuất Excel", "Reports", "Export", new { kyBaoCaoId = Model.KyBaoCaoId, khoaPhongId = Model.KhoaPhongId, chiSoChatLuongId = Model.ChiSoChatLuongId }, new { @class = "btn btn-outline-secondary" })
                }
                @if (!Model.IsAdmin && Model.KyBaoCaoId.HasValue)
                {
                    @Html.ActionLink("Nhập báo cáo", "Nhap", new { kyBaoCaoId = Model.KyBaoCaoId.Value }, new { @class = "btn btn-primary" })
                }
            </div>
        }
    </section>

    <section class="dashboard-panel">
        <div class="panel-header">
            <div>
                <h2>Lịch sử và danh sách báo cáo</h2>
                <p>@Model.TotalItems báo cáo trong bộ lọc hiện tại.</p>
            </div>
            <span class="status-pill status-muted">@reports.Count dòng</span>
        </div>

        @if (reports.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle report-table">
                    <thead>
                        <tr>
                            <th>Kỳ</th>
                            <th>Khoa/phòng</th>
                            <th>Chỉ số</th>
                            <th>Kết quả</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in reports)
                    {
                        <tr>
                            <td>@item.TenKyBaoCao</td>
                            <td>@item.TenKhoaPhong</td>
                            <td><strong>@item.MaChiSo</strong> - @item.TenChiSo</td>
                            <td class="numeric-value">@(item.KetQua.HasValue ? item.KetQua.Value.ToString("0.##") : "")</td>
                            <td>
                                @switch (item.TrangThai)
                                {
                                    case HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.Nhap:
                                        <span class="status-pill status-muted">Nháp</span>
                                        break;
                                    case HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.DaGui:
                                        <span class="status-pill status-success">Đã gửi</span>
                                        break;
                                    case HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.QuaHan:
                                        <span class="status-pill status-danger">Quá hạn</span>
                                        break;
                                    case HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.DaKhoa:
                                        <span class="status-pill status-muted">Đã khóa</span>
                                        break;
                                    default:
                                        <span class="status-pill status-muted">@item.TrangThai</span>
                                        break;
                                }
                            </td>
                            <td class="text-end table-actions">
                                @{
                                    var detailLabel = Model.IsAdmin ? "Xem" : (item.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.Nhap ? "Sửa" : "Xem");
                                }
                                @Html.ActionLink(detailLabel, "Edit", new { id = item.BaoCaoId }, new { @class = "btn btn-sm btn-outline-primary" })
                                @if (!Model.IsAdmin && item.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.Nhap)
                                {
                                    using (Html.BeginForm("Submit", "Report", new { id = item.BaoCaoId }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-success" type="submit">Gửi</button>
                                    }
                                }
                                @if (Model.IsAdmin)
                                {
                                    if (item.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.DaGui ||
                                        item.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.QuaHan)
                                    {
                                        using (Html.BeginForm("Lock", "Report", new { id = item.BaoCaoId }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-warning" type="submit">Khóa</button>
                                        }
                                    }
                                    using (Html.BeginForm("Delete", "Report", new { id = item.BaoCaoId }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Xóa báo cáo này?')">Xóa</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">Chưa có báo cáo phù hợp với bộ lọc hiện tại.</div>
        }

        @if (Model.TotalPages > 1)
        {
            <div class="management-toolbar mt-3">
                @Html.ActionLink("Trước", "Index", new { kyBaoCaoId = Model.KyBaoCaoId, khoaPhongId = Model.KhoaPhongId, chiSoChatLuongId = Model.ChiSoChatLuongId, page = Model.Page - 1 }, new { @class = "btn btn-outline-secondary " + (Model.Page <= 1 ? "disabled" : "") })
                <span class="status-pill status-muted">Trang @Model.Page / @Model.TotalPages</span>
                @Html.ActionLink("Sau", "Index", new { kyBaoCaoId = Model.KyBaoCaoId, khoaPhongId = Model.KhoaPhongId, chiSoChatLuongId = Model.ChiSoChatLuongId, page = Model.Page + 1 }, new { @class = "btn btn-outline-secondary " + (Model.Page >= Model.TotalPages ? "disabled" : "") })
            </div>
        }
    </section>
</section>
