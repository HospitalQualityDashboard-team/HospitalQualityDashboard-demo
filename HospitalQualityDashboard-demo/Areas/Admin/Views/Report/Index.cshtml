@* Mục đích: danh sách báo cáo, bộ lọc và thao tác duyệt/xuất dữ liệu. *@
@model HospitalQualityDashboardDemo.Models.ViewModels.ReportListViewModel
@using System.Linq
@{
    ViewBag.Title = "Báo cáo";
    var activePeriods = (Model.ActivePeriods ?? new System.Collections.Generic.List<HospitalQualityDashboardDemo.Models.ViewModels.KyBaoCaoViewModel>()).ToList();
    var reports = (Model.Items ?? new System.Collections.Generic.List<HospitalQualityDashboardDemo.Models.ViewModels.ReportEntryViewModel>()).ToList();
    var submittedCount = reports.Count(x =>
        x.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.DaGui ||
        x.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.QuaHan ||
        x.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.DaKhoa ||
        x.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.DaDuyet ||
        x.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.TraLai);
    var draftCount = reports.Count(x => x.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.Nhap || x.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.TraLai);
}

@* Combobox filters moved to Scripts/filter-combobox.js.
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var activeCombobox = null;

            function normalize(value) {
                return (value || '')
                    .toLowerCase()
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .replace(/đ/g, 'd');
            }

            function closeActiveCombobox() {
                if (activeCombobox) {
                    activeCombobox.classList.remove('is-open');
                    activeCombobox = null;
                }
            }

            function enhanceCombobox(select) {
                var placeholder = select.getAttribute('data-filter-placeholder') || '';
                var wrapper = document.createElement('div');
                var input = document.createElement('input');
                var clear = document.createElement('button');
                var list = document.createElement('div');
                var options = Array.prototype.slice.call(select.options).map(function (option) {
                    return { value: option.value, text: option.text };
                });
                var selected = options.find(function (option) { return option.value === select.value; });

                wrapper.className = 'report-filter-combobox';
                input.type = 'text';
                input.className = 'form-control report-filter-input';
                input.placeholder = placeholder;
                input.autocomplete = 'off';
                input.value = select.value && selected ? selected.text : '';
                input.setAttribute('aria-haspopup', 'listbox');
                clear.type = 'button';
                clear.className = 'report-filter-combobox-clear';
                clear.setAttribute('aria-label', 'Xóa lựa chọn');
                clear.textContent = '×';
                list.className = 'report-filter-options';
                list.setAttribute('role', 'listbox');

                select.classList.add('d-none');
                select.insertAdjacentElement('afterend', wrapper);
                wrapper.appendChild(input);
                wrapper.appendChild(clear);
                wrapper.appendChild(list);

                function setValue(value, text) {
                    select.value = value;
                    input.value = value ? text : '';
                    closeActiveCombobox();
                }

                function renderOptions() {
                    var term = normalize(input.value);
                    list.innerHTML = '';
                    options.filter(function (option) {
                        return !term || normalize(option.text).indexOf(term) > -1;
                    }).forEach(function (option) {
                        var item = document.createElement('button');
                        item.type = 'button';
                        item.className = 'report-filter-option' + (option.value === select.value ? ' is-selected' : '');
                        item.textContent = option.text;
                        item.title = option.text;
                        item.setAttribute('role', 'option');
                        item.addEventListener('mousedown', function (event) {
                            event.preventDefault();
                            setValue(option.value, option.text);
                        });
                        list.appendChild(item);
                    });
                }

                function openCombobox() {
                    if (activeCombobox && activeCombobox !== wrapper) {
                        closeActiveCombobox();
                    }
                    activeCombobox = wrapper;
                    renderOptions();
                    wrapper.classList.add('is-open');
                }

                input.addEventListener('focus', openCombobox);
                input.addEventListener('click', openCombobox);
                input.addEventListener('input', function () {
                    select.value = '';
                    openCombobox();
                });
                input.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape') {
                        closeActiveCombobox();
                    }
                });
                input.addEventListener('blur', function () {
                    window.setTimeout(function () {
                        if (!wrapper.contains(document.activeElement)) {
                            if (!select.value) {
                                input.value = '';
                            }
                            closeActiveCombobox();
                        }
                    }, 120);
                });
                clear.addEventListener('click', function () {
                    setValue('', '');
                    input.focus();
                });
            }

            document.querySelectorAll('select[data-filter-combobox]').forEach(enhanceCombobox);
            document.addEventListener('click', function (event) {
                if (activeCombobox && !activeCombobox.contains(event.target)) {
                    closeActiveCombobox();
                }
            });
        });
    </script>
*@

@helper FrequencyText(HospitalQualityDashboardDemo.Models.Enums.TanSuatBaoCao frequency)
{
    switch (frequency)
    {
        case HospitalQualityDashboardDemo.Models.Enums.TanSuatBaoCao.HangNgay:
            @:Hàng ngày
            break;
        case HospitalQualityDashboardDemo.Models.Enums.TanSuatBaoCao.HangTuan:
            @:Hàng tuần
            break;
        case HospitalQualityDashboardDemo.Models.Enums.TanSuatBaoCao.HangThang:
            @:Hàng tháng
            break;
        case HospitalQualityDashboardDemo.Models.Enums.TanSuatBaoCao.HangQuy:
            @:Hàng quý
            break;
        case HospitalQualityDashboardDemo.Models.Enums.TanSuatBaoCao.SauThang:
            @:6 tháng
            break;
        case HospitalQualityDashboardDemo.Models.Enums.TanSuatBaoCao.ChinThang:
            @:9 tháng
            break;
        case HospitalQualityDashboardDemo.Models.Enums.TanSuatBaoCao.HangNam:
            @:Hàng năm
            break;
        case HospitalQualityDashboardDemo.Models.Enums.TanSuatBaoCao.KhiPhatSinh:
            @:Khi phát sinh
            break;
        case HospitalQualityDashboardDemo.Models.Enums.TanSuatBaoCao.TruocSauKhiThucHien:
            @:Trước/sau thực hiện
            break;
        default:
            @frequency.ToString()
            break;
    }
}

@helper ReportDetailButton(HospitalQualityDashboardDemo.Models.ViewModels.ReportEntryViewModel item, string resultText)
{
    var numerator = item.TuSo.HasValue ? item.TuSo.Value.ToString("0.####") : "";
    var denominator = item.MauSo.HasValue ? item.MauSo.Value.ToString("0.####") : "";
    var inputValue = item.GiaTriNhap.HasValue ? item.GiaTriNhap.Value.ToString("0.####") : "";
    var target = item.DatMucTieu.HasValue ? (item.DatMucTieu.Value ? "true" : "false") : "";
    var submittedAt = item.NgayGui.HasValue ? item.NgayGui.Value.ToString("dd/MM/yyyy HH:mm") : "";
    <button type="button"
            class="btn btn-sm btn-outline-primary"
            data-bs-toggle="modal"
            data-bs-target="#reportDetailModal"
            data-report-id="@item.BaoCaoId"
            data-report-period="@item.TenKyBaoCao"
            data-report-department="@item.TenKhoaPhong"
            data-report-indicator-code="@item.MaChiSo"
            data-report-indicator-name="@item.TenChiSo"
            data-report-formula="@((int)item.LoaiCongThuc)"
            data-report-numerator="@numerator"
            data-report-denominator="@denominator"
            data-report-input-value="@inputValue"
            data-report-result="@resultText"
            data-report-target="@target"
            data-report-submitted-at="@submittedAt"
            data-report-submitted-by="@item.TenNguoiGui"
            data-report-status="@((int)item.TrangThai)"
            data-report-note="@item.GhiChu"
            data-report-feedback="@item.YKienPhanHoi">
        Xem
    </button>
}

@helper ReportRejectButton(HospitalQualityDashboardDemo.Models.ViewModels.ReportEntryViewModel item)
{
    var indicator = string.Join(" - ", new[] { item.MaChiSo, item.TenChiSo }.Where(x => !string.IsNullOrWhiteSpace(x)));
    <button type="button"
            class="btn btn-sm btn-outline-warning"
            data-bs-toggle="modal"
            data-bs-target="#reportRejectModal"
            data-report-reject-action="@Url.Action("Reject", "Report", new { id = item.BaoCaoId })"
            data-report-reject-period="@item.TenKyBaoCao"
            data-report-reject-department="@item.TenKhoaPhong"
            data-report-reject-indicator="@indicator">
        Trả về
    </button>
}

<section class="report-page">
    <div class="page-header report-header">
        <div>
            <span class="dashboard-role">Báo cáo chất lượng</span>
            <h1>Báo cáo</h1>
            <p>Theo dõi kỳ đang mở, nhập số liệu theo phân công và rà soát lịch sử báo cáo đã phát sinh.</p>
        </div>
        <div class="report-header-metrics">
            <div>
                <span>Kỳ đang mở</span>
                <strong>@activePeriods.Count</strong>
            </div>
            <div>
                <span>Báo cáo</span>
                <strong>@reports.Count</strong>
            </div>
            <div>
                <span>Nháp</span>
                <strong>@draftCount</strong>
            </div>
        </div>
    </div>

    <section class="dashboard-panel report-open-section">
        <div class="panel-header">
            <div>
                <h2>Kỳ báo cáo đang mở</h2>
                <p>User chỉ thấy các kỳ đã mở và phù hợp với tần suất chỉ số được phân công.</p>
            </div>
            <span class="status-pill status-success">@activePeriods.Count kỳ</span>
        </div>

        @if (activePeriods.Any())
        {
            <div class="report-open-grid">
                @foreach (var period in activePeriods)
                {
                    var isOverdue = DateTime.Today > period.HanNop.Date;
                    var percent = period.TongBaoCao > 0 ? (int)Math.Round((decimal)period.DaGui * 100 / period.TongBaoCao) : 0;
                    <article class="period-card @(isOverdue ? "is-overdue" : "")">
                        <div class="period-card-top">
                            <span class="status-pill status-muted">@FrequencyText(period.LoaiKyBaoCao)</span>
                            @if (isOverdue)
                            {
                                <span class="status-pill status-danger">Quá hạn</span>
                            }
                            else
                            {
                                <span class="status-pill status-success">Đang mở</span>
                            }
                        </div>
                        <h3>@period.TenKyBaoCao</h3>
                        <dl class="period-meta">
                            <div>
                                <dt>Khoảng báo cáo</dt>
                                <dd>@period.TuNgay.ToString("dd/MM/yyyy") - @period.DenNgay.ToString("dd/MM/yyyy")</dd>
                            </div>
                            <div>
                                <dt>Hạn nộp</dt>
                                <dd class="@(isOverdue ? "text-danger fw-bold" : "")">@period.HanNop.ToString("dd/MM/yyyy") 23:59</dd>
                            </div>
                        </dl>
                        @if (Model.IsAdmin)
                        {
                            <div class="period-progress">
                                <div class="progress-track">
                                    <div class="progress-fill" style="width: @(percent)%"></div>
                                </div>
                                <span>@period.DaGui/@period.TongBaoCao</span>
                            </div>
                            <a href="@Url.Action("Index", "Report", new { kyBaoCaoId = period.KyBaoCaoId })" class="btn btn-outline-primary w-100">
                                Xem tổng hợp
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("Nhap", "Report", new { kyBaoCaoId = period.KyBaoCaoId })" class="btn btn-primary w-100">
                                Nhập số liệu báo cáo
                            </a>
                        }
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty-state">Không có kỳ báo cáo đang mở trong phạm vi của bạn.</div>
        }
    </section>

    <section class="filter-panel">
        @using (Html.BeginForm("Index", "Report", FormMethod.Get, new { @class = "filter-form" }))
        {
            <div class="filter-field">
                <label for="KyBaoCaoId">Kỳ báo cáo</label>
                @Html.DropDownListFor(m => m.KyBaoCaoId, Model.KyBaoCaoOptions, "Tất cả kỳ đang mở", new { @class = "form-select report-filter-select", data_filter_combobox = "true", data_filter_placeholder = "Tất cả kỳ đang mở" })
            </div>
            if (Model.IsAdmin)
            {
                <div class="filter-field">
                    <label for="KhoaPhongId">Khoa/phòng</label>
                    @Html.DropDownListFor(m => m.KhoaPhongId, Model.KhoaPhongOptions, "Tất cả khoa/phòng", new { @class = "form-select report-filter-select", data_filter_combobox = "true", data_filter_placeholder = "Tất cả khoa/phòng" })
                </div>
                <div class="filter-field is-wide">
                    <label for="ChiSoChatLuongId">Chỉ số</label>
                    @Html.DropDownListFor(m => m.ChiSoChatLuongId, Model.ChiSoOptions, "Tất cả chỉ số", new { @class = "form-select report-filter-select", data_filter_combobox = "true", data_filter_placeholder = "Tất cả chỉ số" })
                </div>
            }
            <div class="filter-actions">
                <button class="btn btn-outline-primary" type="submit">Lọc</button>
                @Html.ActionLink("Xóa lọc", "Index", "Report", null, new { @class = "btn btn-outline-secondary report-filter-clear" })
                @if (Model.IsAdmin)
                {
                    @Html.ActionLink("Xuất Excel", "Reports", "Export", new { kyBaoCaoId = Model.KyBaoCaoId, khoaPhongId = Model.KhoaPhongId, chiSoChatLuongId = Model.ChiSoChatLuongId }, new { @class = "btn btn-outline-secondary" })
                }
                @if (!Model.IsAdmin && Model.KyBaoCaoId.HasValue)
                {
                    @Html.ActionLink("Nhập báo cáo", "Nhap", new { kyBaoCaoId = Model.KyBaoCaoId.Value }, new { @class = "btn btn-primary" })
                }
            </div>
        }
    </section>

    <section class="dashboard-panel">
        <div class="panel-header">
            <div>
                <h2>Lịch sử và danh sách báo cáo</h2>
                <p>@Model.TotalItems báo cáo trong bộ lọc hiện tại.</p>
            </div>
            <span class="status-pill status-muted">@reports.Count dòng</span>
        </div>

        @if (reports.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle report-table report-table-compact">
                    <thead>
                        <tr>
                            <th>Kỳ</th>
                            <th>Chỉ số</th>
                            <th>Kết quả</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in reports)
                    {
                        var resultText = item.KetQua.HasValue ? item.KetQua.Value.ToString("0.##") : "";
                        <tr>
                            <td>@item.TenKyBaoCao</td>
                            <td><strong>@item.MaChiSo</strong> - @item.TenChiSo</td>
                            <td class="numeric-value">@resultText</td>
                            <td>
                                @switch (item.TrangThai)
                                {
                                    case HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.Nhap:
                                        <span class="status-pill status-muted">Nháp</span>
                                        break;
                                    case HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.DaGui:
                                        <span class="status-pill status-info">Đã gửi chờ duyệt</span>
                                        break;
                                    case HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.QuaHan:
                                        <span class="status-pill status-danger">Quá hạn</span>
                                        break;
                                    case HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.DaKhoa:
                                        <span class="status-pill status-muted">Đã khóa</span>
                                        break;
                                    case HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.DaDuyet:
                                        <span class="status-pill status-success">Đã duyệt</span>
                                        break;
                                    case HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.TraLai:
                                        <span class="status-pill status-warning">Trả lại</span>
                                        break;
                                    default:
                                        <span class="status-pill status-muted">@item.TrangThai</span>
                                        break;
                                }
                            </td>
                            <td class="text-end table-actions">
                                @ReportDetailButton(item, resultText)
                                @if (!Model.IsAdmin && (item.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.Nhap || item.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.TraLai))
                                {
                                    using (Html.BeginForm("Submit", "Report", new { id = item.BaoCaoId }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-success" type="submit">Gửi</button>
                                    }
                                }
                                @if (Model.IsAdmin)
                                {
                                    if (item.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.DaGui)
                                    {
                                        using (Html.BeginForm("Approve", "Report", new { id = item.BaoCaoId }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-success" type="submit">Duyệt</button>
                                        }
                                        @ReportRejectButton(item)
                                    }
                                    if (item.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.DaGui ||
                                        item.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.QuaHan ||
                                        item.TrangThai == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.DaDuyet)
                                    {
                                        using (Html.BeginForm("Lock", "Report", new { id = item.BaoCaoId }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-secondary" type="submit">Khóa</button>
                                        }
                                    }
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">Chưa có báo cáo phù hợp với bộ lọc hiện tại.</div>
        }

        @if (Model.TotalPages > 1)
        {
            <div class="management-toolbar mt-3 d-flex justify-content-center align-items-center gap-3">
                @Html.ActionLink("Trước", "Index", new { kyBaoCaoId = Model.KyBaoCaoId, khoaPhongId = Model.KhoaPhongId, chiSoChatLuongId = Model.ChiSoChatLuongId, page = Model.Page - 1 }, new { @class = "btn btn-outline-secondary " + (Model.Page <= 1 ? "disabled" : "") })
                <span class="status-pill status-muted">Trang @Model.Page / @Model.TotalPages</span>
                @Html.ActionLink("Sau", "Index", new { kyBaoCaoId = Model.KyBaoCaoId, khoaPhongId = Model.KhoaPhongId, chiSoChatLuongId = Model.ChiSoChatLuongId, page = Model.Page + 1 }, new { @class = "btn btn-outline-secondary " + (Model.Page >= Model.TotalPages ? "disabled" : "") })
            </div>
        }
    </section>
</section>

@Html.Partial("_ReportDetailModal")
