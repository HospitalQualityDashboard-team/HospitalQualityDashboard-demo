                            <label class="form-check-label fw-semibold" for="enable-dashboard-comparison">So sánh nhiều kỳ</label>
                        </div>
                        <div id="dashboard-comparison-panel" class="mt-3" hidden>
                            <label class="form-label" for="dashboard-comparison-periods">Các kỳ dùng để so sánh</label>
                            <select class="form-select form-select-sm" id="dashboard-comparison-periods" name="ComparisonPeriodIds" multiple size="5" disabled></select>
                            <div class="form-text">Chỉ hiển thị kỳ cũ hơn, cùng tần suất. Có thể chọn tối đa 11 kỳ so sánh.</div>
                            <div class="text-danger small mt-1" id="dashboard-comparison-message"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light border rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4" id="dashboard-export-submit">
                        <i class="bi bi-download me-1"></i> Xuất Excel
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
function initializeDashboardComparison() {
    var periods = window.dashboardComparisonPeriods || [];
    var primarySelect = document.getElementById('KyBaoCaoId');
    var toggle = document.getElementById('enable-dashboard-comparison');
    var panel = document.getElementById('dashboard-comparison-panel');
    var comparisonSelect = document.getElementById('dashboard-comparison-periods');
    var message = document.getElementById('dashboard-comparison-message');
    if (!primarySelect || !toggle || !panel || !comparisonSelect) return;

    function refreshPeriods() {
        var primary = periods.find(function(period) {
            return String(period.id) === primarySelect.value;
        });
        var eligible = primary
            ? periods.filter(function(period) {
                return period.frequency === primary.frequency && period.start < primary.start;
            })
            : [];

        comparisonSelect.innerHTML = '';
        eligible.forEach(function(period, index) {
            comparisonSelect.add(new Option(period.name, period.id, index === 0, index === 0));
        });

        toggle.disabled = !primary || eligible.length === 0;
        if (toggle.disabled) toggle.checked = false;
        panel.hidden = !toggle.checked;
        comparisonSelect.disabled = !toggle.checked;
        message.textContent = primary && eligible.length === 0
            ? 'Không có kỳ cũ hơn cùng tần suất để so sánh.'
            : '';
    }

    toggle.addEventListener('change', function() {
        panel.hidden = !toggle.checked;
        comparisonSelect.disabled = !toggle.checked;
        if (toggle.checked && comparisonSelect.options.length > 0 && comparisonSelect.selectedOptions.length === 0) {
            comparisonSelect.options[0].selected = true;
        }
    });
    comparisonSelect.addEventListener('change', function() {
        var selected = Array.from(comparisonSelect.selectedOptions);
        if (selected.length > 11) selected[selected.length - 1].selected = false;
    });
    primarySelect.addEventListener('change', refreshPeriods);
    refreshPeriods();
}

var labels = [@Html.Raw(string.Join(",", progressItems.Select(x => "\"" + HttpUtility.JavaScriptStringEncode(x.TenKhoaPhong) + "\"")))];
var values = [@string.Join(",", progressItems.Select(x => x.DaGui))];
var totals = [@string.Join(",", progressItems.Select(x => x.Tong))];
var chartElement = document.getElementById('progressChart');
window.dashboardComparisonPeriods = [
@foreach (var period in Model.ComparisonPeriods ?? new System.Collections.Generic.List<HospitalQualityDashboardDemo.Models.DTOs.DashboardComparisonPeriodDto>())
{
    <text>{ id: @period.KyBaoCaoId, name: "@Html.Raw(HttpUtility.JavaScriptStringEncode(period.TenKyBaoCao))", frequency: @period.TanSuat, start: "@period.TuNgay.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" },</text>
}
];

if (chartElement && labels.length) {
    new Chart(chartElement, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Đã gửi',
                    data: values,
                    backgroundColor: 'rgba(20, 108, 120, 0.82)',
                    borderColor: 'rgba(20, 108, 120, 1)',
                    borderWidth: 1,
                    borderRadius: 6
                },
                {
                    label: 'Tổng cần nộp',
                    data: totals,
                    backgroundColor: 'rgba(37, 99, 235, 0.18)',
                    borderColor: 'rgba(37, 99, 235, 0.52)',
                    borderWidth: 1,
                    borderRadius: 6
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        boxWidth: 12,
                        boxHeight: 12
                    }
                }
            },
            scales: {
                x: {
                    grid: {
                        display: false
                    },
                    ticks: {
                        maxRotation: 0,
                        autoSkip: true,
                        maxTicksLimit: 8
                    }
                },
                y: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0
                    }
                }
            }
        }
    });
}

var metricDetailModal = document.getElementById('dashboardMetricDetailModal');
if (metricDetailModal) {
    var warningSelectAll = metricDetailModal.querySelector('[data-warning-select-all]');
    var warningBulkSubmit = metricDetailModal.querySelector('[data-warning-bulk-submit]');
    var periodStateFilter = metricDetailModal.querySelector('[data-period-state-filter]');
    var reportPeriodFilter = metricDetailModal.querySelector('[data-report-period-filter]');
    var indicatorDetailPanel = metricDetailModal.querySelector('[data-indicator-detail-panel]');
    var indicatorDetailTriggers = Array.from(metricDetailModal.querySelectorAll('[data-indicator-detail-trigger]'));
    var metricRows = Array.from(metricDetailModal.querySelectorAll('tbody tr[data-metric-groups]'));
    var metricPageSize = 10;
    var metricCurrentPage = 1;
    var metricPagination = metricDetailModal.querySelector('[data-metric-pagination]');
    var metricPageSummary = metricDetailModal.querySelector('[data-metric-page-summary]');
    var metricPrevPage = metricDetailModal.querySelector('[data-metric-prev-page]');
    var metricNextPage = metricDetailModal.querySelector('[data-metric-next-page]');
    var activeMetric = 'total';

    function setIndicatorDetail(target) {
        if (!indicatorDetailPanel || !target) return;

        var fields = {
            code: target.getAttribute('data-detail-code') || '-',
            name: target.getAttribute('data-detail-name') || '-',
            period: target.getAttribute('data-detail-period') || '-',
            due: target.getAttribute('data-detail-due') || '-',
            department: target.getAttribute('data-detail-department') || '-',
            status: target.getAttribute('data-detail-status') || '-',
            'period-state': target.getAttribute('data-detail-period-state') || '-',
            result: target.getAttribute('data-detail-result') || '-',
            target: target.getAttribute('data-detail-target') || '-',
            review: target.getAttribute('data-detail-review') || '-'
        };

        Object.keys(fields).forEach(function(key) {
            var node = indicatorDetailPanel.querySelector('[data-indicator-detail-' + key + ']');
            if (node) node.textContent = fields[key];
        });

        indicatorDetailPanel.hidden = false;
        indicatorDetailTriggers.forEach(function(trigger) {
            trigger.setAttribute('aria-expanded', trigger === target ? 'true' : 'false');
            var row = trigger.closest('tr[data-metric-groups]');
            if (row) row.classList.toggle('is-detail-active', trigger === target);
        });
    }

    function resetIndicatorDetail() {
        if (indicatorDetailPanel) {
            indicatorDetailPanel.hidden = true;
        }
        indicatorDetailTriggers.forEach(function(trigger) {
            trigger.setAttribute('aria-expanded', 'false');
            var row = trigger.closest('tr[data-metric-groups]');
            if (row) row.classList.remove('is-detail-active');
        });
    }

    function getVisibleWarningTargets() {
        return Array.from(metricDetailModal.querySelectorAll('[data-warning-target]')).filter(function(target) {
            var row = target.closest('tr[data-metric-groups]');
            return row && !row.hidden && row.getAttribute('data-filter-match') === 'true' && !target.disabled;
        });
    }

    function updateWarningBulkControls() {
        var targets = getVisibleWarningTargets();
        var checkedTargets = targets.filter(function(target) { return target.checked; });
        if (warningBulkSubmit) {
            warningBulkSubmit.disabled = checkedTargets.length === 0;
        }
        if (warningSelectAll) {
            warningSelectAll.disabled = targets.length === 0;
            warningSelectAll.checked = targets.length > 0 && checkedTargets.length === targets.length;
            warningSelectAll.indeterminate = checkedTargets.length > 0 && checkedTargets.length < targets.length;
        }
    }

    function clearWarningSelections() {
        metricDetailModal.querySelectorAll('[data-warning-target]').forEach(function(target) {
            target.checked = false;
        });
    }

    function forceOpenPeriodOnly(metric) {
        if (!periodStateFilter) return;

        if (metric === 'total') {
            periodStateFilter.value = 'open';
            periodStateFilter.disabled = true;
        } else {
            periodStateFilter.disabled = false;
            periodStateFilter.value = 'all';
        }
    }

    function getRowPeriodName(row) {
        var trigger = row.querySelector('[data-indicator-detail-trigger]');
        return trigger ? trigger.getAttribute('data-detail-period') || '' : '';
    }

    function populateReportPeriodFilter() {
        if (!reportPeriodFilter) return;

        var existingValue = reportPeriodFilter.value || 'all';
        var periods = [];
        var seen = {};
        metricRows.forEach(function(row) {
            var id = row.getAttribute('data-period-id');
            if (!id || seen[id]) return;
            seen[id] = true;
            periods.push({
                id: id,
                name: getRowPeriodName(row),
                start: row.getAttribute('data-period-start') || '',
                end: row.getAttribute('data-period-end') || '',
                frequency: row.getAttribute('data-period-frequency') || ''
            });
        });

        periods.sort(function(a, b) {
            return b.start.localeCompare(a.start);
        });

        reportPeriodFilter.innerHTML = '';
        reportPeriodFilter.add(new Option('Tất cả kỳ', 'all'));
        periods.forEach(function(period) {
            var option = new Option(period.name || ('Kỳ #' + period.id), period.id);
            option.setAttribute('data-period-start', period.start);
            option.setAttribute('data-period-end', period.end);
            option.setAttribute('data-period-frequency', period.frequency);
            reportPeriodFilter.add(option);
        });

        reportPeriodFilter.value = Array.from(reportPeriodFilter.options).some(function(option) {
            return option.value === existingValue;
        }) ? existingValue : 'all';
    }

    function selectCurrentMonthlyPeriod() {
        if (!reportPeriodFilter) return;

        var today = new Date();
        var currentYear = today.getFullYear();
        var currentMonth = today.getMonth();
        var currentOption = Array.from(reportPeriodFilter.options).find(function(option) {
            if (option.value === 'all') return false;
            if (option.getAttribute('data-period-frequency') !== '3') return false;
            var start = new Date(option.getAttribute('data-period-start') + 'T00:00:00');
            var end = new Date(option.getAttribute('data-period-end') + 'T00:00:00');
            if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime())) return false;
            return start.getFullYear() === currentYear
                && start.getMonth() === currentMonth
                && end.getFullYear() === currentYear
                && end.getMonth() === currentMonth;
        });

        reportPeriodFilter.value = currentOption ? currentOption.value : 'all';
    }

    function setMetricPage(page, totalPages) {
        metricCurrentPage = Math.min(Math.max(page, 1), Math.max(totalPages, 1));
    }

    function applyMetricFilters(metric) {
        if (metric) activeMetric = metric;
        var selectedPeriodState = periodStateFilter ? periodStateFilter.value : 'all';
        var selectedPeriodId = reportPeriodFilter ? reportPeriodFilter.value : 'all';
        var matchedRows = [];

        metricRows.forEach(function(row) {
            var groups = (row.getAttribute('data-metric-groups') || '').split(' ');
            var periodState = row.getAttribute('data-period-state') || 'open';
            var periodId = row.getAttribute('data-period-id') || '';
            var matchesMetric = groups.indexOf(activeMetric) >= 0;
            var matchesPeriodState = selectedPeriodState === 'all' || periodState === selectedPeriodState;
            var matchesReportPeriod = selectedPeriodId === 'all' || periodId === selectedPeriodId;
            var matches = matchesMetric && matchesPeriodState && matchesReportPeriod;
            row.setAttribute('data-filter-match', matches ? 'true' : 'false');
            if (matches) matchedRows.push(row);
        });

        var visibleCount = matchedRows.length;
        var totalPages = Math.max(Math.ceil(visibleCount / metricPageSize), 1);
        setMetricPage(metricCurrentPage, totalPages);
        metricRows.forEach(function(row) {
            row.hidden = true;
        });
        matchedRows.forEach(function(row, index) {
            var pageIndex = Math.floor(index / metricPageSize) + 1;
            row.hidden = pageIndex !== metricCurrentPage;
        });

        metricDetailModal.querySelector('[data-metric-count]').textContent = visibleCount + ' dòng';
        metricDetailModal.querySelector('[data-metric-empty]').hidden = visibleCount !== 0;
        if (metricPagination) {
            metricPagination.hidden = visibleCount <= metricPageSize;
        }
        if (metricPageSummary) {
            metricPageSummary.textContent = 'Trang ' + (visibleCount === 0 ? 0 : metricCurrentPage) + '/' + (visibleCount === 0 ? 0 : totalPages);
        }
        if (metricPrevPage) {
            metricPrevPage.disabled = metricCurrentPage <= 1 || visibleCount === 0;
        }
        if (metricNextPage) {
            metricNextPage.disabled = metricCurrentPage >= totalPages || visibleCount === 0;
        }
        updateWarningBulkControls();
    }

    metricDetailModal.addEventListener('show.bs.modal', function(event) {
        var trigger = event.relatedTarget;
        var metric = trigger ? trigger.getAttribute('data-metric') : 'total';
        var title = trigger ? trigger.getAttribute('data-title') : 'Danh sách chỉ số chưa nộp/quá hạn';

        metricDetailModal.querySelector('[data-metric-title]').textContent = title;
        resetIndicatorDetail();
        clearWarningSelections();
        forceOpenPeriodOnly(metric);
        populateReportPeriodFilter();
        selectCurrentMonthlyPeriod();
        metricCurrentPage = 1;
        applyMetricFilters(metric);
    });

    if (periodStateFilter) {
        periodStateFilter.addEventListener('change', function() {
            resetIndicatorDetail();
            clearWarningSelections();
            metricCurrentPage = 1;
            applyMetricFilters();
        });
    }

    if (reportPeriodFilter) {
        reportPeriodFilter.addEventListener('change', function() {
            resetIndicatorDetail();
            clearWarningSelections();
            metricCurrentPage = 1;
            applyMetricFilters();
        });
    }

    if (metricPrevPage) {
        metricPrevPage.addEventListener('click', function() {
            resetIndicatorDetail();
            clearWarningSelections();
            metricCurrentPage -= 1;
            applyMetricFilters();
        });
    }

    if (metricNextPage) {
        metricNextPage.addEventListener('click', function() {
            resetIndicatorDetail();
            clearWarningSelections();
            metricCurrentPage += 1;
            applyMetricFilters();
        });
    }

    if (warningSelectAll) {
        warningSelectAll.addEventListener('change', function() {
            getVisibleWarningTargets().forEach(function(target) {
                target.checked = warningSelectAll.checked;
            });
            updateWarningBulkControls();
        });
    }

    metricDetailModal.querySelectorAll('[data-warning-target]').forEach(function(target) {
        target.addEventListener('change', updateWarningBulkControls);
    });

    indicatorDetailTriggers.forEach(function(trigger) {
        trigger.addEventListener('click', function() {
            setIndicatorDetail(trigger);
        });
    });
}

document.addEventListener('DOMContentLoaded', function() {
    initializeDashboardComparison();
});
    </script>
}
