@* Mục đích: dashboard tổng hợp tiến độ báo cáo và cảnh báo thiếu/quá hạn. *@
@model HospitalQualityDashboardDemo.Models.ViewModels.DashboardViewModel
@using System.Globalization
@using System.Linq
@using System.Web
@{
    ViewBag.Title = "Tổng quan";

    var progressItems = (Model.DepartmentProgress ?? new System.Collections.Generic.List<HospitalQualityDashboardDemo.Models.ViewModels.DepartmentProgressViewModel>()).ToList();
    var missingReports = (Model.MissingReports ?? new System.Collections.Generic.List<HospitalQualityDashboardDemo.Models.ViewModels.MissingReportAlertViewModel>()).ToList();
    var metricDetails = (Model.MetricDetails ?? new System.Collections.Generic.List<HospitalQualityDashboardDemo.Models.ViewModels.DashboardMetricDetailViewModel>()).ToList();
    var totalReportSlots = Model.TongBaoCaoCanNop;
    var completionRate = totalReportSlots > 0
        ? Math.Round((decimal)Model.BaoCaoDaGui * 100 / totalReportSlots, 2)
        : 0;
    var completionRateText = completionRate.ToString("0.##", CultureInfo.GetCultureInfo("vi-VN"));
    var roleLabel = Model.IsAdmin ? "Admin hệ thống" : "Khoa/phòng";
    var totalMetricLabel = Model.IsAdmin ? "Tổng cần nộp" : "Chỉ số được phân công";
    var urgentCount = Model.OverdueMissingReportCount + Model.DueSoonReportCount;
}

<section class="dashboard-hero">
    <div class="dashboard-titlebar">
        <span class="dashboard-role">@roleLabel</span>
        <h1>Trung tâm điều hành chất lượng</h1>
        <p>Theo dõi tiến độ nộp báo cáo, nhận diện chỉ số còn thiếu và kiểm soát rủi ro quá hạn theo khoa/phòng.</p>
    </div>
    <div class="dashboard-summary-strip" aria-label="Tóm tắt tiến độ">
        <div class="dashboard-summary-item">
            <span>Tỷ lệ hoàn tất</span>
            <strong>@completionRateText%</strong>
        </div>
        <div class="dashboard-summary-item">
            <span>Cần xử lý</span>
            <strong>@urgentCount</strong>
        </div>
        <div class="dashboard-summary-item">
            <span>Khoa/phòng</span>
            <strong>@progressItems.Count</strong>
        </div>
    </div>
</section>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info dashboard-feedback" role="status">@TempData["Message"]</div>
}

@if (!Model.IsAdmin)
{
    <section class="missing-work-panel missing-report-alert">
        <div class="missing-work-summary">
            <div>
                <h2>Việc báo cáo cần xử lý</h2>
                @if (missingReports.Any())
                {
                    <p>Bạn có @missingReports.Count chỉ số chưa báo cáo trong các kỳ đang theo dõi.</p>
                    <div class="status-stack">
                        <span class="status-pill status-danger">@Model.OverdueMissingReportCount quá hạn</span>
                        <span class="status-pill status-warning">@Model.DueSoonReportCount sắp đến hạn</span>
                    </div>
                }
                else
                {
                    <p>Không có chỉ số quá hạn hoặc sắp đến hạn trong phạm vi phân công hiện tại.</p>
                }
            </div>
            @if (missingReports.Any())
            {
                <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#missingReportDetails" aria-expanded="false" aria-controls="missingReportDetails">
                    Xem danh sách
                </button>
            }
        </div>
        @if (missingReports.Any())
        {
            <div class="collapse missing-work-detail" id="missingReportDetails">
                <div class="table-responsive mt-3">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Kỳ báo cáo</th>
                                <th>Hạn nộp</th>
                                <th>Chỉ số</th>
                                <th>Trạng thái</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in missingReports)
                        {
                            <tr>
                                <td>@item.TenKyBaoCao</td>
                                <td>@item.HanNop.ToString("dd/MM/yyyy") 23:59</td>
                                <td><strong>@item.MaChiSo</strong> - @item.TenChiSo</td>
                                <td>
                                    @if (item.IsOverdue)
                                    {
                                        <span class="status-pill status-danger">Quá hạn @Math.Abs(item.DaysUntilDue) ngày</span>
                                    }
                                    else if (item.IsDueSoon)
                                    {
                                        <span class="status-pill status-warning">Còn @item.DaysUntilDue ngày</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-muted">Chưa gửi</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @Html.ActionLink("Nhập báo cáo", "Edit", "Report", new { kyBaoCaoId = item.KyBaoCaoId, chiSoChatLuongId = item.ChiSoChatLuongId }, new { @class = "btn btn-sm btn-primary" })
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>
}

<section class="metric-grid" aria-label="Chỉ số tổng quan">
    <button type="button" class="metric-card metric-card-button is-accent" data-bs-toggle="modal" data-bs-target="#dashboardMetricDetailModal" data-metric="total" data-title="Danh sách chỉ số cần nộp">
        <span class="metric-card-header">
            <span class="metric-label">@totalMetricLabel</span>
            <span class="metric-icon">CS</span>
        </span>
        <strong class="metric-value">@Model.TongBaoCaoCanNop</strong>
        <span class="metric-caption">Tổng số báo cáo cần nộp theo kỳ và khoa/phòng.</span>
    </button>
    <button type="button" class="metric-card metric-card-button is-success" data-bs-toggle="modal" data-bs-target="#dashboardMetricDetailModal" data-metric="submitted" data-title="Danh sách báo cáo đã nộp">
        <span class="metric-card-header">
            <span class="metric-label">Đã báo cáo</span>
            <span class="metric-icon">ĐG</span>
        </span>
        <strong class="metric-value">@Model.BaoCaoDaGui</strong>
        <span class="metric-caption">@completionRateText% hồ sơ báo cáo đã hoàn tất.</span>
    </button>
    <button type="button" class="metric-card metric-card-button is-warning" data-bs-toggle="modal" data-bs-target="#dashboardMetricDetailModal" data-metric="missing" data-title="Danh sách chỉ số còn thiếu báo cáo">
        <span class="metric-card-header">
            <span class="metric-label">Còn thiếu</span>
            <span class="metric-icon">CT</span>
        </span>
        <strong class="metric-value">@Model.BaoCaoThieu</strong>
        <span class="metric-caption">Chỉ số chưa có báo cáo hợp lệ.</span>
    </button>
    <button type="button" class="metric-card metric-card-button is-danger" data-bs-toggle="modal" data-bs-target="#dashboardMetricDetailModal" data-metric="overdue" data-title="Danh sách chỉ số quá hạn chưa nộp">
        <span class="metric-card-header">
            <span class="metric-label">Quá hạn</span>
            <span class="metric-icon">QH</span>
        </span>
        <strong class="metric-value">@Model.BaoCaoQuaHan</strong>
        <span class="metric-caption">Cần rà soát và nhắc nộp bổ sung.</span>
    </button>
</section>

<div class="modal fade dashboard-metric-modal" id="dashboardMetricDetailModal" tabindex="-1" aria-labelledby="dashboardMetricDetailTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title fs-5" id="dashboardMetricDetailTitle" data-metric-title>Danh sách chỉ số cần nộp</h2>
                    <p class="text-muted small mb-0">Dữ liệu theo bộ lọc tần suất hiện tại.</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="status-pill status-muted" data-metric-count>0 dòng</span>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
            </div>
            <div class="modal-body">
                <div class="table-responsive dashboard-metric-table-wrap">
                    <table class="table table-sm align-middle mb-0 dashboard-metric-table">
                        <thead>
                            <tr>
                                <th>Kỳ báo cáo</th>
                                <th>Hạn nộp</th>
                                <th>Khoa/phòng</th>
                                <th>Chỉ số</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Kết quả</th>
                                <th>Đánh giá</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in metricDetails)
                        {
                            var groups = item.IsSubmitted
                                ? "total submitted"
                                : item.IsOverdueMissing ? "total missing overdue" : "total missing";
                            <tr data-metric-groups="@groups">
                                <td>@item.TenKyBaoCao</td>
                                <td class="text-nowrap">@item.HanNop.ToString("dd/MM/yyyy")</td>
                                <td>@item.TenKhoaPhong</td>
                                <td><strong>@item.MaChiSo</strong> - @item.TenChiSo</td>
                                <td>
                                    @if (item.IsSubmitted)
                                    {
                                        <span class="status-pill status-success">Đã nộp</span>
                                    }
                                    else if (item.IsOverdueMissing)
                                    {
                                        <span class="status-pill status-danger">Quá hạn</span>
                                    }
                                    else if (item.TrangThaiBaoCao == HospitalQualityDashboardDemo.Models.Enums.TrangThaiBaoCao.Nhap)
                                    {
                                        <span class="status-pill status-warning">Chưa nộp (đã lưu nháp)</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-muted">Chưa nộp</span>
                                    }
                                </td>
                                <td class="numeric-value text-end">
                                    @(item.IsSubmitted && item.KetQua.HasValue ? item.KetQua.Value.ToString("0.##", CultureInfo.GetCultureInfo("vi-VN")) : "-")
                                </td>
                                <td>
                                    @if (!item.IsSubmitted)
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                    else if (item.DatMucTieu == true)
                                    {
                                        <span class="status-pill status-success">Đạt</span>
                                    }
                                    else if (item.DatMucTieu == false)
                                    {
                                        <span class="status-pill status-danger">Chưa đạt</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-muted">Chưa đánh giá</span>
                                    }
                                </td>
                                <td class="text-end dashboard-warning-action">
                                    @if (!item.IsSubmitted)
                                    {
                                        if (item.HasWarningToday)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                                                <i class="bi bi-bell-fill me-1"></i>Đã cảnh báo hôm nay
                                            </button>
                                        }
                                        else
                                        {
                                            <form method="post" action="@Url.Action("WarnIndicator", "Dashboard")" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="kyBaoCaoId" value="@item.KyBaoCaoId" />
                                                <input type="hidden" name="khoaPhongId" value="@item.KhoaPhongId" />
                                                <input type="hidden" name="chiSoChatLuongId" value="@item.ChiSoChatLuongId" />
                                                <input type="hidden" name="tanSuat" value="@Model.SelectedTanSuat" />
                                                <button type="submit" class="btn btn-sm btn-outline-warning">
                                                    <i class="bi bi-bell me-1"></i>Cảnh báo
                                                </button>
                                            </form>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                            <tr data-metric-empty hidden>
                                <td colspan="8" class="empty-state">Không có dữ liệu trong nhóm này.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<section class="dashboard-grid">
    <div class="dashboard-panel">
        <div class="panel-header">
            <div>
                <h2>Tiến độ báo cáo theo khoa/phòng</h2>
                <p>So sánh số báo cáo đã gửi với tổng chỉ số cần nộp.</p>
            </div>
            <div class="panel-toolbar">
                <span class="status-pill status-success">@Model.BaoCaoDaGui đã gửi</span>
                <span class="status-pill status-muted">@Model.BaoCaoThieu còn thiếu</span>
            </div>
        </div>
        @if (progressItems.Any())
        {
            <div class="chart-shell">
                <canvas id="progressChart" height="108"></canvas>
            </div>
        }
        else
        {
            <div class="empty-state">Chưa có dữ liệu tiến độ để hiển thị.</div>
        }
    </div>

    <div class="dashboard-panel">
        <div class="panel-header d-flex justify-content-between align-items-center">
            <div>
                <h2>Bảng tiến độ</h2>
                <p>Tỷ lệ hoàn tất của từng khoa/phòng.</p>
            </div>
            <div class="mobile-stack-actions align-items-center dashboard-panel-actions">
                @using (Html.BeginForm("Index", "Dashboard", FormMethod.Get, new { id = "dashboardFilterForm", @class = "d-flex align-items-center gap-2" }))
                {
                    @Html.DropDownList("tanSuat", Model.TanSuatOptions, new { @class = "form-select form-select-sm border rounded-pill px-3", onchange = "this.form.submit();" })
                }
                @if (progressItems.Any())
                {
                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#dashboardExportModal">
                        <i class="bi bi-file-earmark-excel me-1 text-success"></i> Xuất Excel
                    </button>
                }
            </div>
        </div>
        @if (progressItems.Any())
        {
            <div class="progress-list">
                @foreach (var item in progressItems)
                {
                    var percent = item.Tong > 0 ? (int)Math.Round((decimal)item.DaGui * 100 / item.Tong) : 0;
                    <div class="progress-row d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="progress-name d-flex align-items-center justify-content-between">
                                <span class="fw-bold">@item.TenKhoaPhong</span>
                                @{
                                    var badgeClass = "bg-secondary";
                                    if (item.Tong > 0)
                                    {
                                        var rate = (decimal)item.DaGui * 100 / item.Tong;
                                        if (rate >= 90) { badgeClass = "bg-success"; }
                                        else if (rate >= 70) { badgeClass = "bg-info text-dark"; }
                                        else if (rate >= 50) { badgeClass = "bg-warning text-dark"; }
                                        else { badgeClass = "bg-danger"; }
                                    }
                                }
                                <span class="badge @badgeClass ms-2 px-2 py-1 small rounded-pill">@item.XepLoai</span>
                            </div>
                            <div class="progress-meta text-muted small mt-1">
                                <span>Đã gửi: <strong>@item.DaGui</strong>/@item.Tong</span> | 
                                <span>Nháp: <strong class="text-secondary">@item.LuuNhap</strong></span> | 
                                <span>Thiếu: <strong class="text-danger">@item.ConThieu</strong></span>
                                @if (item.TongThang > 0) { <span> | Tháng: @item.TiendoHangThang (<span class="small font-monospace">@item.XepLoaiThang</span>)</span> }
                                @if (item.TongQuy > 0) { <span> | Quý: @item.TiendoHangQuy (<span class="small font-monospace">@item.XepLoaiQuy</span>)</span> }
                                @if (item.TongNam > 0) { <span> | Năm: @item.TiendoHangNam (<span class="small font-monospace">@item.XepLoaiNam</span>)</span> }
                            </div>
                            <div class="progress-track mt-2" aria-label="@item.TenKhoaPhong đạt @percent%">
                                <div class="progress-fill" style="width: @(percent)%"></div>
                            </div>
                        </div>
                        <div class="progress-number ms-3 fw-bold">@percent%</div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">Chưa có khoa/phòng trong phạm vi theo dõi.</div>
        }
    </div>
</section>

<div class="modal fade" id="dashboardExportModal" tabindex="-1" aria-labelledby="dashboardExportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-3">
            @using (Html.BeginForm("Dashboard", "Export", new { area = "Admin" }, FormMethod.Get, new { id = "dashboardExportForm" }))
            {
                <input type="hidden" name="TanSuat" value="@Model.SelectedTanSuat" />
                <div class="modal-header border-0 pb-2">
                    <h5 class="modal-title fw-bold text-secondary" id="dashboardExportModalLabel">
                        <i class="bi bi-file-earmark-excel me-1 text-success"></i> Xuất Excel Dashboard
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body pt-0">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label" for="NamBaoCao">Năm báo cáo</label>
                            @Html.DropDownList("NamBaoCao", Model.NamBaoCaoOptions, new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="KyBaoCaoId">Kỳ báo cáo</label>
                            @Html.DropDownList("KyBaoCaoId", Model.KyBaoCaoOptions, new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="KhoaPhongId">Khoa/phòng</label>
                            @Html.DropDownList("KhoaPhongId", Model.KhoaPhongOptions, new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="LinhVuc">Lĩnh vực</label>
                            @Html.DropDownList("LinhVuc", Model.LinhVucOptions, new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="TrangThaiNhapLieu">Trạng thái nhập liệu</label>
                            @Html.DropDownList("TrangThaiNhapLieu", Model.TrangThaiNhapLieuOptions, new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="TrangThaiDuyet">Trạng thái duyệt</label>
                            @Html.DropDownList("TrangThaiDuyet", Model.TrangThaiDuyetOptions, new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="DatMucTieu">Đạt/chưa đạt mục tiêu</label>
                            @Html.DropDownList("DatMucTieu", Model.DatMucTieuOptions, new { @class = "form-select form-select-sm" })
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted small fw-semibold">Cột xuất file</span>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-light border rounded-pill px-3" id="dashboard-export-select-all">Chọn tất cả</button>
                            <button type="button" class="btn btn-sm btn-light border rounded-pill px-3" id="dashboard-export-clear">Bỏ chọn</button>
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-6">
                            <div class="form-check py-1">
                                <input class="form-check-input dashboard-export-column" type="checkbox" name="columns" value="TenKhoaPhong" id="db_export_TenKhoaPhong" checked />
                                <label class="form-check-label" for="db_export_TenKhoaPhong">Khoa / Phòng</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check py-1">
                                <input class="form-check-input dashboard-export-column" type="checkbox" name="columns" value="DaGui" id="db_export_DaGui" checked />
                                <label class="form-check-label" for="db_export_DaGui">Số báo cáo đã gửi</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check py-1">
                                <input class="form-check-input dashboard-export-column" type="checkbox" name="columns" value="Tong" id="db_export_Tong" checked />
                                <label class="form-check-label" for="db_export_Tong">Tổng số chỉ số</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check py-1">
                                <input class="form-check-input dashboard-export-column" type="checkbox" name="columns" value="PhanTram" id="db_export_PhanTram" checked />
                                <label class="form-check-label" for="db_export_PhanTram">Tỷ lệ hoàn tất (%)</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check py-1">
                                <input class="form-check-input dashboard-export-column" type="checkbox" name="columns" value="LuuNhap" id="db_export_LuuNhap" checked />
                                <label class="form-check-label" for="db_export_LuuNhap">Báo cáo lưu nháp</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check py-1">
                                <input class="form-check-input dashboard-export-column" type="checkbox" name="columns" value="ConThieu" id="db_export_ConThieu" checked />
                                <label class="form-check-label" for="db_export_ConThieu">Báo cáo còn thiếu</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-check py-1">
                                <input class="form-check-input dashboard-export-column" type="checkbox" name="columns" value="XepLoai" id="db_export_XepLoai" checked />
                                <label class="form-check-label" for="db_export_XepLoai">Xếp loại tổng thể</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check py-1">
                                <input class="form-check-input dashboard-export-column" type="checkbox" name="columns" value="SoBaoCaoDatMucTieuNam" id="db_export_SoBaoCaoDatMucTieuNam" checked />
                                <label class="form-check-label" for="db_export_SoBaoCaoDatMucTieuNam">Đạt mục tiêu năm</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check py-1">
                                <input class="form-check-input dashboard-export-column" type="checkbox" name="columns" value="SoBaoCaoDanhGiaMucTieuNam" id="db_export_SoBaoCaoDanhGiaMucTieuNam" checked />
