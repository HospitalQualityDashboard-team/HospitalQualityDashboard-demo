                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="KhoaPhongId">Khoa/phòng</label>
                            @Html.DropDownList("KhoaPhongId", Model.KhoaPhongOptions, new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="LinhVuc">Lĩnh vực</label>
                            @Html.DropDownList("LinhVuc", Model.LinhVucOptions, new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="TrangThaiNhapLieu">Trạng thái nhập liệu</label>
