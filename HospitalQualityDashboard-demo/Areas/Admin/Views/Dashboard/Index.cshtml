@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
function initializeDashboardAnalysis() {
    var tabs = document.querySelectorAll('[data-dashboard-tab]');
    var panes = document.querySelectorAll('[data-dashboard-pane]');
    var charts = [];

    function renderCharts(container) {
        var comparison = container.querySelector('.comparison-progress-chart');
        if (comparison && !comparison.dataset.rendered) {
            var metrics = JSON.parse(comparison.dataset.metrics || '[]');
            charts.push(new Chart(comparison, { type: 'bar', data: { labels: metrics.map(function(x){ return x.TenKyBaoCao; }), datasets: [
                { label: 'Đúng hạn', data: metrics.map(function(x){ return x.DungHan; }), backgroundColor: '#22a06b' },
                { label: 'Nộp trễ', data: metrics.map(function(x){ return x.NopTre; }), backgroundColor: '#e5484d' },
                { label: 'Chưa nộp', data: metrics.map(function(x){ return x.ChuaNop; }), backgroundColor: '#f0a202' },
                { label: 'Quá hạn chưa nộp', data: metrics.map(function(x){ return x.QuaHanChuaNop; }), backgroundColor: '#9f1239' }
            ]}, options: { responsive: true, maintainAspectRatio: false, scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true } }, plugins: { legend: { position: 'bottom' } } } }));
            comparison.dataset.rendered = 'true';
        }
        var trend = container.querySelector('.dashboard-trend-chart');
        if (trend && !trend.dataset.rendered) {
            var trendMetrics = JSON.parse(trend.dataset.metrics || '[]');
            charts.push(new Chart(trend, { type: 'line', data: { labels: trendMetrics.map(function(x){ return x.TenKyBaoCao; }), datasets: [
                { label: 'Tỷ lệ hoàn thành', data: trendMetrics.map(function(x){ return x.TyLeHoanThanh; }), borderColor: '#146c78', tension: .28 },
                { label: 'Tỷ lệ đúng hạn', data: trendMetrics.map(function(x){ return x.TyLeDungHan; }), borderColor: '#2563eb', tension: .28 },
                { label: 'Nộp trễ', data: trendMetrics.map(function(x){ return x.NopTre; }), borderColor: '#e5484d', tension: .28, yAxisID: 'count' },
                { label: 'Quá hạn chưa nộp', data: trendMetrics.map(function(x){ return x.QuaHanChuaNop; }), borderColor: '#f0a202', tension: .28, yAxisID: 'count' }
            ]}, options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, max: 100, title: { display: true, text: '%' } }, count: { beginAtZero: true, position: 'right', grid: { drawOnChartArea: false } } }, plugins: { legend: { position: 'bottom' } } } }));
            trend.dataset.rendered = 'true';
        }
    }

    function bindPane(pane) {
        var forms = pane.querySelectorAll('[data-dashboard-analysis-form], [data-dashboard-trend-form]');
        forms.forEach(function(form) {
            form.addEventListener('submit', function(event) { event.preventDefault(); loadPane(pane, new URLSearchParams(new FormData(form)).toString()); });
        });
        pane.querySelectorAll('[data-analysis-page]').forEach(function(button) {
            button.addEventListener('click', function() { var form = pane.querySelector('[data-dashboard-analysis-form]'); form.querySelector('[name=Page]').value = button.dataset.analysisPage; form.dispatchEvent(new Event('submit')); });
        });
        var picker = pane.querySelector('[data-period-picker]');
        if (picker) {
            var checkboxes = Array.from(picker.querySelectorAll('input[type=checkbox]'));
            picker.querySelectorAll('[data-period-preset]').forEach(function(button) { button.addEventListener('click', function(){ var limit = Number(button.dataset.periodPreset); checkboxes.filter(function(x){ return !x.closest('[hidden]'); }).forEach(function(x, i){ x.checked = i < limit; }); picker.querySelector('[data-period-summary]').textContent = checkboxes.filter(function(x){ return x.checked; }).length + ' kỳ đã chọn'; }); });
            checkboxes.forEach(function(box){ box.addEventListener('change', function(){ var selected = checkboxes.filter(function(x){ return x.checked; }); if (selected.length > 11) box.checked = false; picker.querySelector('[data-period-summary]').textContent = checkboxes.filter(function(x){ return x.checked; }).length + ' kỳ đã chọn'; }); });
        }
        renderCharts(pane);
    }

    function loadPane(pane, query) {
        pane.innerHTML = '<div class="analysis-loading"><span class="spinner-border spinner-border-sm"></span> Đang tải dữ liệu...</div>';
        fetch(pane.dataset.dashboardUrl + (query ? '?' + query : ''), { credentials: 'same-origin' }).then(function(response){ if (!response.ok) throw new Error(response.statusText); return response.text(); }).then(function(html){ pane.innerHTML = html; bindPane(pane); }).catch(function(){ pane.innerHTML = '<div class="alert alert-danger">Không thể tải dữ liệu. <button type="button" class="btn btn-sm btn-outline-danger" data-analysis-retry>Thử lại</button></div>'; pane.querySelector('[data-analysis-retry]').addEventListener('click', function(){ loadPane(pane, query); }); });
    }

    panes.forEach(function(pane) { if (!pane.hidden) bindPane(pane); });
    tabs.forEach(function(tab){ tab.addEventListener('click', function(){ var name = tab.dataset.dashboardTab; tabs.forEach(function(x){ x.classList.toggle('is-active', x === tab); }); panes.forEach(function(pane){ var active = pane.dataset.dashboardPane === name; pane.hidden = !active; pane.classList.toggle('is-active', active); if (active && name !== 'overview' && !pane.dataset.loaded) { pane.dataset.loaded = 'true'; loadPane(pane, window.location.search.replace(/^\?/, '')); } }); history.replaceState(null, '', '#'+name); }); });
    var requested = window.location.hash.replace('#', ''); var initial = document.querySelector('[data-dashboard-tab="'+requested+'"]'); if (initial) initial.click();
}

function initializeDashboardComparison() {
    var periods = window.dashboardComparisonPeriods || [];
    var primarySelect = document.getElementById('KyBaoCaoId');
    var toggle = document.getElementById('enable-dashboard-comparison');
    var panel = document.getElementById('dashboard-comparison-panel');
    var comparisonSelect = document.getElementById('dashboard-comparison-periods');
    var message = document.getElementById('dashboard-comparison-message');
    if (!primarySelect || !toggle || !panel || !comparisonSelect) return;

    function refreshPeriods() {
        var primary = periods.find(function(period) {
            return String(period.id) === primarySelect.value;
        });
        var eligible = primary
            ? periods.filter(function(period) {
                return period.frequency === primary.frequency && period.start < primary.start;
            })
            : [];

        comparisonSelect.innerHTML = '';
        eligible.forEach(function(period, index) {
            comparisonSelect.add(new Option(period.name, period.id, index === 0, index === 0));
        });

        toggle.disabled = !primary || eligible.length === 0;
        if (toggle.disabled) toggle.checked = false;
        panel.hidden = !toggle.checked;
        comparisonSelect.disabled = !toggle.checked;
        message.textContent = primary && eligible.length === 0
            ? 'Không có kỳ cũ hơn cùng tần suất để so sánh.'
            : '';
    }

    toggle.addEventListener('change', function() {
        panel.hidden = !toggle.checked;
        comparisonSelect.disabled = !toggle.checked;
        if (toggle.checked && comparisonSelect.options.length > 0 && comparisonSelect.selectedOptions.length === 0) {
            comparisonSelect.options[0].selected = true;
        }
    });
    comparisonSelect.addEventListener('change', function() {
        var selected = Array.from(comparisonSelect.selectedOptions);
        if (selected.length > 11) selected[selected.length - 1].selected = false;
    });
    primarySelect.addEventListener('change', refreshPeriods);
    refreshPeriods();
}

var labels = [@Html.Raw(string.Join(",", progressItems.Select(x => "\"" + HttpUtility.JavaScriptStringEncode(x.TenKhoaPhong) + "\"")))];
var values = [@string.Join(",", progressItems.Select(x => x.DaGui))];
var totals = [@string.Join(",", progressItems.Select(x => x.Tong))];
var chartElement = document.getElementById('progressChart');
window.dashboardComparisonPeriods = [
@foreach (var period in Model.ComparisonPeriods ?? new System.Collections.Generic.List<HospitalQualityDashboardDemo.Models.DTOs.DashboardComparisonPeriodDto>())
{
    <text>{ id: @period.KyBaoCaoId, name: "@Html.Raw(HttpUtility.JavaScriptStringEncode(period.TenKyBaoCao))", frequency: @period.TanSuat, start: "@period.TuNgay.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" },</text>
}
];

if (chartElement && labels.length) {
    new Chart(chartElement, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Đã gửi',
                    data: values,
                    backgroundColor: 'rgba(20, 108, 120, 0.82)',
                    borderColor: 'rgba(20, 108, 120, 1)',
                    borderWidth: 1,
                    borderRadius: 6
                },
                {
                    label: 'Tổng cần nộp',
                    data: totals,
                    backgroundColor: 'rgba(37, 99, 235, 0.18)',
                    borderColor: 'rgba(37, 99, 235, 0.52)',
                    borderWidth: 1,
                    borderRadius: 6
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        boxWidth: 12,
                        boxHeight: 12
                    }
                }
            },
            scales: {
                x: {
                    grid: {
                        display: false
                    },
                    ticks: {
                        maxRotation: 0,
                        autoSkip: true,
                        maxTicksLimit: 8
                    }
                },
                y: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0
                    }
                }
            }
        }
    });
}

var metricDetailModal = document.getElementById('dashboardMetricDetailModal');
if (metricDetailModal) {
    metricDetailModal.addEventListener('show.bs.modal', function(event) {
        var trigger = event.relatedTarget;
        var metric = trigger ? trigger.getAttribute('data-metric') : 'total';
        var title = trigger ? trigger.getAttribute('data-title') : 'Danh sách chỉ số cần nộp';
        var visibleCount = 0;

        metricDetailModal.querySelector('[data-metric-title]').textContent = title;
        metricDetailModal.querySelectorAll('tbody tr[data-metric-groups]').forEach(function(row) {
            var groups = (row.getAttribute('data-metric-groups') || '').split(' ');
            var visible = groups.indexOf(metric) >= 0;
            row.hidden = !visible;
            if (visible) visibleCount += 1;
        });

        metricDetailModal.querySelector('[data-metric-count]').textContent = visibleCount + ' dòng';
        metricDetailModal.querySelector('[data-metric-empty]').hidden = visibleCount !== 0;
    });
}

document.addEventListener('DOMContentLoaded', function() {
    initializeDashboardAnalysis();
    initializeDashboardComparison();
    var dbExportColumnCheckboxes = document.querySelectorAll('.dashboard-export-column');
    var dbExportSubmitBtn = document.getElementById('dashboard-export-submit');

    function updateDashboardExportSubmit() {
        if (!dbExportSubmitBtn) return;
        var selectedCount = Array.from(dbExportColumnCheckboxes).filter(cb => cb.checked).length;
        dbExportSubmitBtn.disabled = selectedCount === 0;
    }

    dbExportColumnCheckboxes.forEach(function(checkbox) {
        checkbox.addEventListener('change', updateDashboardExportSubmit);
    });

    var dbExportSelectAll = document.getElementById('dashboard-export-select-all');
    if (dbExportSelectAll) {
        dbExportSelectAll.addEventListener('click', function() {
            dbExportColumnCheckboxes.forEach(cb => cb.checked = true);
            updateDashboardExportSubmit();
        });
    }

    var dbExportClear = document.getElementById('dashboard-export-clear');
    if (dbExportClear) {
        dbExportClear.addEventListener('click', function() {
            dbExportColumnCheckboxes.forEach(cb => cb.checked = false);
            updateDashboardExportSubmit();
        });
    }

    updateDashboardExportSubmit();
});
    </script>
}
