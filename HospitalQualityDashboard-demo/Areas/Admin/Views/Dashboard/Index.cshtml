<section class="dashboard-hero hospital-hero">
    <div class="dashboard-titlebar">
        <span class="dashboard-role">@roleLabel</span>
        <h1>Trung tâm điều hành chất lượng</h1>
        <p>Theo dõi tiến độ nộp báo cáo, nhận diện chỉ số còn thiếu và kiểm soát rủi ro quá hạn theo khoa/phòng.</p>
    </div>
    <div class="dashboard-summary-strip" aria-label="Tóm tắt tiến độ">
        <div class="dashboard-summary-item summary-success">
            <span>Tỷ lệ hoàn tất</span>
            <strong>@completionRateText%</strong>
        </div>

        <div class="dashboard-summary-item summary-danger">
            <span>Cần xử lý</span>
            <strong>@urgentCount</strong>
        </div>

        <div class="dashboard-summary-item summary-info">
            <span>Khoa/phòng</span>
            <strong>@progressItems.Count</strong>
        </div>
    </div>
</section>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info dashboard-feedback" role="status">@TempData["Message"]</div>
}

@if (!Model.IsAdmin)
{
    <section class="missing-work-panel missing-report-alert">
        <div class="missing-work-summary">
            <div>
                <h2>Việc báo cáo cần xử lý</h2>
                @if (missingReports.Any())
                {
                    <p>Bạn có @missingReports.Count chỉ số chưa báo cáo trong các kỳ đang theo dõi.</p>
                    <div class="status-stack">
                        <span class="status-pill status-danger">@Model.OverdueMissingReportCount quá hạn</span>
                        <span class="status-pill status-warning">@Model.DueSoonReportCount sắp đến hạn</span>
                    </div>
                }
                else
                {
                    <p>Không có chỉ số quá hạn hoặc sắp đến hạn trong phạm vi phân công hiện tại.</p>
                }
            </div>
            @if (missingReports.Any())
            {
                <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#missingReportDetails" aria-expanded="false" aria-controls="missingReportDetails">
                    Xem danh sách
                </button>
            }
        </div>
        @if (missingReports.Any())
        {
            <div class="collapse missing-work-detail" id="missingReportDetails">
                <div class="table-responsive mt-3">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Kỳ báo cáo</th>
                                <th>Hạn nộp</th>
                                <th>Chỉ số</th>
                                <th>Trạng thái</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in missingReports)
                            {
                                <tr>
                                    <td>@item.TenKyBaoCao</td>
                                    <td>@item.HanNop.ToString("dd/MM/yyyy") 23:59</td>
                                    <td><strong>@item.MaChiSo</strong> - @item.TenChiSo</td>
                                    <td>
                                        @if (item.IsOverdue)
                                        {
                                            <span class="status-pill status-danger">Quá hạn @Math.Abs(item.DaysUntilDue) ngày</span>
                                        }
                                        else if (item.IsDueSoon)
                                        {
                                            <span class="status-pill status-warning">Còn @item.DaysUntilDue ngày</span>
                                        }
                                        else
                                        {
                                            <span class="status-pill status-muted">Chưa gửi</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @Html.ActionLink("Nhập báo cáo", "Edit", "Report", new { kyBaoCaoId = item.KyBaoCaoId, chiSoChatLuongId = item.ChiSoChatLuongId }, new { @class = "btn btn-sm btn-primary" })
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>
}

<section class="metric-grid" aria-label="Chỉ số tổng quan">
    <button type="button" class="metric-card metric-card-button is-accent" data-bs-toggle="modal" data-bs-target="#dashboardMetricDetailModal" data-metric="total" data-title="Danh sách chỉ số cần nộp">
