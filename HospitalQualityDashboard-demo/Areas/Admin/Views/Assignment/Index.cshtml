@* Mục đích: màn hình quản lý phân công chỉ số và các chế độ lọc/xem. *@
@model HospitalQualityDashboardDemo.Models.ViewModels.AssignmentViewModel
@{
    ViewBag.Title = "Phân công chỉ số";
}

<style>
    /* Ép nền xám nhạt cho toàn bộ trang để tách biệt với các Card màu trắng */
    .assignment-page {
        background-color: #f4f7fa;
        min-height: 100vh;
        padding: 24px;
        border-radius: 16px;
    }

    /* Custom CSS cho Card */
    .card-custom {
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    }

    .metric-card-new {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        box-shadow: 0 4px 10px rgba(0,0,0,0.02);
        transition: transform 0.2s;
    }

        .metric-card-new:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.06);
        }

    .metric-icon-box {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .metric-tag {
        font-size: 0.65rem;
        font-weight: 800;
        padding: 4px 10px;
        border-radius: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-dark-blue {
        background-color: #0b3d91;
        color: white;
        border: none;
        font-weight: 700;
    }

        .btn-dark-blue:hover {
            background-color: #082d6b;
            color: white;
        }

    /* Ô tìm kiếm và bộ lọc */
    .search-pill {
        border-radius: 24px;
        background-color: #f8fafc;
        border: 1px solid #cbd5e1;
        font-size: 0.9rem;
    }

        .search-pill:focus {
            background-color: #fff;
            border-color: #0b3d91;
            box-shadow: 0 0 0 3px rgba(11,61,145,0.1);
        }

    /* Khung danh sách chọn (Khoa/phòng & Chỉ số) */
    .selection-list-box {
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
    }

    .list-item-hover {
        border: 1px solid transparent;
        border-radius: 12px;
        transition: all 0.2s;
    }

        .list-item-hover:hover {
            background-color: #f1f5f9;
            border-color: #e2e8f0;
        }

    /* Tab chuyển đổi chế độ xem */
    .view-toggle-container {
        background-color: #f1f5f9;
        border-radius: 12px;
        padding: 4px;
        display: inline-flex;
    }

        .view-toggle-container .btn {
            border-radius: 8px;
            font-weight: 600;
            color: #64748b;
            border: none;
            padding: 6px 16px;
            font-size: 0.9rem;
        }

            .view-toggle-container .btn.active {
                background-color: #fff;
                color: #0b3d91;
                box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            }
</style>

<div class="app-responsive-page assignment-page p-4">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <div>
            <h1 class="h3 mb-1 text-dark fw-bold">Phân công chỉ số</h1>
        </div>
        <div class="mobile-stack-actions assignment-header-actions">
            <button type="button" class="btn btn-light border px-4 rounded-pill fw-semibold text-dark" data-bs-toggle="modal" data-bs-target="#assignmentExportModal">
                <i class="bi bi-download me-1"></i> Xuất Excel
            </button>
            @using (Html.BeginForm("SyncFromIndicators", "Assignment", new { viewMode = Model.ViewMode }, FormMethod.Post, new { @class = "d-inline" }))
            {
                @Html.AntiForgeryToken()
                <button class="btn btn-light border px-4 rounded-pill fw-semibold text-dark" type="submit">
                    <i class="bi bi-arrow-repeat me-1"></i> Đồng bộ
                </button>
            }
        </div>
    </div>

    @* Thông báo thành công/lỗi (giữ nguyên logic) *@
    @if (TempData["Success"] != null)
    {<div class="alert alert-success rounded-3 mb-4">@TempData["Success"]</div>}
    @if (TempData["Error"] != null)
    {<div class="alert alert-danger rounded-3 mb-4">@TempData["Error"]</div>}

<div class="row g-3 mb-5">
    <div class="col">
        <div class="card metric-card-new h-100 summary-info">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <span class="text-muted small fw-bold text-uppercase">Tổng chỉ số</span>
                    <div class="metric-icon-box bg-white bg-opacity-50 text-primary"><i class="bi bi-layout-text-window"></i></div>
                </div>
                <h2 class="fw-bold mb-3 text-dark">@Model.TongChiSo</h2>
                <div><span class="metric-tag bg-white bg-opacity-50 text-secondary">■ TOÀN BỆNH VIỆN</span></div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card metric-card-new h-100 summary-success">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <span class="text-muted small fw-bold text-uppercase">Đã phân công</span>
                    <div class="metric-icon-box bg-white bg-opacity-50 text-success"><i class="bi bi-check-circle"></i></div>
                </div>
                <h2 class="fw-bold mb-3 text-dark">@Model.SoChiSoDaPhanCong</h2>
                <div><span class="metric-tag bg-white bg-opacity-50 text-success">+12% THÁNG NÀY</span></div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card metric-card-new h-100 summary-danger">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <span class="text-muted small fw-bold text-uppercase">Chưa phân công</span>
                    <div class="metric-icon-box bg-white bg-opacity-50 text-danger"><i class="bi bi-exclamation-triangle"></i></div>
                </div>
                <h2 class="fw-bold mb-3 text-danger">@Model.SoChiSoChuaPhanCong</h2>
                <div><span class="metric-tag bg-white bg-opacity-50 text-danger">CẦN XỬ LÝ NGAY</span></div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card metric-card-new h-100 summary-info">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <span class="text-muted small fw-bold text-uppercase">Tổng phân công</span>
                    <div class="metric-icon-box bg-white bg-opacity-50 text-primary"><i class="bi bi-diagram-3"></i></div>
                </div>
                <h2 class="fw-bold mb-3 text-dark">@Model.TongPhanCong</h2>
                <div><span class="metric-tag bg-white bg-opacity-50 text-primary">LƯỢT PHỐI HỢP</span></div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card metric-card-new h-100 summary-warning">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <span class="text-muted small fw-bold text-uppercase">Tạm dừng</span>
                    <div class="metric-icon-box bg-white bg-opacity-50 text-warning"><i class="bi bi-pause"></i></div>
                </div>
                <h2 class="fw-bold mb-3 text-dark">@Model.SoTamDung</h2>
                <div><span class="metric-tag bg-white bg-opacity-50 text-warning">HOẠT ĐỘNG ỔN ĐỊNH</span></div>
            </div>
        </div>
    </div>
</div>

    <div class="card card-custom mb-4">
        <div class="card-header bg-transparent border-0 py-4 px-4 d-flex justify-content-between align-items-center cursor-pointer" data-bs-toggle="collapse" data-bs-target="#createAssignmentForm">
            <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-check-circle-fill text-primary bg-primary bg-opacity-10 rounded-circle p-2 me-2"></i> Tạo phân công giao việc mới</h5>
            <i class="bi bi-chevron-down text-muted fs-5"></i>
        </div>
        <div class="collapse show" id="createAssignmentForm">
            <div class="card-body px-4 pb-4 pt-2">
                @using (Html.BeginForm("Assign", "Assignment", FormMethod.Post, new { id = "assignmentForm" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ViewMode)

                    <div class="row g-4">
                        <div class="col-lg-6">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-building text-primary me-2"></i> Khoa / Phòng <span class="badge bg-light text-primary border rounded-pill ms-2" id="count-kp">Đã chọn 0</span></h6>
                                <div class="small fw-bold" style="font-size: 0.75rem;">
                                    <a href="#" class="text-primary text-decoration-none me-3" id="select-all-kp">CHỌN TẤT CẢ</a>
                                    <a href="#" class="text-muted text-decoration-none" id="clear-all-kp">BỎ CHỌN</a>
                                </div>
                            </div>
                            <div class="position-relative mb-3">
                                <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                <input type="text" id="search-khoaphong" class="form-control search-pill ps-5 py-2.5" placeholder="Tìm khoa/phòng theo tên..." />
                            </div>
                            <div class="selection-list-box p-3 scroll-bar" style="height: 260px; overflow-y: auto;">
                                <div id="list-khoaphong">
                                    @for (int i = 0; i < Model.KhoaPhongOptions.Count; i++)
                                    {
                                        <div class="form-check py-2 px-3 mb-1 list-item-hover item-khoaphong" data-name="@Model.KhoaPhongOptions[i].Text.ToLower()">
                                            <input class="form-check-input cursor-pointer kp-checkbox" type="checkbox" name="SelectedKhoaPhongIds" value="@Model.KhoaPhongOptions[i].Value" id="kp_@Model.KhoaPhongOptions[i].Value" />
                                            <label class="form-check-label fw-semibold text-dark cursor-pointer user-select-none ms-2 d-block w-100" for="kp_@Model.KhoaPhongOptions[i].Value">
                                                @Model.KhoaPhongOptions[i].Text
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-graph-up-arrow text-primary me-2"></i> Chỉ số chất lượng <span class="badge bg-light text-primary border rounded-pill ms-2" id="count-cs">Đã chọn 0</span></h6>
                                <div class="small fw-bold" style="font-size: 0.75rem;">
                                    <a href="#" class="text-primary text-decoration-none me-3" id="select-all-cs">CHỌN TẤT CẢ</a>
                                    <a href="#" class="text-muted text-decoration-none" id="clear-all-cs">BỎ CHỌN</a>
                                </div>
                            </div>
                            <div class="position-relative mb-3">
                                <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                <input type="text" id="search-chiso" class="form-control search-pill ps-5 py-2.5" placeholder="Tìm theo mã hoặc tên chỉ số..." />
                            </div>
                            <div class="selection-list-box p-3 scroll-bar" style="height: 260px; overflow-y: auto;">
                                <div id="list-chiso">
                                    @for (int i = 0; i < Model.ChiSoOptions.Count; i++)
                                    {
                                        <div class="form-check py-2 px-3 mb-1 list-item-hover item-chiso" data-name="@Model.ChiSoOptions[i].Text.ToLower()">
                                            <input class="form-check-input cursor-pointer cs-checkbox" type="checkbox" name="SelectedChiSoIds" value="@Model.ChiSoOptions[i].Value" id="cs_@Model.ChiSoOptions[i].Value" />
                                            <label class="form-check-label fw-semibold text-dark cursor-pointer user-select-none ms-2 d-block w-100" for="cs_@Model.ChiSoOptions[i].Value">
                                                @Model.ChiSoOptions[i].Text
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="text-end mt-4 pt-2">
                        <button class="btn btn-dark-blue px-5 py-2.5 rounded-pill fw-bold shadow-sm" type="submit" id="submitBtn" disabled>
                            <i class="bi bi-check2-square me-2"></i> Xác nhận phân công
                        </button>
                    </div>

                    <div class="d-none" id="previewPanel">
                        <tbody id="previewList"></tbody>
                        <div id="previewCount"></div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card card-custom mb-4">
        <div class="card-header bg-transparent border-bottom py-4 px-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-layout-text-window text-secondary me-2"></i> Phân công hiện tại</h5>

            <div class="view-toggle-container assignment-view-switch">
                <button type="button" class="btn view-mode-btn @(Model.ViewMode == "byIndicator" ? "active" : "")" data-mode="byIndicator">
                    <i class="bi bi-list-ul me-1"></i> Theo chỉ số
                </button>
                <button type="button" class="btn view-mode-btn @(Model.ViewMode == "byDepartment" ? "active" : "")" data-mode="byDepartment">
                    <i class="bi bi-building me-1"></i> Theo khoa/phòng
                </button>
                <button type="button" class="btn view-mode-btn @(Model.ViewMode == "table" ? "active" : "")" data-mode="table">
                    <i class="bi bi-table me-1"></i> Bảng tổng hợp
                </button>
            </div>
        </div>

        <div class="card-body px-4 py-4 border-bottom bg-transparent">
            @using (Html.BeginForm("Index", "Assignment", FormMethod.Get, new { id = "filterForm", @class = "assignment-filter-form" }))
            {
                <input type="hidden" name="viewMode" id="filterViewMode" value="@Model.ViewMode" />
                <div class="row g-3 align-items-end">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label text-muted small fw-bold text-uppercase mb-2" style="font-size: 0.75rem;">Tìm kiếm</label>
                        <div class="position-relative">
                            <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                            <input type="text" name="search" class="form-control search-pill ps-5 py-2" placeholder="Tên khoa, mã/tên chỉ số..." value="@Model.Search" />
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="form-label text-muted small fw-bold text-uppercase mb-2" style="font-size: 0.75rem;">Khoa / Phòng</label>
                        @Html.DropDownList("khoaPhongId", new SelectList(Model.KhoaPhongOptions, "Value", "Text", Model.FilterKhoaPhongId), "Tất cả khoa/phòng", new { @class = "form-select search-pill py-2" })
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="form-label text-muted small fw-bold text-uppercase mb-2" style="font-size: 0.75rem;">Trạng thái</label>
                        <select name="trangThai" class="form-select search-pill py-2">
                            <option value="" @(string.IsNullOrEmpty(Model.FilterTrangThai) ? "selected" : "")>Tất cả trạng thái</option>
                            <option value="active" @(Model.FilterTrangThai == "active" ? "selected" : "")>Đang hoạt động</option>
                            <option value="inactive" @(Model.FilterTrangThai == "inactive" ? "selected" : "")>Đang tạm dừng</option>
                        </select>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label text-muted small fw-bold text-uppercase mb-2" style="font-size: 0.75rem;">Loại chỉ số</label>
                        <select name="trangThaiPhanCong" class="form-select search-pill py-2">
                            <option value="all" @(Model.FilterTrangThaiPhanCong == "all" || string.IsNullOrEmpty(Model.FilterTrangThaiPhanCong) ? "selected" : "")>Tất cả loại chỉ số</option>
                            <option value="assigned" @(Model.FilterTrangThaiPhanCong == "assigned" ? "selected" : "")>Đã phân công</option>
                            <option value="unassigned" @(Model.FilterTrangThaiPhanCong == "unassigned" ? "selected" : "")>Chưa phân công</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-12 text-end">
                        <button class="btn btn-dark-blue px-4 py-2 rounded-pill fw-bold" type="submit"><i class="bi bi-funnel-fill me-1"></i> Lọc</button>
                        <a href="@Url.Action("Index", new { viewMode = Model.ViewMode })" class="btn btn-light border px-3 py-2 rounded-pill ms-2 text-muted"><i class="bi bi-arrow-counterclockwise"></i></a>
                    </div>
                </div>
            }
        </div>

        <div class="card-body bg-transparent p-4">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom py-4 px-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-layout-text-window text-secondary me-2"></i> Phân công hiện tại</h5>

                    <div class="view-toggle-container assignment-view-switch">
                        <button type="button" class="btn view-mode-btn @(Model.ViewMode == "byIndicator" ? "active" : "")" data-mode="byIndicator">
                            <i class="bi bi-list-ul me-1"></i> Theo chỉ số
                        </button>
                        <button type="button" class="btn view-mode-btn @(Model.ViewMode == "byDepartment" ? "active" : "")" data-mode="byDepartment">
                            <i class="bi bi-building me-1"></i> Theo khoa/phòng
                        </button>
                        <button type="button" class="btn view-mode-btn @(Model.ViewMode == "table" ? "active" : "")" data-mode="table">
                            <i class="bi bi-table me-1"></i> Bảng tổng hợp
                        </button>
                    </div>
                </div>

                <div class="card-body px-4 py-3 border-bottom bg-white">
                    @using (Html.BeginForm("Index", "Assignment", FormMethod.Get, new { id = "filterForm", @class = "assignment-filter-form" }))
                    {
                        <input type="hidden" name="viewMode" id="filterViewMode" value="@Model.ViewMode" />
                        <div class="row g-3 align-items-end">
                            <div class="col-lg-3 col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase mb-2">Tìm kiếm</label>
                                <div class="position-relative">
                                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                    <input type="text" name="search" class="form-control search-pill ps-5" placeholder="Tên khoa, mã/tên chỉ số..." value="@Model.Search" />
                                </div>
                            </div>
                            <div class="col-lg-2 col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase mb-2">Khoa / Phòng</label>
                                @Html.DropDownList("khoaPhongId", new SelectList(Model.KhoaPhongOptions, "Value", "Text", Model.FilterKhoaPhongId), "Tất cả khoa/phòng", new { @class = "form-select search-pill" })
                            </div>
                            <div class="col-lg-2 col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase mb-2">Trạng thái</label>
                                <select name="trangThai" class="form-select search-pill">
                                    <option value="" @(string.IsNullOrEmpty(Model.FilterTrangThai) ? "selected" : "")>Tất cả trạng thái</option>
                                    <option value="active" @(Model.FilterTrangThai == "active" ? "selected" : "")>Đang hoạt động</option>
                                    <option value="inactive" @(Model.FilterTrangThai == "inactive" ? "selected" : "")>Đang tạm dừng</option>
                                </select>
                            </div>
                            <div class="col-lg-2 col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase mb-2">Loại chỉ số</label>
                                <select name="trangThaiPhanCong" class="form-select search-pill">
                                    <option value="all" @(Model.FilterTrangThaiPhanCong == "all" || string.IsNullOrEmpty(Model.FilterTrangThaiPhanCong) ? "selected" : "")>Tất cả loại chỉ số</option>
                                    <option value="assigned" @(Model.FilterTrangThaiPhanCong == "assigned" ? "selected" : "")>Đã phân công</option>
                                    <option value="unassigned" @(Model.FilterTrangThaiPhanCong == "unassigned" ? "selected" : "")>Chưa phân công</option>
                                </select>
                            </div>
                            <div class="col-lg col-md-12 text-end">
                                <button class="btn btn-dark-blue px-4 rounded-pill fw-bold" type="submit"><i class="bi bi-funnel-fill me-1"></i> Lọc</button>
                                <a href="@Url.Action("Index", new { viewMode = Model.ViewMode })" class="btn btn-light border px-3 rounded-pill ms-2"><i class="bi bi-funnel"></i></a>
                            </div>
                        </div>
                    }
                </div>

                <div class="card-body bg-light p-4">
                    @if (Model.ViewMode == "byDepartment")
                    {
                        @Html.Partial("_DepartmentView", Model)
                    }
                    else if (Model.ViewMode == "byIndicator")
                    {
                        @Html.Partial("_IndicatorView", Model)
                    }
                    else
                    {
                        @Html.Partial("_TableView", Model)
                    }
                </div>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="d-flex justify-content-center mt-4">
                    <ul class="pagination pagination-sm shadow-sm rounded-pill p-1 bg-white border">
                        @if (Model.CurrentPage > 1)
                        {
                            <li class="page-item"><a class="page-link rounded-circle border-0 text-primary px-3" href="@Url.Action("Index", new { page = 1, viewMode = Model.ViewMode, khoaPhongId = Model.FilterKhoaPhongId, chiSoId = Model.FilterChiSoId, trangThai = Model.FilterTrangThai, trangThaiPhanCong = Model.FilterTrangThaiPhanCong, search = Model.Search })">«</a></li>
                            <li class="page-item"><a class="page-link rounded-circle border-0 text-primary px-3" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, viewMode = Model.ViewMode, khoaPhongId = Model.FilterKhoaPhongId, chiSoId = Model.FilterChiSoId, trangThai = Model.FilterTrangThai, trangThaiPhanCong = Model.FilterTrangThaiPhanCong, search = Model.Search })">‹</a></li>
                        }
                        else
                        {
                            <li class="page-item disabled"><span class="page-link rounded-circle border-0 px-3">«</span></li>
                            <li class="page-item disabled"><span class="page-link rounded-circle border-0 px-3">‹</span></li>
                        }

                        <li class="page-item active"><span class="page-link rounded-pill border-0 px-3 btn-dark-blue text-white">Trang @Model.CurrentPage / @Model.TotalPages</span></li>

                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <li class="page-item"><a class="page-link rounded-circle border-0 text-primary px-3" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, viewMode = Model.ViewMode, khoaPhongId = Model.FilterKhoaPhongId, chiSoId = Model.FilterChiSoId, trangThai = Model.FilterTrangThai, trangThaiPhanCong = Model.FilterTrangThaiPhanCong, search = Model.Search })">›</a></li>
                            <li class="page-item"><a class="page-link rounded-circle border-0 text-primary px-3" href="@Url.Action("Index", new { page = Model.TotalPages, viewMode = Model.ViewMode, khoaPhongId = Model.FilterKhoaPhongId, chiSoId = Model.FilterChiSoId, trangThai = Model.FilterTrangThai, trangThaiPhanCong = Model.FilterTrangThaiPhanCong, search = Model.Search })">»</a></li>
                        }
                        else
                        {
                            <li class="page-item disabled"><span class="page-link rounded-circle border-0 px-3">›</span></li>
                            <li class="page-item disabled"><span class="page-link rounded-circle border-0 px-3">»</span></li>
                        }
                    </ul>
                </nav>
            }
        </div>

        @* Các phần Modal Export, Thanh Bulk Action và Script bên dưới bạn giữ nguyên code cũ của bạn nhé! *@
