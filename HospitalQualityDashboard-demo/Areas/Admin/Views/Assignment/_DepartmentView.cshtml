@* Mục đích: partial view nhóm phân công theo khoa/phòng. *@
@model HospitalQualityDashboardDemo.Models.ViewModels.AssignmentViewModel

<div class="row g-4 assignment-group-list">
    @if (Model.DepartmentGroups == null || Model.DepartmentGroups.Count == 0)
    {
        <div class="col-12 text-center py-5 text-muted">
            <i class="bi bi-building fs-2 d-block mb-2"></i>
            Không tìm thấy khoa/phòng nào phù hợp.
        </div>
    }
    else
    {
        foreach (var group in Model.DepartmentGroups)
        {
            <div class="col-12">
                <div class="card border border-light-subtle rounded-3 overflow-hidden shadow-sm">
                    <div class="card-header bg-light border-0 d-flex justify-content-between align-items-center py-3 px-4 cursor-pointer" 
                         data-bs-toggle="collapse" data-bs-target="#dept-collapse-@group.KhoaPhongId" aria-expanded="true">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-building fs-5 text-primary"></i>
                            <h5 class="mb-0 fw-bold text-dark">@group.TenKhoaPhong</h5>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill small">@group.SoChiSoHoatDong hoạt động</span>
                            @if (group.SoChiSoTamDung > 0)
                            {
                                <span class="badge bg-warning-subtle text-warning px-2 py-1 rounded-pill small">@group.SoChiSoTamDung tạm dừng</span>
                            }
                            <i class="bi bi-chevron-down text-muted transition-transform"></i>
                        </div>
                    </div>
                    <div class="collapse show" id="dept-collapse-@group.KhoaPhongId">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0 assignment-table">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-4" style="width: 40px;"></th>
                                            <th>Mã chỉ số</th>
                                            <th>Tên chỉ số</th>
                                            <th>Tần suất</th>
                                            <th>Công thức</th>
                                            <th class="text-center">Trạng thái</th>
                                            <th class="pe-4 text-end">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @if (group.Items == null || group.Items.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-4 text-muted small">
                                                Khoa/phòng này chưa được phân công chỉ số nào.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var item in group.Items)
                                        {
                                            <tr class="assignment-row" data-id="@item.PhanCongChiSoId">
                                                <td class="ps-4">
                                                    <input class="form-check-input cursor-pointer bulk-checkbox" type="checkbox" value="@item.PhanCongChiSoId" />
                                                </td>
                                                <td class="font-monospace fw-semibold">@item.MaChiSo</td>
                                                <td class="text-secondary">@item.TenChiSo</td>
                                                <td><span class="badge bg-info-subtle text-info px-2 py-1 rounded-pill small">@item.TanSuatBaoCaoText</span></td>
                                                <td><span class="text-muted small">@item.LoaiCongThucText</span></td>
                                                <td class="text-center">
                                                    @if (item.DangHoatDong)
                                                    {
                                                        <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill small">Hoạt động</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning-subtle text-warning px-2 py-1 rounded-pill small">Tạm dừng</span>
                                                    }
                                                </td>
                                                <td class="pe-4 text-end">
                                                    <div class="d-flex gap-2 justify-content-end assignment-row-actions">
                                                        @if (item.DangHoatDong)
                                                        {
                                                            using (Html.BeginForm("Deactivate", "Assignment", new { id = item.PhanCongChiSoId, viewMode = Model.ViewMode, khoaPhongId = Model.FilterKhoaPhongId, chiSoId = Model.FilterChiSoId, trangThai = Model.FilterTrangThai, search = Model.Search, page = Model.CurrentPage }, FormMethod.Post, new System.Collections.Generic.Dictionary<string, object> { { "class", "d-inline" } }))
                                                            {
                                                                 @Html.AntiForgeryToken()
                                                                 <button class="btn btn-sm btn-outline-warning rounded-pill px-3" type="submit">Tạm dừng</button>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            using (Html.BeginForm("Activate", "Assignment", new { id = item.PhanCongChiSoId, viewMode = Model.ViewMode, khoaPhongId = Model.FilterKhoaPhongId, chiSoId = Model.FilterChiSoId, trangThai = Model.FilterTrangThai, search = Model.Search, page = Model.CurrentPage }, FormMethod.Post, new System.Collections.Generic.Dictionary<string, object> { { "class", "d-inline" } }))
                                                            {
                                                                 @Html.AntiForgeryToken()
                                                                 <button class="btn btn-sm btn-outline-success rounded-pill px-3" type="submit">Kích hoạt</button>
                                                            }
                                                        }
                                                        @using (Html.BeginForm("Delete", "Assignment", new { id = item.PhanCongChiSoId, viewMode = Model.ViewMode, khoaPhongId = Model.FilterKhoaPhongId, chiSoId = Model.FilterChiSoId, trangThai = Model.FilterTrangThai, search = Model.Search, page = Model.CurrentPage }, FormMethod.Post, new System.Collections.Generic.Dictionary<string, object> { { "class", "d-inline" } }))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" type="submit" onclick="return confirm('Bạn có chắc chắn muốn xóa phân công này không?')">Xóa</button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
