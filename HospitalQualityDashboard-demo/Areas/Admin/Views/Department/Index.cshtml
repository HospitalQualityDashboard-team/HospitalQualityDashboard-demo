@* Mục đích: danh sách khoa/phòng, tìm kiếm, import và thao tác khóa/mở khóa. *@
@model HospitalQualityDashboardDemo.Models.ViewModels.KhoaPhongIndexViewModel
@using System.Linq
@{
    ViewBag.Title = "Khoa/phòng";
    var items = (Model.Items ?? new System.Collections.Generic.List<HospitalQualityDashboardDemo.Models.ViewModels.KhoaPhongViewModel>()).ToList();
}

<section class="management-page">
    <div class="page-header">
        <div>
            <span class="dashboard-role">Danh mục tổ chức</span>
            <h1>Khoa/phòng</h1>
            <p>Quản lý danh mục khoa, phòng và trạng thái sử dụng trong hệ thống báo cáo chất lượng.</p>
        </div>
        <div class="management-toolbar">
            @Html.ActionLink("Thêm khoa/phòng", "Create", null, new { @class = "btn btn-primary" })
            @Html.ActionLink("Xuất Excel", "Departments", "Export", null, new { @class = "btn btn-outline-secondary" })
        </div>
    </div>

    <section class="filter-panel">
        @using (Html.BeginForm("Index", "Department", FormMethod.Get, new { @class = "filter-form management-filter-form" }))
        {
            <div class="filter-field">
                <label for="Search">Tìm kiếm</label>
                @Html.TextBoxFor(m => m.Search, new { @class = "form-control", placeholder = "Tìm tên hoặc mã khoa/phòng" })
            </div>
            <div class="filter-actions">
                <button class="btn btn-outline-primary" type="submit">Lọc</button>
            </div>
        }
    </section>

    <section class="import-panel">
        <div>
            <h2 class="import-panel-title">Import danh mục khoa/phòng</h2>
            <div class="import-panel-note">Nhận dữ liệu từ file danh mục chuẩn để cập nhật nhanh nhiều khoa/phòng.</div>
        </div>
        @using (Html.BeginForm("Import", "Department", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <div class="input-group">
                <input type="file" name="File" class="form-control" />
                <button class="btn btn-outline-primary" type="submit">Import</button>
            </div>
        }
    </section>

    @if (Model.ImportResult != null)
    {
        <div class="alert alert-info">Thành công: @Model.ImportResult.SoDongThanhCong, lỗi: @Model.ImportResult.SoDongLoi</div>
        foreach (var error in Model.ImportResult.Errors)
        {
            <div class="text-danger">@error</div>
        }
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <section class="data-panel">
        <div class="panel-header">
            <div>
                <h2>Danh sách khoa/phòng</h2>
                <p>@items.Count khoa/phòng trong bộ lọc hiện tại.</p>
            </div>
            <span class="status-pill status-muted">@items.Count dòng</span>
        </div>

        @if (items.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle data-table">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Mã khoa/phòng</th>
                            <th>Tên khoa/phòng</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @{ var stt = 1; }
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@stt</td>
                            <td>@item.IdKhoaPhongNguon</td>
                            <td><strong>@item.TenKhoaPhong</strong></td>
                            <td><span class="status-pill @(item.Used ? "status-active" : "status-muted")">@(item.Used ? "Đang dùng" : "Đã khóa")</span></td>
                            <td class="text-end table-actions">
                                @Html.ActionLink("Sửa", "Edit", new { id = item.KhoaPhongId }, new { @class = "btn btn-sm btn-outline-primary" })
                                @using (Html.BeginForm(item.Used ? "Lock" : "Unlock", "Department", new { id = item.KhoaPhongId }, FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-warning" type="submit">@(item.Used ? "Khóa" : "Mở khóa")</button>
                                }
                                @using (Html.BeginForm("Delete", "Department", new { id = item.KhoaPhongId }, FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Xóa khoa/phòng này?')">Xóa</button>
                                }
                            </td>
                        @{ stt++; }
                    </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">Chưa có khoa/phòng phù hợp với bộ lọc hiện tại.</div>
        }
    </section>
</section>
