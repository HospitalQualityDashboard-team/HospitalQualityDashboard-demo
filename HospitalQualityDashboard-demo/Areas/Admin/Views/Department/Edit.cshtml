@* Mục đích: form thêm mới hoặc cập nhật khoa/phòng. *@
@model HospitalQualityDashboardDemo.Models.ViewModels.KhoaPhongViewModel
@{
    ViewBag.Title = Model.KhoaPhongId == 0 ? "Thêm khoa/phòng" : "Sửa khoa/phòng";
}

<h2>@ViewBag.Title</h2>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.KhoaPhongId)
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="mb-3">@Html.LabelFor(m => m.IdKhoaPhongNguon, new { @class = "form-label" }) @Html.TextBoxFor(m => m.IdKhoaPhongNguon, new { @class = "form-control" })</div>
    <div class="mb-3">@Html.LabelFor(m => m.TenKhoaPhong, new { @class = "form-label" }) @Html.TextBoxFor(m => m.TenKhoaPhong, new { @class = "form-control" })</div>
    <div class="mb-3">@Html.LabelFor(m => m.GhiChu, new { @class = "form-label" }) @Html.TextAreaFor(m => m.GhiChu, new { @class = "form-control", rows = 3 })</div>
    <div class="form-check mb-3">@Html.CheckBoxFor(m => m.Used, new { @class = "form-check-input" }) @Html.LabelFor(m => m.Used, "Đang sử dụng", new { @class = "form-check-label" })</div>
    <button class="btn btn-primary" type="submit">Lưu</button>
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-outline-secondary" })
}
