@* Mục đích: form tạo tài khoản đăng nhập cho nhân viên. *@
@model HospitalQualityDashboardDemo.Models.ViewModels.CreateUserAccountViewModel
@{
    @* Tiêu đề màn hình tạo tài khoản cho nhân viên. *@
    ViewBag.Title = "Tạo tài khoản User";
}

@* Canh giữa form tạo tài khoản trên trang. *@
<div class="app-responsive-page auth-page employee-account-page">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <!-- Nút quay lại danh sách -->
            @* Nút quay lại danh sách nhân viên. *@
            <div class="mb-4">
                <a href="@Url.Action("Index")" class="text-decoration-none text-muted d-inline-flex align-items-center fw-medium hover-translate">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left me-2" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
                    </svg>
                    Quay lại danh sách nhân viên
                </a>
            </div>

            <!-- Card chính -->
            @* Card chính chứa thông tin nhân viên và form tài khoản. *@
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white py-4 px-4 border-0">
                    <h4 class="mb-1 fw-bold">Tạo tài khoản User</h4>
                    <p class="text-white-50 mb-0 small">Cấp tài khoản cho nhân viên <strong>@Model.HoTen</strong></p>
                </div>
                <div class="card-body p-4 bg-light bg-gradient">
                    @using (Html.BeginForm())
                    {
                        @* Bảo vệ form khỏi request giả mạo CSRF. *@
                        @Html.AntiForgeryToken()
                        @* Giữ lại id và họ tên nhân viên khi submit form. *@
                        @Html.HiddenFor(m => m.NhanVienId)
                        @Html.HiddenFor(m => m.HoTen)

                        <!-- Model-level Errors (e.g. trùng tên đăng nhập, nhân viên đã có tài khoản) -->
                        @* Hiển thị lỗi chung của form như trùng tài khoản hoặc nhân viên đã có tài khoản. *@
                        if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty) && ViewData.ModelState[string.Empty].Errors.Count > 0)
                        {
                            <div class="alert alert-danger shadow-sm border-0 mb-4 rounded-3 d-flex align-items-center" role="alert">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-exclamation-triangle-fill me-2 flex-shrink-0" viewBox="0 0 16 16">
                                    <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                                </svg>
                                <div>
                                    @Html.ValidationSummary(true, "")
                                </div>
                            </div>
                        }

                        <!-- Tên đăng nhập -->
                        @* Trường tên đăng nhập của tài khoản mới. *@
                        <div class="mb-4">
                            @Html.LabelFor(m => m.TenDangNhap, new { @class = "form-label fw-semibold text-secondary small text-uppercase tracking-wider" })
                            <div class="input-group shadow-sm rounded-3 overflow-hidden">
                                <span class="input-group-text bg-white border-end-0 border-light-subtle text-muted">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-fill" viewBox="0 0 16 16">
                                        <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
                                    </svg>
                                </span>
                                @Html.TextBoxFor(m => m.TenDangNhap, new { @class = "form-control border-start-0 border-light-subtle ps-1 py-2", placeholder = "Nhập tên đăng nhập...", autocomplete = "off" })
                            </div>
                            @Html.ValidationMessageFor(m => m.TenDangNhap, "", new { @class = "text-danger small mt-1 d-block fw-medium" })
                        </div>

                        <!-- Mật khẩu -->
                        @* Trường mật khẩu, sẽ được hash ở service trước khi lưu. *@
                        <div class="mb-4">
                            @Html.LabelFor(m => m.MatKhau, new { @class = "form-label fw-semibold text-secondary small text-uppercase tracking-wider" })
                            <div class="input-group shadow-sm rounded-3 overflow-hidden">
                                <span class="input-group-text bg-white border-end-0 border-light-subtle text-muted">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-key-fill" viewBox="0 0 16 16">
                                        <path d="M3.5 11.5a3.5 3.5 0 1 1 3.163-5H14L15.5 8 14 9.5l-1.5-1.5L11 9.5 9.5 8 8 9.5H6.663a3.5 3.5 0 0 1-3.163 2M2.5 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/>
                                    </svg>
                                </span>
                                @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control border-start-0 border-light-subtle ps-1 py-2", placeholder = "Nhập mật khẩu..." })
                            </div>
                            @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger small mt-1 d-block fw-medium" })
                        </div>

                        <!-- Nút hành động -->
                        @* Nút submit tạo tài khoản. *@
                        <div class="d-grid gap-2 mt-4 pt-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold py-2 shadow border-0 btn-hover-scale bg-gradient">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-check-circle-fill me-2 align-middle" viewBox="0 0 16 16">
                                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                                </svg>
                                Tạo tài khoản
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* Style riêng cho màn hình tạo tài khoản. *@
<style>
    /* Hieu ung nhe cho nut tao tai khoan. */
    .btn-hover-scale {
        transition: all 0.2s ease-in-out;
    }
    .btn-hover-scale:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3) !important;
    }
    /* Hieu ung cho link quay lai. */
    .hover-translate {
        transition: transform 0.2s ease;
    }
    .hover-translate:hover {
        transform: translateX(-3px);
        color: #212529 !important;
    }
    /* Hieu ung cho card chinh. */
    .card {
        transition: all 0.3s ease;
    }
    .card:hover {
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1) !important;
    }
    /* Giu focus input gon, khong bi bong do Bootstrap mac dinh. */
    .form-control:focus {
        border-color: #86b7fe;
        box-shadow: none;
    }
    /* Tô viền nhóm input khi người dùng đang nhập liệu. */
    .input-group:focus-within {
        outline: 2px solid #86b7fe;
        border-radius: 8px;
    }
</style>
