@* Mục đích: danh sách nhân viên, lọc theo khoa/phòng và import dữ liệu. *@
@model HospitalQualityDashboardDemo.Models.ViewModels.NhanVienIndexViewModel
@using System.Linq
@{
    ViewBag.Title = "Nhân viên";
    var items = (Model.Items ?? new System.Collections.Generic.List<HospitalQualityDashboardDemo.Models.ViewModels.NhanVienViewModel>()).ToList();

    // Hàm nhỏ gọn để lấy chữ cái đầu của Tên (làm Avatar)
    Func<string, string> GetInitials = (name) =>
    {
        if (string.IsNullOrWhiteSpace(name)) return "NV";
        var parts = name.Trim().Split(' ');
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return (parts.First().Substring(0, 1) + parts.Last().Substring(0, 1)).ToUpper();
    };
}

@* Thêm đoạn CSS nhỏ này vào đầu trang hoặc file CSS chung để custom Avatar và Badge *@
<style>
    .avatar-circle {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
    }

    .badge-soft-success {
        background-color: #e6f8f0;
        color: #12b76a;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
    }

    .badge-soft-secondary {
        background-color: #f1f3f5;
        color: #6c757d;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
    }

    .action-text-btn {
        background: none;
        border: none;
        padding: 0;
        font-weight: 600;
        font-size: 0.9rem;
    }

        .action-text-btn:hover {
            text-decoration: underline;
        }
    /* Màu nền xanh đậm giống thiết kế */
    .btn-dark-blue {
        background-color: #0b3d91;
        color: white;
        border-color: #0b3d91;
    }

        .btn-dark-blue:hover {
            background-color: #082d6b;
            color: white;
        }

    .text-dark-blue {
        color: #0b3d91;
    }
</style>

<section class="management-page p-4">
    @* Tiêu đề trang và các nút thao tác chính *@
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">Nhân viên</h1>
            <p class="text-muted mb-0">Quản lý hồ sơ nhân viên và liên kết tài khoản sử dụng hệ thống.</p>
        </div>
        <div class="d-flex gap-3">
            <a href="@Url.Action("Employees", "Export", new { khoaPhongId = Model.KhoaPhongId })" class="btn btn-light border text-dark-blue fw-bold d-flex align-items-center gap-2 px-4 py-2">
                <i class="bi bi-download"></i> Xuất CSV
            </a>
            <a href="@Url.Action("Create")" class="btn btn-dark-blue fw-bold d-flex align-items-center gap-2 px-4 py-2 rounded-3">
                <i class="bi bi-person-plus"></i> Thêm nhân viên
            </a>
        </div>
    </div>

    @* Khung Lọc và Import (Chia lưới cột) *@
    <div class="row g-4 mb-4">
        @* Cột bên trái: Lọc *@
        <div class="col-lg-4 col-md-5">
            <div class="card border border-light-subtle shadow-sm h-100 rounded-3">
                <div class="card-body p-4">
                    <label class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 0.5px;">Lọc theo khoa/phòng</label>
                    @using (Html.BeginForm("Index", "Employee", FormMethod.Get, new { id = "filterForm" }))
                    {
                        @* Thêm onchange để tự động submit khi chọn dropdown, không cần nút bấm Lọc *@
                        @Html.DropDownListFor(m => m.KhoaPhongId, Model.KhoaPhongOptions, "Tất cả khoa/phòng", new { @class = "form-select border-light-subtle", onchange = "document.getElementById('filterForm').submit();" })
                    }
                </div>
            </div>
        </div>

        @* Cột bên phải: Import *@
        <div class="col-lg-8 col-md-7">
            <div class="card border border-light-subtle shadow-sm h-100 rounded-3">
                <div class="card-body p-4">
                    <label class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 0.5px;">Nhập dữ liệu nhanh</label>
                    @using (Html.BeginForm("Import", "Employee", FormMethod.Post, new { enctype = "multipart/form-data", @class = "d-flex gap-3 align-items-center" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.KhoaPhongId)
                        <div class="input-group">
                            <label class="input-group-text bg-white border-end-0 text-muted" for="fileInput">
                                <i class="bi bi-file-earmark-arrow-up"></i>&nbsp; Chọn tệp tin...
                            </label>
                            <input type="file" id="fileInput" name="File" class="form-control border-start-0 ps-0" />
                        </div>
                        <button class="action-text-btn text-dark-blue d-flex align-items-center gap-2 text-nowrap px-3" type="submit">
                            <i class="bi bi-box-arrow-in-right fs-5"></i> Import nhân viên
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Thông báo *@
    @if (Model.ImportResult != null)
    {
        <div class="alert alert-info rounded-3">Thành công: @Model.ImportResult.SoDongThanhCong, lỗi: @Model.ImportResult.SoDongLoi</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-3">@TempData["Error"]</div>
    }

    @* Bảng danh sách nhân viên *@
    <div class="card border border-light-subtle shadow-sm rounded-3">
        @if (items.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>STT</th>
                            <th class="text-uppercase text-muted fw-bold border-bottom-0 py-3" style="font-size: 0.75rem;">Mã</th>
                            <th class="text-uppercase text-muted fw-bold border-bottom-0 py-3" style="font-size: 0.75rem;">Họ Tên</th>
                            <th class="text-uppercase text-muted fw-bold border-bottom-0 py-3" style="font-size: 0.75rem;">Khoa/phòng</th>
                            <th class="text-uppercase text-muted fw-bold border-bottom-0 py-3" style="font-size: 0.75rem;">Email</th>
                            <th class="text-uppercase text-muted fw-bold border-bottom-0 py-3" style="font-size: 0.75rem;">Trạng thái</th>
                            <th class="text-uppercase text-muted fw-bold border-bottom-0 py-3 pe-4 text-end" style="font-size: 0.75rem;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @{
                            // Tính toán số thứ tự bắt đầu cho trang hiện tại
                            // Công thức: (Số trang - 1) * Số dòng mỗi trang + 1
                            int stt = ((Model.Page < 1 ? 1 : Model.Page) - 1) * Model.PageSize + 1;
                        }

                        @foreach (var item in items)
                        {
                            var avatarColors = new[] { "bg-primary-subtle text-primary", "bg-success-subtle text-success", "bg-danger-subtle text-danger", "bg-warning-subtle text-warning" };
                            var colorClass = avatarColors[item.NhanVienId % 4];

                            <tr>
                                @* Hiển thị số thứ tự và tăng giá trị sau mỗi dòng *@
                                <td class="ps-4 py-3 text-muted">@(stt++)</td>

                                <td class="py-3">
                                    <span class="text-dark-blue fw-bold">@item.MaNhanVien</span>
                                </td>
                                <td class="py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-circle @colorClass">
                                            @GetInitials(item.HoTen)
                                        </div>
                                        <span class="fw-semibold text-dark">@item.HoTen</span>
                                    </div>
                                </td>
                                <td class="text-dark fw-medium py-3">@item.TenKhoaPhong</td>
                                <td class="text-dark py-3">@item.Email</td>
                                <td class="py-3">
                                    <span class="badge @(item.DangHoatDong ? "badge-soft-success" : "badge-soft-secondary")">
                                        @(item.DangHoatDong ? "Hoạt động" : "Đã khóa")
                                    </span>
                                </td>
                                <td class="text-end pe-4 py-3">
                                    <div class="d-flex justify-content-end gap-2 align-items-center">
                                        @* Nút Sửa *@
                                        <a href="@Url.Action("Edit", new { id = item.NhanVienId })" class="btn btn-sm btn-outline-primary rounded-3 fw-semibold px-3">
                                            Sửa
                                        </a>

                                        @* Nút Khóa/Mở khóa *@
                                        @using (Html.BeginForm(item.DangHoatDong ? "Lock" : "Unlock", "Employee", new { id = item.NhanVienId }, FormMethod.Post, new { @class = "m-0 p-0" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-warning rounded-3 fw-semibold px-3" type="submit">
                                                @(item.DangHoatDong ? "Khóa" : "Mở khóa")
                                            </button>
                                        }

                                        @* Nút Xóa *@
                                        @using (Html.BeginForm("Delete", "Employee", new { id = item.NhanVienId }, FormMethod.Post, new { @class = "m-0 p-0" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-danger rounded-3 fw-semibold px-3" type="submit" onclick="return confirm('Xóa nhân viên này?')">
                                                Xóa
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Phân trang mô phỏng Footer *@
            <div class="card-footer bg-light border-top-0 d-flex justify-content-between align-items-center py-3 px-4">
                <span class="text-muted small">
                    Đang hiển thị @(((Model.Page < 1 ? 1 : Model.Page) - 1) * Model.PageSize + 1) đến @(Math.Min(Model.Page * Model.PageSize, Model.TotalItems)) của @Model.TotalItems nhân viên
                </span>

                @if (Model.TotalPages > 1)
                {
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                <a class="page-link text-muted border-0 bg-transparent" href="@Url.Action("Index", new { khoaPhongId = Model.KhoaPhongId, page = Model.Page - 1 })"><i class="bi bi-chevron-left"></i></a>
                            </li>

                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                if (p == Model.Page)
                                {
                                    <li class="page-item active"><span class="page-link border-0" style="background-color: #0b3d91;">@p</span></li>
                                }
                                else
                                {
                                    <li class="page-item"><a class="page-link text-dark border-0 bg-transparent" href="@Url.Action("Index", new { khoaPhongId = Model.KhoaPhongId, page = p })">@p</a></li>
                                }
                            }

                            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link text-muted border-0 bg-transparent" href="@Url.Action("Index", new { khoaPhongId = Model.KhoaPhongId, page = Model.Page + 1 })"><i class="bi bi-chevron-right"></i></a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        }
        else
        {
            <div class="text-center p-5 text-muted">
                <i class="bi bi-person-x fs-1 opacity-50 mb-3 d-block"></i>
                Chưa có nhân viên phù hợp với bộ lọc hiện tại.
            </div>
        }
    </div>
</section>