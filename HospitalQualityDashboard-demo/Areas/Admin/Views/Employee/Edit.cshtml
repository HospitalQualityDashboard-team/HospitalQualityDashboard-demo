@* Mục đích: form Admin cập nhật hồ sơ nhân viên và thông tin tài khoản liên quan. *@
@model HospitalQualityDashboardDemo.Models.ViewModels.NhanVienViewModel
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Web.Mvc

@{
    ViewBag.Title = Model.NhanVienId == 0 ? "Thêm nhân viên" : "Sửa nhân viên";
    var departmentOptions = Model.KhoaPhongOptions ?? new List<SelectListItem>();
    var selectedDepartment = departmentOptions.FirstOrDefault(x => x.Value == Model.KhoaPhongId.ToString());
    var genderOptions = new List<SelectListItem>
    {
        new SelectListItem { Text = "Nam", Value = "Nam", Selected = string.Equals(Model.GioiTinh, "Nam", StringComparison.OrdinalIgnoreCase) },
        new SelectListItem { Text = "Nữ", Value = "Nữ", Selected = string.Equals(Model.GioiTinh, "Nữ", StringComparison.OrdinalIgnoreCase) }
    };
}

<div class="form-page employee-form-page">

    <div class="page-header form-page-header">
        <div>
            <span class="status-pill status-open">Admin</span>
            <h1>@ViewBag.Title</h1>
            <p>Quản lý thông tin nhân viên, khoa/phòng và trạng thái hoạt động.</p>
        </div>

        <div class="page-actions">
            @Html.ActionLink(
                "Quay lại danh sách",
                "Index",
                null,
                new { @class = "btn btn-outline-secondary" })
        </div>
    </div>

    <div class="data-panel employee-form-card">

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.NhanVienId)

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "alert alert-danger" })

            <div class="panel-header">
                <div>
                    <h2>Thông tin nhân viên</h2>
                    <p>Cập nhật hồ sơ và thông tin liên hệ của nhân viên.</p>
                </div>
            </div>

            <div class="row g-3">

                <div class="col-md-4">
                    @Html.LabelFor(
                        m => m.MaNhanVien,
                        new { @class = "form-label fw-semibold" })

                    @Html.TextBoxFor(
                        m => m.MaNhanVien,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Ví dụ: NV001"
                        })
                    @Html.ValidationMessageFor(
                        m => m.MaNhanVien,
                        "",
                        new { @class = "text-danger small" })
                </div>

                <div class="col-md-8">
                    @Html.LabelFor(
                        m => m.HoTen,
                        new { @class = "form-label fw-semibold" })

                    @Html.TextBoxFor(
                        m => m.HoTen,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Nguyễn Văn A"
                        })
                </div>

                <div class="col-md-4">
                    @Html.Label(
                        "KhoaPhongId",
                        "Khoa/phòng",
                        new { @class = "form-label fw-semibold" })

                    <div class="department-picker report-filter-combobox">
                        @Html.HiddenFor(
                            m => m.KhoaPhongId,
                            new { id = "KhoaPhongId" })

                        <input type="text"
                               id="KhoaPhongSearch"
                               class="form-control report-filter-input"
                               value="@(selectedDepartment == null ? string.Empty : selectedDepartment.Text)"
                               placeholder="Nhập tên khoa/phòng để tìm"
                               autocomplete="off"
                               data-department-picker />

                        <div class="department-picker-menu report-filter-options"
                             data-department-menu
                             role="listbox">
                            @foreach (var option in departmentOptions)
                            {
                                <button type="button"
                                        class="department-picker-option report-filter-option"
                                        data-department-option
                                        data-id="@option.Value"
                                        data-name="@option.Text"
                                        role="option">
                                    @option.Text
                                </button>
                            }
                        </div>
                    </div>

                    @Html.ValidationMessageFor(
                        m => m.KhoaPhongId,
                        "",
                        new { @class = "text-danger small" })
                </div>

                <div class="col-md-4">
                    @Html.LabelFor(
                        m => m.NgaySinh,
                        new { @class = "form-label fw-semibold" })

                    <div class="app-date-picker">
                        @Html.TextBox(
                            "NgaySinh",
                            Model.NgaySinh.HasValue ? Model.NgaySinh.Value.ToString("dd/MM/yyyy") : string.Empty,
                            new
                            {
                                @class = "form-control app-date-input",
                                placeholder = "dd/MM/yyyy",
                                inputmode = "numeric",
                                pattern = "\\d{1,2}/\\d{1,2}/\\d{4}",
                                maxlength = "10",
                                autocomplete = "off",
                                data_date_input = "",
                                data_date_picker_id = "EmployeeNgaySinhPicker",
                                data_date_invalid_message = "Ngày sinh không hợp lệ. Vui lòng nhập đúng định dạng dd/MM/yyyy."
                            })

                        <button class="app-date-trigger"
                                type="button"
                                title="Chọn ngày sinh"
                                aria-label="Chọn ngày sinh"
                                data-date-picker-trigger="EmployeeNgaySinhPicker">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <rect x="3" y="4" width="18" height="17" rx="2"></rect>
                                <path d="M8 2v4M16 2v4M3 10h18"></path>
                            </svg>
                        </button>

                        <input id="EmployeeNgaySinhPicker"
                               class="app-date-native"
                               type="date"
                               value="@(Model.NgaySinh.HasValue ? Model.NgaySinh.Value.ToString("yyyy-MM-dd") : null)"
                               tabindex="-1"
                               aria-hidden="true"
                               data-date-picker
                               data-date-display-id="NgaySinh" />
                    </div>

                    @Html.ValidationMessageFor(
                        m => m.NgaySinh,
                        "",
                        new { @class = "text-danger small" })
                </div>

                <div class="col-md-4">
                    @Html.LabelFor(
                        m => m.ChucVu,
                        new { @class = "form-label fw-semibold" })

                    @Html.TextBoxFor(
                        m => m.ChucVu,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Bác sĩ"
                        })
                </div>

                <div class="col-md-4">
                    @Html.LabelFor(
                        m => m.GioiTinh,
                        new { @class = "form-label fw-semibold" })

                    @Html.DropDownListFor(
                        m => m.GioiTinh,
                        genderOptions,
                        "-- Chọn giới tính --",
                        new
                        {
                            @class = "form-select"
                        })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(
                        m => m.Email,
                        new { @class = "form-label fw-semibold" })

                    @Html.TextBoxFor(
                        m => m.Email,
                        new
                        {
                            @class = "form-control",
                            placeholder = "email@hospital.vn"
                        })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(
                        m => m.SoDienThoai,
                        new { @class = "form-label fw-semibold" })

                    @Html.TextBoxFor(
                        m => m.SoDienThoai,
                        new
                        {
                            @class = "form-control",
                            placeholder = "09xxxxxxxx"
                        })
                </div>

                <div class="col-12">

                    <div class="employee-status-box">

                        <div>
                            <strong>Trạng thái nhân viên</strong>
                            <span>
                                Nhân viên đang hoạt động sẽ xuất hiện trong
                                danh sách phân công và báo cáo.
                            </span>
                        </div>

                        <div class="form-check form-switch">
                            @Html.CheckBoxFor(
                                m => m.DangHoatDong,
                                new
                                {
                                    @class = "form-check-input",
                                    role = "switch"
                                })

                            @Html.LabelFor(
                                m => m.DangHoatDong,
                                "Đang hoạt động",
                                new { @class = "form-check-label" })
                        </div>

                    </div>

                </div>

            </div>

            <div class="form-actions mt-4">

                <button type="submit"
                        class="btn btn-primary px-4">
                    Lưu nhân viên
                </button>

                @Html.ActionLink(
                    "Hủy",
                    "Index",
                    null,
                    new
                    {
                        @class = "btn btn-outline-secondary px-4"
                    })

            </div>
        }

    </div>

</div>

@section scripts {
    <script>
        (function () {
            var input = document.querySelector("[data-department-picker]");
            var wrapper = input ? input.closest(".report-filter-combobox") : null;
            var hidden = document.getElementById("KhoaPhongId");
            var menu = document.querySelector("[data-department-menu]");

            if (!input || !wrapper || !hidden || !menu) {
                return;
            }

            var maxVisibleDepartments = 5;
            var options = Array.prototype.slice.call(menu.querySelectorAll("[data-department-option]"));

            function normalizeDepartmentName(value) {
                return (value || "").trim().toLocaleLowerCase("vi-VN");
            }

            function getMatches(ignoreQuery) {
                var query = ignoreQuery ? "" : normalizeDepartmentName(input.value);
                return options.filter(function (option) {
                    var name = normalizeDepartmentName(option.getAttribute("data-name"));
                    return !query || name.indexOf(query) >= 0;
                });
            }

            function renderDepartmentOptions(ignoreQuery) {
                var matches = getMatches(ignoreQuery).slice(0, maxVisibleDepartments);

                options.forEach(function (option) {
                    option.hidden = matches.indexOf(option) < 0;
                });

                if (matches.length > 0) {
                    wrapper.classList.add("is-open");
                } else {
                    wrapper.classList.remove("is-open");
                }
            }

            function hideDepartmentOptions() {
                wrapper.classList.remove("is-open");
            }

            function updateDepartmentSelection() {
                var selectedName = normalizeDepartmentName(input.value);
                var selected = options.filter(function (option) {
                    return normalizeDepartmentName(option.getAttribute("data-name")) === selectedName;
                })[0];

                hidden.value = selected ? selected.getAttribute("data-id") : "";
            }

            input.addEventListener("focus", function () {
                renderDepartmentOptions(true);
            });
            input.addEventListener("click", function () {
                renderDepartmentOptions(true);
            });
            input.addEventListener("input", function () {
                updateDepartmentSelection();
                renderDepartmentOptions();
            });

            menu.addEventListener("mousedown", function (event) {
                var option = event.target.closest("[data-department-option]");
                if (!option) {
                    return;
                }

                input.value = option.getAttribute("data-name");
                hidden.value = option.getAttribute("data-id");
                hideDepartmentOptions();
                event.preventDefault();
            });

            input.addEventListener("blur", function () {
                window.setTimeout(hideDepartmentOptions, 120);
            });

            if (input.form) {
                input.form.addEventListener("submit", updateDepartmentSelection);
            }
        })();
    </script>
}
