@* Mục đích: danh sách kỳ báo cáo và thao tác mở/khóa/xóa. *@
@model HospitalQualityDashboardDemo.Models.ViewModels.KyBaoCaoIndexViewModel
@using System.Linq
@using HospitalQualityDashboardDemo.Models.Enums
@{
    ViewBag.Title = "Kỳ báo cáo";
    var periods = (Model.Items ?? Enumerable.Empty<HospitalQualityDashboardDemo.Models.ViewModels.KyBaoCaoViewModel>()).ToList();
}
@functions {
    private string FormatPeriodStatus(TrangThaiKyBaoCao status)
    {
        switch (status)
        {
            case TrangThaiKyBaoCao.Nhap: return "Nháp";
            case TrangThaiKyBaoCao.Mo: return "Mở";
            case TrangThaiKyBaoCao.Khoa: return "Khóa";
            default: return status.ToString();
        }
    }

    private string StatusClass(TrangThaiKyBaoCao status)
    {
        switch (status)
        {
            case TrangThaiKyBaoCao.Mo: return "status-open";
            case TrangThaiKyBaoCao.Khoa: return "status-locked";
            default: return "status-draft";
        }
    }
}

<section class="management-page p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark">Kỳ báo cáo</h1>
            <p class="text-muted mb-0">Thiết lập thời gian mở, hạn nộp và theo dõi tiến độ của các chu kỳ báo cáo chất lượng.</p>
        </div>

        <div class="header-action-card">
            @* Nút Mở kỳ *@
            @using (Html.BeginForm("OpenDuePeriods", "ReportingPeriod", FormMethod.Post, new { @class = "d-inline" }))
            {
                @Html.AntiForgeryToken()
                <button class="btn-action-card" type="submit">
                    <i class="bi bi-calendar-check text-success"></i> Mở kỳ
                </button>
            }

            @* Nút Thêm mới *@
            @Html.ActionLink("Thêm kỳ", "Create", null, new { @class = "btn-action-card" })

            @* Nút Lịch tự động *@
            @Html.ActionLink("Tạo lịch", "GenerateSchedule", null, new { @class = "btn-action-card" })
        </div>
    </div>
    <section class="data-panel bg-white p-4 rounded-3 border">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 fw-bold">Danh sách chi tiết <span class="badge bg-secondary rounded-pill">@periods.Count kỳ báo cáo</span></h2>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle data-table">
                <thead>
                    <tr>
                        <th>Tên kỳ</th>
                        <th>Thời gian (Từ - Đến)</th>
                        <th>Hạn nộp</th>
                        <th>Trạng thái</th>
                        <th>Tiến độ nộp bài</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in periods)
                    {
                        var percent = item.TongBaoCao > 0 ? (int)System.Math.Round((decimal)item.DaGui * 100 / item.TongBaoCao) : 0;
                        <tr>
                            <td>
                                <strong>@item.TenKyBaoCao</strong><br />
                                <small class="text-muted">Mã kỳ: BC-@(item.KyBaoCaoId)</small>
                            </td>
                            <td><i class="bi bi-calendar-event me-1"></i> @item.TuNgay.ToString("dd/MM") - @item.DenNgay.ToString("dd/MM/yyyy")</td>
                            <td><i class="bi bi-clock me-1"></i> @item.HanNop.ToString("dd/MM/yyyy 23:59")</td>
                            <td><span class="status-pill @StatusClass(item.TrangThai)">@FormatPeriodStatus(item.TrangThai).ToUpper()</span></td>
                            <td class="align-middle">
                                <div class="fw-bold small mb-1">@percent% Hoàn thành</div>
                                <div class="progress" style="height: 6px; width: 120px;">
                                    <div class="progress-bar bg-success" style="width: @percent%"></div>
                                </div>
                                <small class="text-muted">@item.DaGui/@item.TongBaoCao đơn vị</small>
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    @Html.ActionLink(" ", "Edit", new { id = item.KyBaoCaoId }, new { @class = "bi bi-pencil text-primary" })
                                    @if (item.TrangThai != TrangThaiKyBaoCao.Mo)
                                    {
                                        using (Html.BeginForm("Open", "ReportingPeriod", new { id = item.KyBaoCaoId }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="border-0 bg-transparent bi bi-play-circle text-success"></button>
                                        }
                                    }
                                    @using (Html.BeginForm("Delete", "ReportingPeriod", new { id = item.KyBaoCaoId }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="border-0 bg-transparent bi bi-trash text-danger" onclick="return confirm('Xóa?')"></button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>
