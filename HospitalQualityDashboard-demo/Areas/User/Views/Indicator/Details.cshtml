@* Mục đích: trang chi tiết định nghĩa và cách tính chỉ số chất lượng. *@
@model HospitalQualityDashboardDemo.Models.ViewModels.ChiSoViewModel
@{
    ViewBag.Title = "Chi tiết chỉ số";
}

<section class="management-page">
    <div class="page-header">
        <div>
            <span class="dashboard-role">Bộ chỉ số</span>
            <h1>Chi tiết chỉ số</h1>
            <p>Định nghĩa, tần suất, công thức tính và mục tiêu của chỉ số.</p>
        </div>
        <div class="management-toolbar">
            @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
    </div>

    <section class="data-panel">
        @Html.Partial("~/Views/Shared/_IndicatorDetailContent.cshtml", Model)
    </section>
</section>
