@* Mục đích: dashboard tổng hợp tiến độ báo cáo và cảnh báo thiếu/quá hạn. *@
@model HospitalQualityDashboardDemo.Models.ViewModels.DashboardViewModel
@using System.Globalization
@using System.Linq
@using System.Web
@{
    ViewBag.Title = "Tổng quan";

    var progressItems = (Model.DepartmentProgress ?? new System.Collections.Generic.List<HospitalQualityDashboardDemo.Models.ViewModels.DepartmentProgressViewModel>()).ToList();
    var missingReports = (Model.MissingReports ?? new System.Collections.Generic.List<HospitalQualityDashboardDemo.Models.ViewModels.MissingReportAlertViewModel>()).ToList();
    var totalReportSlots = Model.BaoCaoDaGui + Model.BaoCaoThieu;
    var completionRate = totalReportSlots > 0 ? (int)Math.Round((decimal)Model.BaoCaoDaGui * 100 / totalReportSlots) : 0;
    var roleLabel = Model.IsAdmin ? "Admin hệ thống" : "Khoa/phòng";
    var totalMetricLabel = Model.IsAdmin ? "Tổng chỉ số" : "Chỉ số được phân công";
    var urgentCount = Model.OverdueMissingReportCount + Model.DueSoonReportCount;
    var activeTab = string.IsNullOrWhiteSpace(Model.ActiveTab) ? "comparison" : Model.ActiveTab;
    ViewBag.Title = activeTab == "comparison" ? "So sánh kỳ báo cáo" : activeTab == "trend" ? "Xu hướng" : "Tổng quan";
}

<section class="dashboard-hero">
    <div class="dashboard-titlebar">
        <span class="dashboard-role">@roleLabel</span>
        <h1>Trung tâm điều hành chất lượng</h1>
        <p>Theo dõi tiến độ nộp báo cáo, nhận diện chỉ số còn thiếu và kiểm soát rủi ro quá hạn theo khoa/phòng.</p>
    </div>
    <div class="dashboard-summary-strip" aria-label="Tóm tắt tiến độ">
        <div class="dashboard-summary-item">
            <span>Tỷ lệ hoàn tất</span>
            <strong>@completionRate%</strong>
        </div>
        <div class="dashboard-summary-item">
            <span>Cần xử lý</span>
            <strong>@urgentCount</strong>
        </div>
        <div class="dashboard-summary-item">
            <span>Khoa/phòng</span>
            <strong>@progressItems.Count</strong>
        </div>
    </div>
</section>

@if (!Model.IsAdmin)
{
    <section class="missing-work-panel missing-report-alert">
        <div class="missing-work-summary">
            <div>
                <h2>Việc báo cáo cần xử lý</h2>
                @if (missingReports.Any())
                {
                    <p>Bạn có @missingReports.Count chỉ số chưa báo cáo trong các kỳ đang theo dõi.</p>
                    <div class="status-stack">
                        <span class="status-pill status-danger">@Model.OverdueMissingReportCount quá hạn</span>
                        <span class="status-pill status-warning">@Model.DueSoonReportCount sắp đến hạn</span>
                    </div>
                }
                else
                {
                    <p>Không có chỉ số quá hạn hoặc sắp đến hạn trong phạm vi phân công hiện tại.</p>
                }
            </div>
            @if (missingReports.Any())
            {
                <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#missingReportDetails" aria-expanded="false" aria-controls="missingReportDetails">
                    Xem danh sách
                </button>
            }
        </div>
        @if (missingReports.Any())
        {
            <div class="collapse missing-work-detail" id="missingReportDetails">
                <div class="table-responsive mt-3">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Kỳ báo cáo</th>
                                <th>Hạn nộp</th>
                                <th>Chỉ số</th>
                                <th>Trạng thái</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in missingReports)
                        {
                            <tr>
                                <td>@item.TenKyBaoCao</td>
                                <td>@item.HanNop.ToString("dd/MM/yyyy") 23:59</td>
                                <td><strong>@item.MaChiSo</strong> - @item.TenChiSo</td>
                                <td>
                                    @if (item.IsOverdue)
                                    {
                                        <span class="status-pill status-danger">Quá hạn @Math.Abs(item.DaysUntilDue) ngày</span>
                                    }
                                    else if (item.IsDueSoon)
                                    {
                                        <span class="status-pill status-warning">Còn @item.DaysUntilDue ngày</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-muted">Chưa gửi</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @Html.ActionLink("Nhập báo cáo", "Edit", "Report", new { kyBaoCaoId = item.KyBaoCaoId, chiSoChatLuongId = item.ChiSoChatLuongId }, new { @class = "btn btn-sm btn-primary" })
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>
}

<section class="metric-grid" aria-label="Chỉ số tổng quan">
    <article class="metric-card is-accent">
        <div class="metric-card-header">
            <span class="metric-label">@totalMetricLabel</span>
            <span class="metric-icon">CS</span>
        </div>
        <strong class="metric-value">@Model.TongChiSo</strong>
        <p class="metric-caption">Phạm vi chỉ số đang được theo dõi.</p>
    </article>
    <article class="metric-card is-success">
        <div class="metric-card-header">
            <span class="metric-label">Đã báo cáo</span>
            <span class="metric-icon">ĐG</span>
        </div>
        <strong class="metric-value">@Model.BaoCaoDaGui</strong>
        <p class="metric-caption">@completionRate% hồ sơ báo cáo đã hoàn tất.</p>
    </article>
    <article class="metric-card is-warning">
        <div class="metric-card-header">
            <span class="metric-label">Còn thiếu</span>
            <span class="metric-icon">CT</span>
        </div>
        <strong class="metric-value">@Model.BaoCaoThieu</strong>
        <p class="metric-caption">Chỉ số chưa có báo cáo hợp lệ.</p>
    </article>
    <article class="metric-card is-danger">
        <div class="metric-card-header">
            <span class="metric-label">Quá hạn</span>
            <span class="metric-icon">QH</span>
        </div>
        <strong class="metric-value">@Model.BaoCaoQuaHan</strong>
        <p class="metric-caption">Cần rà soát và nhắc nộp bổ sung.</p>
    </article>
</section>

<nav class="dashboard-analysis-tabs" aria-label="Phân tích Dashboard">
    <a class="dashboard-analysis-tab @(activeTab == "overview" ? "is-active" : null)" href="@Url.Action("Index", "Dashboard", new { area = "User", DashboardTab = "overview", TanSuat = Model.SelectedTanSuat })">Tổng quan</a>
    <a class="dashboard-analysis-tab @(activeTab == "comparison" ? "is-active" : null)" href="@Url.Action("Index", "Dashboard", new { area = "User", DashboardTab = "comparison", TanSuat = Model.SelectedTanSuat })">So sánh kỳ báo cáo</a>
    <a class="dashboard-analysis-tab @(activeTab == "trend" ? "is-active" : null)" href="@Url.Action("Index", "Dashboard", new { area = "User", DashboardTab = "trend", TanSuat = Model.SelectedTanSuat })">Xu hướng</a>
</nav>

<div class="dashboard-tab-pane @(activeTab == "overview" ? "is-active" : null)" data-dashboard-pane="overview" @(activeTab == "overview" ? null : "hidden")>
<section class="dashboard-grid">
    <div class="dashboard-panel">
        <div class="panel-header">
            <div>
                <h2>Tiến độ báo cáo theo khoa/phòng</h2>
                <p>So sánh số báo cáo đã gửi với tổng chỉ số cần nộp.</p>
            </div>
            <div class="panel-toolbar">
                <span class="status-pill status-success">@Model.BaoCaoDaGui đã gửi</span>
                <span class="status-pill status-muted">@Model.BaoCaoThieu còn thiếu</span>
            </div>
        </div>
        @if (progressItems.Any())
        {
            <div class="chart-shell">
                <canvas id="progressChart" height="108"></canvas>
            </div>
        }
        else
        {
            <div class="empty-state">Chưa có dữ liệu tiến độ để hiển thị.</div>
        }
    </div>

    <div class="dashboard-panel">
        <div class="panel-header">
            <div>
                <h2>Bảng tiến độ</h2>
                <p>Tỷ lệ hoàn tất của từng khoa/phòng.</p>
            </div>
            <div class="panel-toolbar">
                <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#dashboardExportModal">
                    Xuất Excel
                </button>
            </div>
        </div>
        @if (progressItems.Any())
        {
            <div class="progress-list">
                @foreach (var item in progressItems)
                {
                    var percent = item.Tong > 0 ? (int)Math.Round((decimal)item.DaGui * 100 / item.Tong) : 0;
                    <div class="progress-row">
                        <div>
                            <div class="progress-name">@item.TenKhoaPhong</div>
                            <div class="progress-meta">@item.DaGui/@item.Tong báo cáo</div>
                        </div>
                        <div class="progress-track" aria-label="@item.TenKhoaPhong đạt @percent%">
                            <div class="progress-fill" style="width: @(percent)%"></div>
                        </div>
                        <div class="progress-number">@percent%</div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">Chưa có khoa/phòng trong phạm vi theo dõi.</div>
        }
    </div>
</section>
</div>

<div class="dashboard-tab-pane @(activeTab == "comparison" ? "is-active" : null)" data-dashboard-pane="comparison" data-dashboard-url="@Url.Action("Comparison", "Dashboard", new { area = "User" })" @(activeTab == "comparison" ? null : "hidden")>
    @if (Model.Comparison != null) { @Html.Partial("~/Views/Shared/_DashboardComparison.cshtml", Model.Comparison) }
</div>
<div class="dashboard-tab-pane @(activeTab == "trend" ? "is-active" : null)" data-dashboard-pane="trend" data-dashboard-url="@Url.Action("Trend", "Dashboard", new { area = "User" })" @(activeTab == "trend" ? null : "hidden")>
    @if (Model.Trend != null) { @Html.Partial("~/Views/Shared/_DashboardTrend.cshtml", Model.Trend) }
</div>

<div class="modal fade" id="dashboardExportModal" tabindex="-1" aria-labelledby="dashboardExportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-3">
            @using (Html.BeginForm("Dashboard", "Export", new { area = "User" }, FormMethod.Get, new { id = "dashboardExportForm" }))
            {
                <input type="hidden" name="KhoaPhongId" value="@Model.KhoaPhongId" />
                <div class="modal-header border-0 pb-2">
                    <h5 class="modal-title fw-bold text-secondary" id="dashboardExportModalLabel">Xuất Excel Dashboard</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body pt-0">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label" for="NamBaoCao">Năm báo cáo</label>
                            @Html.DropDownList("NamBaoCao", Model.NamBaoCaoOptions, new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="KyBaoCaoId">Kỳ báo cáo</label>
                            @Html.DropDownList("KyBaoCaoId", Model.KyBaoCaoOptions, new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="TanSuat">Tần suất</label>
                            @Html.DropDownList("TanSuat", Model.TanSuatOptions, new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="LinhVuc">Lĩnh vực</label>
                            @Html.DropDownList("LinhVuc", Model.LinhVucOptions, new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="TrangThaiNhapLieu">Trạng thái nhập liệu</label>
                            @Html.DropDownList("TrangThaiNhapLieu", Model.TrangThaiNhapLieuOptions, new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="TrangThaiDuyet">Trạng thái duyệt</label>
                            @Html.DropDownList("TrangThaiDuyet", Model.TrangThaiDuyetOptions, new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="DatMucTieu">Đạt/chưa đạt mục tiêu</label>
                            @Html.DropDownList("DatMucTieu", Model.DatMucTieuOptions, new { @class = "form-select form-select-sm" })
                        </div>
                    </div>
                    <div class="border rounded-3 p-3 mt-3 mb-3 bg-light">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="enable-dashboard-comparison" />
                            <label class="form-check-label fw-semibold" for="enable-dashboard-comparison">So sánh nhiều kỳ</label>
                        </div>
                        <div id="dashboard-comparison-panel" class="mt-3" hidden>
                            <label class="form-label" for="dashboard-comparison-periods">Các kỳ dùng để so sánh</label>
                            <select class="form-select form-select-sm" id="dashboard-comparison-periods" name="ComparisonPeriodIds" multiple size="5" disabled></select>
                            <div class="form-text">Chỉ hiển thị kỳ cũ hơn, cùng tần suất. Có thể chọn tối đa 11 kỳ so sánh.</div>
                            <div class="text-danger small mt-1" id="dashboard-comparison-message"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light border rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4">Xuất Excel</button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="@Url.Content("~/Scripts/dashboard-analysis.js")"></script>
<script>
function initializeDashboardComparison() {
    var periods = window.dashboardComparisonPeriods || [];
    var primarySelect = document.getElementById('KyBaoCaoId');
    var toggle = document.getElementById('enable-dashboard-comparison');
    var panel = document.getElementById('dashboard-comparison-panel');
    var comparisonSelect = document.getElementById('dashboard-comparison-periods');
    var message = document.getElementById('dashboard-comparison-message');
    if (!primarySelect || !toggle || !panel || !comparisonSelect) return;

    function refreshPeriods() {
        var primary = periods.find(function(period) {
            return String(period.id) === primarySelect.value;
        });
        var eligible = primary
            ? periods.filter(function(period) {
                return period.frequency === primary.frequency && period.start < primary.start;
            })
            : [];

        comparisonSelect.innerHTML = '';
        eligible.forEach(function(period, index) {
            comparisonSelect.add(new Option(period.name, period.id, index === 0, index === 0));
        });

        toggle.disabled = !primary || eligible.length === 0;
        if (toggle.disabled) toggle.checked = false;
        panel.hidden = !toggle.checked;
        comparisonSelect.disabled = !toggle.checked;
        message.textContent = primary && eligible.length === 0
            ? 'Không có kỳ cũ hơn cùng tần suất để so sánh.'
            : '';
    }

    toggle.addEventListener('change', function() {
        panel.hidden = !toggle.checked;
        comparisonSelect.disabled = !toggle.checked;
        if (toggle.checked && comparisonSelect.options.length > 0 && comparisonSelect.selectedOptions.length === 0) {
            comparisonSelect.options[0].selected = true;
        }
    });
    comparisonSelect.addEventListener('change', function() {
        var selected = Array.from(comparisonSelect.selectedOptions);
        if (selected.length > 11) selected[selected.length - 1].selected = false;
    });
    primarySelect.addEventListener('change', refreshPeriods);
    refreshPeriods();
}

var labels = [@Html.Raw(string.Join(",", progressItems.Select(x => "\"" + HttpUtility.JavaScriptStringEncode(x.TenKhoaPhong) + "\"")))];
var values = [@string.Join(",", progressItems.Select(x => x.DaGui))];
var totals = [@string.Join(",", progressItems.Select(x => x.Tong))];
var chartElement = document.getElementById('progressChart');
window.dashboardComparisonPeriods = [
@foreach (var period in Model.ComparisonPeriods ?? new System.Collections.Generic.List<HospitalQualityDashboardDemo.Models.DTOs.DashboardComparisonPeriodDto>())
{
    <text>{ id: @period.KyBaoCaoId, name: "@Html.Raw(HttpUtility.JavaScriptStringEncode(period.TenKyBaoCao))", frequency: @period.TanSuat, start: "@period.TuNgay.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" },</text>
}
];

if (chartElement && labels.length) {
    new Chart(chartElement, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Đã gửi',
                    data: values,
                    backgroundColor: 'rgba(20, 108, 120, 0.82)',
                    borderColor: 'rgba(20, 108, 120, 1)',
                    borderWidth: 1,
                    borderRadius: 6
                },
                {
                    label: 'Tổng cần nộp',
                    data: totals,
                    backgroundColor: 'rgba(37, 99, 235, 0.18)',
                    borderColor: 'rgba(37, 99, 235, 0.52)',
                    borderWidth: 1,
                    borderRadius: 6
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        boxWidth: 12,
                        boxHeight: 12
                    }
                }
            },
            scales: {
                x: {
                    grid: {
                        display: false
                    },
                    ticks: {
                        maxRotation: 0,
                        autoSkip: true,
                        maxTicksLimit: 8
                    }
                },
                y: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0
                    }
                }
            }
        }
    });
}

document.addEventListener('DOMContentLoaded', function() {
    initializeDashboardComparison();
    initializeDashboardAnalysis();
});
</script>
}
