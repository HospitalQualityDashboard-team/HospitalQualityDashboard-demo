@model IEnumerable<HospitalQualityDashboard.Models.ViewModels.NotificationViewModel>
@{
    ViewBag.Title = "Thông báo";
    var isAdmin = Convert.ToString(Session["LoaiTaiKhoan"]) == "Admin";
}
<div class="page-header">
    <div>
        <h1>Thông báo</h1>
        <p>Theo dõi và gửi thông báo cho các khoa/phòng.</p>
    </div>
</div>
@if (isAdmin)
{
    <div class="d-flex gap-2 flex-wrap mb-3">
        @Html.ActionLink("Gửi thông báo", "Create", null, new { @class = "btn btn-primary" })
        @using (Html.BeginForm("RunAutomation", "Notification", FormMethod.Post, new { @class = "d-inline" }))
        {
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-success" type="submit">Chạy kiểm tra thông báo tự động</button>
        }
    </div>
}
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
<table class="table table-striped table-sm">
    <thead><tr><th>Tiêu đề</th><th>Loại</th><th>Ngày tạo</th><th>Đã đọc</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        var detailUrl = Url.Action("Details", new { id = item.ThongBaoId });
        <tr>
            <td>
                <strong>@Html.ActionLink(item.TieuDe, "Details", new { id = item.ThongBaoId }, new { @class = "text-dark text-decoration-none" })</strong><br />
                <a href="@detailUrl" class="text-body text-decoration-none">@item.NoiDung</a>
            </td>
            <td>@item.LoaiThongBao</td>
            <td>@item.NgayTao</td>
            <td>@(item.DaDoc ? "Có" : "Chưa")</td>
            <td>
                @Html.ActionLink("Xem chi tiết", "Details", new { id = item.ThongBaoId }, new { @class = "btn btn-sm btn-outline-primary" })
            </td>
        </tr>
    }
    </tbody>
</table>
