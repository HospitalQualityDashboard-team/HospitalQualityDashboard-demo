@model HospitalQualityDashboard.Models.ViewModels.ReportEntryViewModel
@{
    ViewBag.Title = "Nhap bao cao";
}
<h2>@Model.MaChiSo - @Model.TenChiSo</h2>
<p><strong>Ky:</strong> @Model.TenKyBaoCao | <strong>Khoa phong:</strong> @Model.TenKhoaPhong | <strong>Trang thai:</strong> @Model.TrangThai</p>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.BaoCaoId)
    @Html.HiddenFor(m => m.KyBaoCaoId)
    @Html.HiddenFor(m => m.KhoaPhongId)
    @Html.HiddenFor(m => m.ChiSoChatLuongId)
    @Html.HiddenFor(m => m.TenKyBaoCao)
    @Html.HiddenFor(m => m.TenKhoaPhong)
    @Html.HiddenFor(m => m.MaChiSo)
    @Html.HiddenFor(m => m.TenChiSo)
    @Html.HiddenFor(m => m.LoaiCongThuc)
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="row">
        <div class="col-md-4 mb-3">@Html.LabelFor(m => m.TuSo, new { @class = "form-label" }) @Html.TextBoxFor(m => m.TuSo, new { @class = "form-control", type = "number", step = "0.0001" })</div>
        <div class="col-md-4 mb-3">@Html.LabelFor(m => m.MauSo, new { @class = "form-label" }) @Html.TextBoxFor(m => m.MauSo, new { @class = "form-control", type = "number", step = "0.0001" })</div>
        <div class="col-md-4 mb-3">@Html.LabelFor(m => m.GiaTriNhap, new { @class = "form-label" }) @Html.TextBoxFor(m => m.GiaTriNhap, new { @class = "form-control", type = "number", step = "0.0001" })</div>
    </div>
    <div class="mb-3">@Html.LabelFor(m => m.GhiChu, new { @class = "form-label" }) @Html.TextAreaFor(m => m.GhiChu, new { @class = "form-control", rows = 3 })</div>
    <button class="btn btn-primary" type="submit">Luu nhap</button>
    @Html.ActionLink("Quay lai", "Index", null, new { @class = "btn btn-outline-secondary" })
}
@if (Model.BaoCaoId > 0)
{
    using (Html.BeginForm("Submit", "Report", new { id = Model.BaoCaoId }, FormMethod.Post, new { @class = "mt-3" }))
    {
        @Html.AntiForgeryToken()
        <button class="btn btn-success" type="submit">Gui bao cao</button>
    }
}
