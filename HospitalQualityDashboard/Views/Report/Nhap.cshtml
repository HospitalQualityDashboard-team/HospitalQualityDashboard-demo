@model IEnumerable<HospitalQualityDashboard.Models.ViewModels.ReportEntryViewModel>
@{
    ViewBag.Title = "Nhap bao cao";
}
<h2>Nhap bao cao</h2>
<table class="table table-striped table-sm">
    <thead><tr><th>Chi so</th><th>Cong thuc</th><th>Ket qua</th><th>Trang thai</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.MaChiSo - @item.TenChiSo</td>
            <td>@item.LoaiCongThuc</td>
            <td>@item.KetQua</td>
            <td>@item.TrangThai</td>
            <td class="text-end">@Html.ActionLink("Nhap", "Edit", new { id = item.BaoCaoId, kyBaoCaoId = item.KyBaoCaoId, khoaPhongId = item.KhoaPhongId, chiSoChatLuongId = item.ChiSoChatLuongId }, new { @class = "btn btn-sm btn-primary" })</td>
        </tr>
    }
    </tbody>
</table>
