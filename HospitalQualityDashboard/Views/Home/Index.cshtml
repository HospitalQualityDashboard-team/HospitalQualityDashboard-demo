@{
    ViewBag.Title = "Home Page";
}

<main class="py-4">
    <h1>Hospital Quality Dashboard</h1>
    <p class="lead">He thong quan ly chi so chat luong, phan cong khoa phong va bao cao dinh ky.</p>
    @if (Session["TaiKhoanId"] == null)
    {
        @Html.ActionLink("Dang nhap", "Login", "Account", null, new { @class = "btn btn-primary" })
    }
    else
    {
        @Html.ActionLink("Vao dashboard", "Index", "Dashboard", null, new { @class = "btn btn-primary" })
    }
</main>
