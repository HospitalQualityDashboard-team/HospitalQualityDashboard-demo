@model HospitalQualityDashboard.Models.ViewModels.AssignmentViewModel
@{
    ViewBag.Title = "Phân công chỉ số";
}

<div class="container py-4">
    <!-- Header Section -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <div>
            <h1 class="h2 mb-1 text-primary fw-bold"><i class="bi bi-diagram-3 me-2"></i>Phân công chỉ số</h1>
            <p class="text-muted mb-0">Giao phó chỉ số chất lượng cho các khoa/phòng chịu trách nhiệm thu thập và báo cáo số liệu.</p>
        </div>
        <div class="d-flex gap-2">
            @using (Html.BeginForm("SyncFromIndicators", "Assignment", new { viewMode = Model.ViewMode }, FormMethod.Post, new { @class = "d-inline" }))
            {
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-primary px-3 rounded-pill shadow-sm" type="submit" title="Đồng bộ tự động từ danh mục cấu hình chỉ số">
                    <i class="bi bi-arrow-repeat me-1"></i> Đồng bộ cấu hình
                </button>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 p-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                <div>@TempData["Success"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 p-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                <div>@TempData["Error"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 5 Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 position-relative overflow-hidden hover-up" style="border-left: 4px solid #6366f1 !important;">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-semibold d-block mb-1">Tổng chỉ số</span>
                            <h3 class="fw-bold mb-0 text-dark">@Model.TongChiSo</h3>
                        </div>
                        <div class="rounded-circle p-2 bg-indigo-subtle text-indigo" style="background-color: #6366f115; color: #6366f1;">
                            <i class="bi bi-clipboard-data fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 position-relative overflow-hidden hover-up" style="border-left: 4px solid var(--app-success) !important;">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-semibold d-block mb-1">Đã phân công</span>
                            <h3 class="fw-bold mb-0 text-success">@Model.SoChiSoDaPhanCong</h3>
                        </div>
                        <div class="rounded-circle p-2 bg-success-subtle text-success">
                            <i class="bi bi-check-circle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 position-relative overflow-hidden hover-up" style="border-left: 4px solid var(--app-danger) !important;">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-semibold d-block mb-1">Chưa phân công</span>
                            <h3 class="fw-bold mb-0 text-danger">@Model.SoChiSoChuaPhanCong</h3>
                        </div>
                        <div class="rounded-circle p-2 bg-danger-subtle text-danger">
                            <i class="bi bi-exclamation-triangle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 position-relative overflow-hidden hover-up" style="border-left: 4px solid var(--app-primary) !important;">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-semibold d-block mb-1">Tổng phân công</span>
                            <h3 class="fw-bold mb-0 text-primary">@Model.TongPhanCong</h3>
                        </div>
                        <div class="rounded-circle p-2 bg-primary-subtle text-primary">
                            <i class="bi bi-diagram-3 fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 position-relative overflow-hidden hover-up" style="border-left: 4px solid var(--app-warning) !important;">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-semibold d-block mb-1">Đang tạm dừng</span>
                            <h3 class="fw-bold mb-0 text-warning">@Model.SoTamDung</h3>
                        </div>
                        <div class="rounded-circle p-2 bg-warning-subtle text-warning">
                            <i class="bi bi-pause-circle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Phân công mới (Collapsible) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-light border-0 py-3 d-flex justify-content-between align-items-center cursor-pointer" data-bs-toggle="collapse" data-bs-target="#createAssignmentForm">
            <h5 class="card-title mb-0 fw-bold text-secondary"><i class="bi bi-plus-circle me-1"></i>Tạo phân công giao việc mới</h5>
            <i class="bi bi-chevron-down text-muted"></i>
        </div>
        <div class="collapse show" id="createAssignmentForm">
            <div class="card-body p-4">
                @using (Html.BeginForm("Assign", "Assignment", FormMethod.Post, new { id = "assignmentForm" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ViewMode)
                    
                    <div class="row g-4">
                        <!-- Chọn Khoa/Phòng -->
                        <div class="col-lg-6">
                            <div class="card border border-light-subtle rounded-3">
                                <div class="card-header bg-light border-0 d-flex justify-content-between align-items-center py-2 px-3 flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold text-secondary small">① Khoa / Phòng</span>
                                        <span class="badge bg-primary text-white rounded-pill px-2 py-1 small" id="count-kp">Đã chọn: 0</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2 small" id="select-all-kp">Chọn tất cả</button>
                                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2 small" id="clear-all-kp">Bỏ chọn</button>
                                    </div>
                                </div>
                                <div class="card-header bg-white border-0 py-2 px-3">
                                    <input type="text" id="search-khoaphong" class="form-control form-control-sm rounded-pill border" placeholder="Tìm khoa/phòng theo tên..." />
                                </div>
                                <div class="card-body p-3 scroll-bar" style="height: 300px; overflow-y: auto;">
                                    <div id="list-khoaphong">
                                        @for (int i = 0; i < Model.KhoaPhongOptions.Count; i++)
                                        {
                                            <div class="form-check py-1 item-khoaphong align-items-center" data-name="@Model.KhoaPhongOptions[i].Text.ToLower()">
                                                <input class="form-check-input cursor-pointer kp-checkbox" type="checkbox" name="SelectedKhoaPhongIds" value="@Model.KhoaPhongOptions[i].Value" id="kp_@Model.KhoaPhongOptions[i].Value" />
                                                <label class="form-check-label fw-medium text-dark cursor-pointer user-select-none ms-1" for="kp_@Model.KhoaPhongOptions[i].Value">
                                                    @Model.KhoaPhongOptions[i].Text
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Chọn Chỉ Số -->
                        <div class="col-lg-6">
                            <div class="card border border-light-subtle rounded-3">
                                <div class="card-header bg-light border-0 d-flex justify-content-between align-items-center py-2 px-3 flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold text-secondary small">② Chỉ số chất lượng</span>
                                        <span class="badge bg-primary text-white rounded-pill px-2 py-1 small" id="count-cs">Đã chọn: 0</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2 small" id="select-all-cs">Chọn tất cả</button>
                                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2 small" id="clear-all-cs">Bỏ chọn</button>
                                    </div>
                                </div>
                                <div class="card-header bg-white border-0 py-2 px-3">
                                    <input type="text" id="search-chiso" class="form-control form-control-sm rounded-pill border" placeholder="Tìm theo mã hoặc tên chỉ số..." />
                                </div>
                                <div class="card-body p-3 scroll-bar" style="height: 300px; overflow-y: auto;">
                                    <div id="list-chiso">
                                        @for (int i = 0; i < Model.ChiSoOptions.Count; i++)
                                        {
                                            <div class="form-check py-1 item-chiso align-items-center" data-name="@Model.ChiSoOptions[i].Text.ToLower()">
                                                <input class="form-check-input cursor-pointer cs-checkbox" type="checkbox" name="SelectedChiSoIds" value="@Model.ChiSoOptions[i].Value" id="cs_@Model.ChiSoOptions[i].Value" />
                                                <label class="form-check-label fw-medium text-dark cursor-pointer user-select-none ms-1" for="cs_@Model.ChiSoOptions[i].Value">
                                                    @Model.ChiSoOptions[i].Text
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- AJAX Preview Panel (Initially Hidden) -->
                    <div class="card border border-primary-subtle bg-primary-subtle bg-opacity-10 rounded-3 mt-4 d-none" id="previewPanel">
                        <div class="card-header bg-transparent border-0 pt-3 px-4 pb-2">
                            <h6 class="fw-bold text-primary mb-0"><i class="bi bi-eye me-1"></i> Xem trước phân công sẽ tạo</h6>
                        </div>
                        <div class="card-body px-4 py-2">
                            <div class="table-responsive" style="max-height: 200px;">
                                <table class="table table-sm table-borderless align-middle mb-0 text-dark">
                                    <thead>
                                        <tr class="text-muted border-bottom small">
                                            <th class="py-2">Khoa / Phòng</th>
                                            <th class="py-2">Chỉ số chất lượng</th>
                                            <th class="py-2 text-center">Trạng thái</th>
                                        </tr>
                                    </thead>
                                    <tbody id="previewList">
                                        <!-- Rows injected by JavaScript -->
                                    </tbody>
                                </table>
                            </div>
                            <div class="mt-2 text-muted small text-end" id="previewCount">Sẽ tạo 0 phân công mới.</div>
                        </div>
                    </div>

                    <!-- Action buttons -->
                    <div class="d-flex justify-content-end mt-4">
                        <button class="btn btn-primary px-5 py-2.5 rounded-pill shadow" type="submit" id="submitBtn" disabled>
                            <i class="bi bi-check-circle me-1"></i> Xác nhận phân công
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Bộ Lọc Nâng Cao -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            @using (Html.BeginForm("Index", "Assignment", FormMethod.Get, new { id = "filterForm" }))
            {
                <input type="hidden" name="viewMode" id="filterViewMode" value="@Model.ViewMode" />
                <div class="row g-3 align-items-end">
                    <!-- Tìm kiếm -->
                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <label class="form-label text-muted small fw-semibold mb-1">Tìm kiếm</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="search" class="form-control bg-light border-start-0 shadow-none" placeholder="Tên khoa, mã/tên chỉ số..." value="@Model.Search" />
                        </div>
                    </div>
                    <!-- Khoa / Phòng -->
                    <div class="col-lg-2.5 col-md-6 col-sm-6">
                        <label class="form-label text-muted small fw-semibold mb-1">Khoa / Phòng</label>
                        @Html.DropDownList("khoaPhongId", new SelectList(Model.KhoaPhongOptions, "Value", "Text", Model.FilterKhoaPhongId), "Tất cả khoa/phòng", new { @class = "form-select form-select-sm bg-light shadow-none" })
                    </div>
                    <!-- Chỉ số -->
                    <div class="col-lg-2.5 col-md-6 col-sm-6">
                        <label class="form-label text-muted small fw-semibold mb-1">Chỉ số chất lượng</label>
                        @Html.DropDownList("chiSoId", new SelectList(Model.ChiSoOptions, "Value", "Text", Model.FilterChiSoId), "Tất cả chỉ số", new { @class = "form-select form-select-sm bg-light shadow-none" })
                    </div>
                    <!-- Trạng thái phân công -->
                    <div class="col-lg-2 col-md-6 col-sm-6">
                        <label class="form-label text-muted small fw-semibold mb-1">Trạng thái</label>
                        <select name="trangThai" class="form-select form-select-sm bg-light shadow-none">
                            <option value="" @(string.IsNullOrEmpty(Model.FilterTrangThai) ? "selected" : "")>Tất cả trạng thái</option>
                            <option value="active" @(Model.FilterTrangThai == "active" ? "selected" : "")>Đang hoạt động</option>
                            <option value="inactive" @(Model.FilterTrangThai == "inactive" ? "selected" : "")>Đang tạm dừng</option>
                        </select>
                    </div>

                    @if (Model.ViewMode == "byIndicator")
                    {
                        <!-- Trạng thái chưa phân công -->
                        <div class="col-lg-2 col-md-6 col-sm-6">
                            <label class="form-label text-muted small fw-semibold mb-1">Phân công chỉ số</label>
                            <select name="trangThaiPhanCong" class="form-select form-select-sm bg-light shadow-none">
                                <option value="all" @(Model.FilterTrangThaiPhanCong == "all" || string.IsNullOrEmpty(Model.FilterTrangThaiPhanCong) ? "selected" : "")>Tất cả chỉ số</option>
                                <option value="assigned" @(Model.FilterTrangThaiPhanCong == "assigned" ? "selected" : "")>Đã phân công</option>
                                <option value="unassigned" @(Model.FilterTrangThaiPhanCong == "unassigned" ? "selected" : "")>Chưa phân công 🔴</option>
                            </select>
                        </div>
                    }

                    <!-- Buttons -->
                    <div class="col-lg col-md-12 text-end d-flex gap-2 justify-content-end">
                        <button class="btn btn-primary btn-sm px-3 rounded-pill" type="submit">
                            <i class="bi bi-filter me-1"></i> Lọc
                        </button>
                        <a href="@Url.Action("Index", new { viewMode = Model.ViewMode })" class="btn btn-outline-secondary btn-sm px-3 rounded-pill">
                            Xóa lọc
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Toggle Chế độ xem & Danh sách -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <h5 class="card-title mb-0 fw-bold text-secondary"><i class="bi bi-list-task me-1"></i> Phân công hiện tại</h5>
            
            <!-- Chuyển chế độ xem -->
            <div class="btn-group btn-group-sm rounded-pill p-1 bg-light shadow-none border" role="group">
                <button type="button" class="btn rounded-pill px-3 py-1.5 fw-semibold view-mode-btn @(Model.ViewMode == "byIndicator" ? "btn-primary active text-white" : "btn-light text-secondary border-0")" data-mode="byIndicator">
                    <i class="bi bi-clipboard-data me-1"></i> Theo chỉ số
                </button>
                <button type="button" class="btn rounded-pill px-3 py-1.5 fw-semibold view-mode-btn @(Model.ViewMode == "byDepartment" ? "btn-primary active text-white" : "btn-light text-secondary border-0")" data-mode="byDepartment">
                    <i class="bi bi-building me-1"></i> Theo khoa/phòng
                </button>
                <button type="button" class="btn rounded-pill px-3 py-1.5 fw-semibold view-mode-btn @(Model.ViewMode == "table" ? "btn-primary active text-white" : "btn-light text-secondary border-0")" data-mode="table">
                    <i class="bi bi-table me-1"></i> Bảng tổng hợp
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.ViewMode == "byDepartment")
            {
                @Html.Partial("_DepartmentView", Model)
            }
            else if (Model.ViewMode == "byIndicator")
            {
                @Html.Partial("_IndicatorView", Model)
            }
            else
            {
                @Html.Partial("_TableView", Model)
            }
        </div>
    </div>

    <!-- Phân Trang (Server-side pagination) -->
    @if (Model.TotalPages > 1)
    {
        <nav class="d-flex justify-content-center mt-4">
            <ul class="pagination pagination-sm shadow-sm rounded-pill p-1 bg-white border">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item"><a class="page-link rounded-circle border-0 text-primary px-3" href="@Url.Action("Index", new { page = 1, viewMode = Model.ViewMode, khoaPhongId = Model.FilterKhoaPhongId, chiSoId = Model.FilterChiSoId, trangThai = Model.FilterTrangThai, trangThaiPhanCong = Model.FilterTrangThaiPhanCong, search = Model.Search })">«</a></li>
                    <li class="page-item"><a class="page-link rounded-circle border-0 text-primary px-3" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, viewMode = Model.ViewMode, khoaPhongId = Model.FilterKhoaPhongId, chiSoId = Model.FilterChiSoId, trangThai = Model.FilterTrangThai, trangThaiPhanCong = Model.FilterTrangThaiPhanCong, search = Model.Search })">‹</a></li>
                }
                else
                {
                    <li class="page-item disabled"><span class="page-link rounded-circle border-0 px-3">«</span></li>
                    <li class="page-item disabled"><span class="page-link rounded-circle border-0 px-3">‹</span></li>
                }

                <li class="page-item active"><span class="page-link rounded-pill border-0 px-3 bg-primary text-white">Trang @Model.CurrentPage / @Model.TotalPages</span></li>

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item"><a class="page-link rounded-circle border-0 text-primary px-3" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, viewMode = Model.ViewMode, khoaPhongId = Model.FilterKhoaPhongId, chiSoId = Model.FilterChiSoId, trangThai = Model.FilterTrangThai, trangThaiPhanCong = Model.FilterTrangThaiPhanCong, search = Model.Search })">›</a></li>
                    <li class="page-item"><a class="page-link rounded-circle border-0 text-primary px-3" href="@Url.Action("Index", new { page = Model.TotalPages, viewMode = Model.ViewMode, khoaPhongId = Model.FilterKhoaPhongId, chiSoId = Model.FilterChiSoId, trangThai = Model.FilterTrangThai, trangThaiPhanCong = Model.FilterTrangThaiPhanCong, search = Model.Search })">»</a></li>
                }
                else
                {
                    <li class="page-item disabled"><span class="page-link rounded-circle border-0 px-3">›</span></li>
                    <li class="page-item disabled"><span class="page-link rounded-circle border-0 px-3">»</span></li>
                }
            </ul>
        </nav>
        <div class="text-center text-muted small mt-2">Tổng số dòng/nhóm hiển thị: @Model.TotalItems (20 mục trên trang)</div>
    }
</div>

<!-- Bulk Action Floating Bar -->
<div class="bulk-action-bar border shadow-lg rounded-3 p-3 bg-white d-flex align-items-center justify-content-between position-fixed bottom-0 start-50 translate-middle-x mb-4 w-75 z-3 transition-all d-none" id="bulkActionBar">
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-primary text-white rounded-circle p-2" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;" id="bulk-selected-count">0</span>
        <span class="text-dark fw-semibold small">phân công đang được chọn</span>
    </div>
    <div class="d-flex align-items-center gap-2">
        @using (Html.BeginForm("BulkDeactivate", "Assignment", FormMethod.Post, new { id = "bulkDeactivateForm", @class = "d-inline" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="viewMode" value="@Model.ViewMode" />
            <div class="ids-container"></div>
            <button type="submit" class="btn btn-warning btn-sm rounded-pill px-3"><i class="bi bi-pause-fill"></i> Tạm dừng</button>
        }

        @using (Html.BeginForm("BulkActivate", "Assignment", FormMethod.Post, new { id = "bulkActivateForm", @class = "d-inline" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="viewMode" value="@Model.ViewMode" />
            <div class="ids-container"></div>
            <button type="submit" class="btn btn-success btn-sm rounded-pill px-3"><i class="bi bi-play-fill"></i> Kích hoạt</button>
        }

        @using (Html.BeginForm("BulkDelete", "Assignment", FormMethod.Post, new { id = "bulkDeleteForm", @class = "d-inline" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="viewMode" value="@Model.ViewMode" />
            <div class="ids-container"></div>
            <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3" onclick="return confirm('Bạn có chắc chắn muốn xóa tất cả phân công đã chọn?')"><i class="bi bi-trash-fill"></i> Xóa</button>
        }
        <button class="btn btn-light btn-sm rounded-circle shadow-none border" id="close-bulk-bar" type="button"><i class="bi bi-x-lg"></i></button>
    </div>
</div>

@section scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Toggle view modes
        document.querySelectorAll('.view-mode-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var mode = btn.getAttribute('data-mode');
                document.getElementById('filterViewMode').value = mode;
                document.getElementById('filterForm').submit();
            });
        });

        // Search Khoa/Phòng
        var searchKp = document.getElementById('search-khoaphong');
        if (searchKp) {
            searchKp.addEventListener('input', function(e) {
                var term = e.target.value.toLowerCase().trim();
                var items = document.querySelectorAll('.item-khoaphong');
                items.forEach(function(item) {
                    var name = item.getAttribute('data-name');
                    if (name.indexOf(term) > -1) {
                        item.style.setProperty('display', 'block', 'important');
                    } else {
                        item.style.setProperty('display', 'none', 'important');
                    }
                });
            });
        }

        // Search Chỉ số
        var searchCs = document.getElementById('search-chiso');
        if (searchCs) {
            searchCs.addEventListener('input', function(e) {
                var term = e.target.value.toLowerCase().trim();
                var items = document.querySelectorAll('.item-chiso');
                items.forEach(function(item) {
                    var name = item.getAttribute('data-name');
                    if (name.indexOf(term) > -1) {
                        item.style.setProperty('display', 'block', 'important');
                    } else {
                        item.style.setProperty('display', 'none', 'important');
                    }
                });
            });
        }

        // Checkbox count and AJAX preview
        var kpCheckboxes = document.querySelectorAll('.kp-checkbox');
        var csCheckboxes = document.querySelectorAll('.cs-checkbox');
        var submitBtn = document.getElementById('submitBtn');

        function updateSelectionCountAndPreview() {
            var selectedKps = Array.from(kpCheckboxes).filter(cb => cb.checked).map(cb => cb.value);
            var selectedCss = Array.from(csCheckboxes).filter(cb => cb.checked).map(cb => cb.value);

            document.getElementById('count-kp').innerText = 'Đã chọn: ' + selectedKps.length;
            document.getElementById('count-cs').innerText = 'Đã chọn: ' + selectedCss.length;

            if (selectedKps.length > 0 && selectedCss.length > 0) {
                submitBtn.disabled = false;
                fetchPreview(selectedKps, selectedCss);
            } else {
                submitBtn.disabled = true;
                document.getElementById('previewPanel').classList.add('d-none');
            }
        }

        function fetchPreview(deptIds, indicatorIds) {
            var url = '@Url.Action("Preview", "Assignment")';
            var formData = new URLSearchParams();
            deptIds.forEach(id => formData.append('departmentIds', id));
            indicatorIds.forEach(id => formData.append('indicatorIds', id));

            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: formData.toString()
            })
            .then(res => res.json())
            .then(data => {
                var tbody = document.getElementById('previewList');
                tbody.innerHTML = '';
                var newCount = 0;

                data.forEach(item => {
                    var tr = document.createElement('tr');
                    tr.className = 'border-bottom border-light small';
                    
                    var tdDept = document.createElement('td');
                    tdDept.className = 'py-2 font-semibold';
                    tdDept.innerText = item.TenKhoaPhong;
                    
                    var tdCs = document.createElement('td');
                    tdCs.className = 'py-2';
                    tdCs.innerHTML = `<span class="badge bg-secondary font-monospace me-1">${item.MaChiSo}</span> ${item.TenChiSo}`;
                    
                    var tdStatus = document.createElement('td');
                    tdStatus.className = 'py-2 text-center';

                    if (item.DaTonTai) {
                        tdStatus.innerHTML = '<span class="badge bg-warning-subtle text-warning"><i class="bi bi-exclamation-triangle me-1"></i>Đã tồn tại</span>';
                    } else {
                        tdStatus.innerHTML = '<span class="badge bg-success-subtle text-success"><i class="bi bi-plus-circle me-1"></i>Mới</span>';
                        newCount++;
                    }

                    tr.appendChild(tdDept);
                    tr.appendChild(tdCs);
                    tr.appendChild(tdStatus);
                    tbody.appendChild(tr);
                });

                document.getElementById('previewPanel').classList.remove('d-none');
                document.getElementById('previewCount').innerText = `Sẽ tạo ${newCount} phân công mới (${data.length - newCount} phân công cũ sẽ bỏ qua).`;
            })
            .catch(err => {
                console.error(err);
            });
        }

        kpCheckboxes.forEach(cb => cb.addEventListener('change', updateSelectionCountAndPreview));
        csCheckboxes.forEach(cb => cb.addEventListener('change', updateSelectionCountAndPreview));

        // Quick Assign from group view
        document.querySelectorAll('.assign-now-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var indicatorId = btn.getAttribute('data-id');
                // Select this indicator in the list
                var checkbox = document.getElementById('cs_' + indicatorId);
                if (checkbox) {
                    checkbox.checked = true;
                    // Trigger scroll to form
                    document.getElementById('createAssignmentForm').scrollIntoView({ behavior: 'smooth' });
                    // Open the form if closed
                    var formCollapse = new bootstrap.Collapse(document.getElementById('createAssignmentForm'), { toggle: false });
                    formCollapse.show();
                    updateSelectionCountAndPreview();
                }
            });
        });

        // Select All / Clear All toggles for create form lists
        document.getElementById('select-all-kp').addEventListener('click', function() {
            kpCheckboxes.forEach(cb => {
                // Only select if not filtered out
                var wrapper = cb.closest('.item-khoaphong');
                if (wrapper.style.display !== 'none') {
                    cb.checked = true;
                }
            });
            updateSelectionCountAndPreview();
        });
        document.getElementById('clear-all-kp').addEventListener('click', function() {
            kpCheckboxes.forEach(cb => cb.checked = false);
            updateSelectionCountAndPreview();
        });
        document.getElementById('select-all-cs').addEventListener('click', function() {
            csCheckboxes.forEach(cb => {
                var wrapper = cb.closest('.item-chiso');
                if (wrapper.style.display !== 'none') {
                    cb.checked = true;
                }
            });
            updateSelectionCountAndPreview();
        });
        document.getElementById('clear-all-cs').addEventListener('click', function() {
            csCheckboxes.forEach(cb => cb.checked = false);
            updateSelectionCountAndPreview();
        });

        // Bulk operations bar handling
        var bulkBar = document.getElementById('bulkActionBar');
        var bulkSelectedCount = document.getElementById('bulk-selected-count');
        var bulkCheckboxes = document.querySelectorAll('.bulk-checkbox');
        var selectAllFlat = document.getElementById('bulk-select-all');

        function updateBulkActionBar() {
            var selectedCheckboxes = Array.from(document.querySelectorAll('.bulk-checkbox')).filter(cb => cb.checked);
            var selectedCount = selectedCheckboxes.length;

            if (selectedCount > 0) {
                bulkSelectedCount.innerText = selectedCount;
                
                // Inject the IDs into forms
                document.querySelectorAll('.ids-container').forEach(container => {
                    container.innerHTML = '';
                    selectedCheckboxes.forEach(cb => {
                        var hiddenInput = document.createElement('input');
                        hiddenInput.type = 'hidden';
                        hiddenInput.name = 'ids';
                        hiddenInput.value = cb.value;
                        container.appendChild(hiddenInput);
                    });
                });

                bulkBar.classList.remove('d-none');
            } else {
                bulkBar.classList.add('d-none');
            }
        }

        // Attach listeners for bulk checkboxes
        document.addEventListener('change', function(e) {
            if (e.target && e.target.classList.contains('bulk-checkbox')) {
                updateBulkActionBar();
            }
        });

        if (selectAllFlat) {
            selectAllFlat.addEventListener('change', function(e) {
                var checked = e.target.checked;
                document.querySelectorAll('.bulk-checkbox').forEach(cb => {
                    cb.checked = checked;
                });
                updateBulkActionBar();
            });
        }

        document.getElementById('close-bulk-bar').addEventListener('click', function() {
            document.querySelectorAll('.bulk-checkbox').forEach(cb => cb.checked = false);
            if (selectAllFlat) selectAllFlat.checked = false;
            updateBulkActionBar();
        });
    });
</script>
}
