@model HospitalQualityDashboard.Models.ViewModels.ChiSoViewModel
@{
    ViewBag.Title = "Chi tiet chi so";
}
<h2>@Model.MaChiSo - @Model.TenChiSo</h2>
<dl class="row">
    <dt class="col-sm-3">Dinh nghia</dt><dd class="col-sm-9">@Model.DinhNghia</dd>
    <dt class="col-sm-3">Phuong phap tinh</dt><dd class="col-sm-9">@Model.PhuongPhapTinh</dd>
    <dt class="col-sm-3">Tu so</dt><dd class="col-sm-9">@Model.TuSoMoTa</dd>
    <dt class="col-sm-3">Mau so</dt><dd class="col-sm-9">@Model.MauSoMoTa</dd>
    <dt class="col-sm-3">Nguon so lieu</dt><dd class="col-sm-9">@Model.NguonSoLieu</dd>
    <dt class="col-sm-3">Muc tieu</dt><dd class="col-sm-9">@Model.ToanTuSoSanh @Model.GiaTriMucTieu (@Model.NamMucTieu)</dd>
</dl>
@Html.ActionLink("Quay lai", "Index", null, new { @class = "btn btn-outline-secondary" })
