@model HospitalQualityDashboard.Models.ViewModels.LoginViewModel

@{
    ViewBag.Title = "Đăng nhập User";
}

<main class="container py-5" style="max-width: 480px;">
    <h2 class="mb-2">Đăng nhập User</h2>
    <p class="text-muted mb-4">Màn hình dành riêng cho tài khoản khoa/phòng.</p>

    @using (Html.BeginForm("UserLogin", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="mb-3">
            @Html.LabelFor(m => m.TenDangNhap, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.TenDangNhap, new { @class = "form-control", autocomplete = "username" })
            @Html.ValidationMessageFor(m => m.TenDangNhap, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.MatKhau, new { @class = "form-label" })
            @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", autocomplete = "current-password" })
            @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-primary w-100">Đăng nhập User</button>
        <div class="mt-3 text-center">
            @Html.ActionLink("Đăng nhập Admin", "AdminLogin", "Account")
        </div>
    }
</main>


