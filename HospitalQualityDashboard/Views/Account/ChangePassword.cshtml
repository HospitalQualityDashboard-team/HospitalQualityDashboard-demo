@* Mục đích: form đổi mật khẩu khi người dùng đã đăng nhập. *@
@model HospitalQualityDashboard.Models.ViewModels.ChangePasswordViewModel

@{
    ViewBag.Title = "Đổi mật khẩu";
}

<main class="container py-4" style="max-width: 560px;">
    <h2 class="mb-4">Đổi mật khẩu</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="mb-3">
            @Html.LabelFor(m => m.MatKhauCu, new { @class = "form-label" })
            @Html.PasswordFor(m => m.MatKhauCu, new { @class = "form-control", autocomplete = "current-password" })
            @Html.ValidationMessageFor(m => m.MatKhauCu, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.MatKhauMoi, new { @class = "form-label" })
            @Html.PasswordFor(m => m.MatKhauMoi, new { @class = "form-control", autocomplete = "new-password" })
            @Html.ValidationMessageFor(m => m.MatKhauMoi, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.XacNhanMatKhauMoi, new { @class = "form-label" })
            @Html.PasswordFor(m => m.XacNhanMatKhauMoi, new { @class = "form-control", autocomplete = "new-password" })
            @Html.ValidationMessageFor(m => m.XacNhanMatKhauMoi, "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-primary">Cập nhật mật khẩu</button>
    }
</main>


