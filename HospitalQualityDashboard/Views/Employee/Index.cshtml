@model HospitalQualityDashboard.Models.ViewModels.NhanVienIndexViewModel
@{
    ViewBag.Title = "Nhan vien";
}

<h2>Nhan vien</h2>
<div class="mb-3">
    @Html.ActionLink("Them nhan vien", "Create", null, new { @class = "btn btn-primary" })
    @Html.ActionLink("Xuat CSV", "Employees", "Export", new { khoaPhongId = Model.KhoaPhongId }, new { @class = "btn btn-outline-secondary" })
</div>

@using (Html.BeginForm("Index", "Employee", FormMethod.Get, new { @class = "row g-2 mb-3" }))
{
    <div class="col-md-4">@Html.DropDownListFor(m => m.KhoaPhongId, Model.KhoaPhongOptions, "Tat ca khoa phong", new { @class = "form-select" })</div>
    <div class="col-auto"><button class="btn btn-outline-primary" type="submit">Loc</button></div>
}

@using (Html.BeginForm("Import", "Employee", FormMethod.Post, new { enctype = "multipart/form-data", @class = "mb-3" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.KhoaPhongId)
    <div class="input-group">
        <input type="file" name="File" class="form-control" />
        <button class="btn btn-outline-primary" type="submit">Import nhan vien</button>
    </div>
}

@if (Model.ImportResult != null)
{
    <div class="alert alert-info">Thanh cong: @Model.ImportResult.SoDongThanhCong, loi: @Model.ImportResult.SoDongLoi</div>
}

<table class="table table-striped table-sm">
    <thead><tr><th>Ma</th><th>Ho ten</th><th>Khoa phong</th><th>Email</th><th>Trang thai</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.MaNhanVien</td>
            <td>@item.HoTen</td>
            <td>@item.TenKhoaPhong</td>
            <td>@item.Email</td>
            <td>@(item.DangHoatDong ? "Hoat dong" : "Da khoa")</td>
            <td class="text-end">
                @Html.ActionLink("Sua", "Edit", new { id = item.NhanVienId }, new { @class = "btn btn-sm btn-outline-primary" })
                @Html.ActionLink("Tao user", "CreateAccount", new { id = item.NhanVienId }, new { @class = "btn btn-sm btn-outline-secondary" })
                @using (Html.BeginForm(item.DangHoatDong ? "Lock" : "Unlock", "Employee", new { id = item.NhanVienId }, FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-warning" type="submit">@(item.DangHoatDong ? "Khoa" : "Mo khoa")</button>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
