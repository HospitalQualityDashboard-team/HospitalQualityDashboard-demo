@model HospitalQualityDashboard.Models.ViewModels.NhanVienIndexViewModel
@{
    ViewBag.Title = "Nhân viên";
}

<div class="page-header">
    <div>
        <h1>Nhân viên</h1>
        <p>Quản lý hồ sơ nhân viên và liên kết tài khoản sử dụng hệ thống.</p>
    </div>
</div>
<div class="mb-3">
    @Html.ActionLink("Thêm nhân viên", "Create", null, new { @class = "btn btn-primary" })
    @Html.ActionLink("Xuất CSV", "Employees", "Export", new { khoaPhongId = Model.KhoaPhongId }, new { @class = "btn btn-outline-secondary" })
</div>

@using (Html.BeginForm("Index", "Employee", FormMethod.Get, new { @class = "row g-2 mb-3" }))
{
    <div class="col-md-4">@Html.DropDownListFor(m => m.KhoaPhongId, Model.KhoaPhongOptions, "Tất cả khoa/phòng", new { @class = "form-select" })</div>
    <div class="col-auto"><button class="btn btn-outline-primary" type="submit">Lọc</button></div>
}

@using (Html.BeginForm("Import", "Employee", FormMethod.Post, new { enctype = "multipart/form-data", @class = "mb-3" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.KhoaPhongId)
    <div class="input-group">
        <input type="file" name="File" class="form-control" />
        <button class="btn btn-outline-primary" type="submit">Import nhân viên</button>
    </div>
}

@if (Model.ImportResult != null)
{
    <div class="alert alert-info">Thành công: @Model.ImportResult.SoDongThanhCong, lỗi: @Model.ImportResult.SoDongLoi</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped table-sm">
    <thead><tr><th>Mã</th><th>Họ tên</th><th>Khoa/phòng</th><th>Email</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.MaNhanVien</td>
            <td>@item.HoTen</td>
            <td>@item.TenKhoaPhong</td>
            <td>@item.Email</td>
            <td><span class="status-pill @(item.DangHoatDong ? "status-active" : "status-muted")">@(item.DangHoatDong ? "Hoạt động" : "Đã khóa")</span></td>
            <td class="text-end">
                @Html.ActionLink("Sửa", "Edit", new { id = item.NhanVienId }, new { @class = "btn btn-sm btn-outline-primary" })
                @if (!item.HasAccount)
                {
                    @Html.ActionLink("Tạo tài khoản", "CreateAccount", new { id = item.NhanVienId }, new { @class = "btn btn-sm btn-outline-secondary" })
                }
                @using (Html.BeginForm(item.DangHoatDong ? "Lock" : "Unlock", "Employee", new { id = item.NhanVienId }, FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-warning" type="submit">@(item.DangHoatDong ? "Khóa" : "Mở khóa")</button>
                }
                @using (Html.BeginForm("Delete", "Employee", new { id = item.NhanVienId }, FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Xóa nhân viên này?')">Xóa</button>
                }
            </td>
        </tr>
    }
    </tbody>
</table>


