@model IEnumerable<HospitalQualityDashboard.Models.ViewModels.KyBaoCaoViewModel>
@{
    ViewBag.Title = "Kỳ báo cáo";
}
<div class="page-header">
    <div>
        <h1>Kỳ báo cáo</h1>
        <p>Quản lý thời gian mở, hạn nộp và trạng thái các kỳ báo cáo.</p>
    </div>
</div>
<p>@Html.ActionLink("Thêm kỳ báo cáo", "Create", null, new { @class = "btn btn-primary" })</p>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<table class="table table-striped table-sm">
    <thead><tr><th>Tên kỳ</th><th>Từ ngày</th><th>Đến ngày</th><th>Hạn nộp</th><th>Trạng thái</th><th>Tiến độ</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.TenKyBaoCao</td>
            <td>@item.TuNgay.ToString("yyyy-MM-dd")</td>
            <td>@item.DenNgay.ToString("yyyy-MM-dd")</td>
            <td>@item.HanNop.ToString("yyyy-MM-dd")</td>
            <td>@item.TrangThai</td>
            <td>@item.DaGui / @item.TongBaoCao</td>
            <td class="text-end">
                @Html.ActionLink("Sửa", "Edit", new { id = item.KyBaoCaoId }, new { @class = "btn btn-sm btn-outline-primary" })
                @using (Html.BeginForm("Open", "ReportingPeriod", new { id = item.KyBaoCaoId }, FormMethod.Post, new { @class = "d-inline" }))
                { @Html.AntiForgeryToken() <button class="btn btn-sm btn-outline-success" type="submit">Mở</button> }
                @using (Html.BeginForm("Lock", "ReportingPeriod", new { id = item.KyBaoCaoId }, FormMethod.Post, new { @class = "d-inline" }))
                { @Html.AntiForgeryToken() <button class="btn btn-sm btn-outline-warning" type="submit">Khóa</button> }
                @using (Html.BeginForm("Delete", "ReportingPeriod", new { id = item.KyBaoCaoId }, FormMethod.Post, new { @class = "d-inline" }))
                { @Html.AntiForgeryToken() <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Xóa kỳ báo cáo này?')">Xóa</button> }
            </td>
        </tr>
    }
    </tbody>
</table>


