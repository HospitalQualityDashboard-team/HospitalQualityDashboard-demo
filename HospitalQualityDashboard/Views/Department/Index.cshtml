@model HospitalQualityDashboard.Models.ViewModels.KhoaPhongIndexViewModel
@{
    ViewBag.Title = "Khoa/phòng";
}

<div class="page-header">
    <div>
        <h1>Khoa/phòng</h1>
        <p>Quản lý danh mục khoa, phòng và trạng thái sử dụng.</p>
    </div>
</div>
<div class="mb-3">
    @Html.ActionLink("Thêm khoa/phòng", "Create", null, new { @class = "btn btn-primary" })
    @Html.ActionLink("Xuất CSV", "Departments", "Export", null, new { @class = "btn btn-outline-secondary" })
</div>

@using (Html.BeginForm("Index", "Department", FormMethod.Get, new { @class = "row g-2 mb-3" }))
{
    <div class="col-md-4">@Html.TextBoxFor(m => m.Search, new { @class = "form-control", placeholder = "Tìm tên hoặc mã" })</div>
    <div class="col-auto"><button class="btn btn-outline-primary" type="submit">Lọc</button></div>
}

@using (Html.BeginForm("Import", "Department", FormMethod.Post, new { enctype = "multipart/form-data", @class = "mb-3" }))
{
    @Html.AntiForgeryToken()
    <div class="input-group">
        <input type="file" name="File" class="form-control" />
        <button class="btn btn-outline-primary" type="submit">Import DM_KHOA_PHONG</button>
    </div>
}

@if (Model.ImportResult != null)
{
    <div class="alert alert-info">Thành công: @Model.ImportResult.SoDongThanhCong, lỗi: @Model.ImportResult.SoDongLoi</div>
    foreach (var error in Model.ImportResult.Errors)
    {
        <div class="text-danger">@error</div>
    }
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped table-sm">
    <thead><tr><th>Mã nguồn</th><th>Tên khoa/phòng</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.IdKhoaPhongNguon</td>
            <td>@item.TenKhoaPhong</td>
            <td><span class="status-pill @(item.Used ? "status-active" : "status-muted")">@(item.Used ? "Đang dùng" : "Đã khóa")</span></td>
            <td class="text-end">
                @Html.ActionLink("Sửa", "Edit", new { id = item.KhoaPhongId }, new { @class = "btn btn-sm btn-outline-primary" })
                @using (Html.BeginForm(item.Used ? "Lock" : "Unlock", "Department", new { id = item.KhoaPhongId }, FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-warning" type="submit">@(item.Used ? "Khóa" : "Mở khóa")</button>
                }
                @using (Html.BeginForm("Delete", "Department", new { id = item.KhoaPhongId }, FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Xóa khoa/phòng này?')">Xóa</button>
                }
            </td>
        </tr>
    }
    </tbody>
</table>


